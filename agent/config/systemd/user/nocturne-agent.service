[Unit]
Description=Nocturne Agent local control plane
Requires=nocturne-agent.socket
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nocturne-agent-service --idle-seconds 300
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Nice=5
CPUWeight=25
MemoryHigh=256M
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/nocturne-agent %h/.local/state/nocturne
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
