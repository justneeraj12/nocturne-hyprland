    "action": {"name": "browser_context", "arguments": {}}
  },
  {
    "triggers": ["is steam alive", "check whether an app is running"],
    "action": {"name": "observe", "arguments": {"subject": "processes", "query": "steam"}}
  },
  {
    "triggers": ["how is my laptop doing", "check system health"],
    "action": {"name": "system_status", "arguments": {}}
  },
  {
    "triggers": ["move me to workspace five", "switch desktops"],
    "action": {"name": "workspace", "arguments": {"number": 5}}
