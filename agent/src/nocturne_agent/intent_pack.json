[
  {
    "triggers": ["fire up my music", "open my music player", "launch the music app"],
    "action": {"name": "find_app", "arguments": {"query": "music player"}}
  },
  {
    "triggers": ["put on teardrop by massive attack", "play a song by an artist"],
    "action": {"name": "play_music", "arguments": {"query": "song by artist"}}
  },
  {
    "triggers": ["put on the songs I saved", "start my liked songs", "play my likes"],
    "action": {"name": "music_open", "arguments": {"section": "liked", "play": true}}
  },
  {
    "triggers": ["make it a little quieter", "turn the sound down a bit"],
    "action": {"name": "volume", "arguments": {"direction": "down", "step": 5}}
  },
  {
    "triggers": ["keep the screen awake", "do not let the laptop sleep"],
    "action": {"name": "caffeine", "arguments": {"action": "on"}}
  },
  {
