[Desktop Entry]
Type=Application
Name=Files
GenericName=Nocturne File Manager
Comment=Browse files, devices and network locations
Exec=@LAUNCHER@ %U
Icon=org.kde.dolphin
MimeType=inode/directory;
Categories=System;FileTools;Qt;
Keywords=files;folders;storage;downloads;documents;
StartupNotify=true
DBusActivatable=false
Actions=Home;Downloads;Documents;Pictures;Terminal;

[Desktop Action Home]
Name=Home
Exec=@LAUNCHER@ @HOME@

[Desktop Action Downloads]
Name=Downloads
Exec=@LAUNCHER@ @HOME@/Downloads

[Desktop Action Documents]
Name=Documents
Exec=@LAUNCHER@ @HOME@/Documents

[Desktop Action Pictures]
Name=Pictures
Exec=@LAUNCHER@ @HOME@/Pictures

[Desktop Action Terminal]
Name=Terminal Here
Exec=kitty --directory @HOME@
