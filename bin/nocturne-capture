#!/usr/bin/env python3
"""Zero-idle GNOME-style screenshot and recording surface for Hyprland."""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import time
from ctypes.util import find_library
from datetime import datetime
from pathlib import Path
from typing import Any

os.environ["GDK_BACKEND"] = "wayland"

LAYER_LIBRARY = next(
    (
        candidate
        for candidate in (
            "/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0",
            "/usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so.0",
            find_library("gtk4-layer-shell"),
        )
        if candidate and (os.path.exists(candidate) or "/" not in candidate)
    ),
    "",
)
if LAYER_LIBRARY and os.environ.get("NOCTURNE_LAYER_READY") != "1":
    environment = os.environ.copy()
    environment["LD_PRELOAD"] = ":".join(filter(None, (LAYER_LIBRARY, environment.get("LD_PRELOAD", ""))))
    environment["NOCTURNE_LAYER_READY"] = "1"
    os.execve(sys.executable, [sys.executable, *sys.argv], environment)

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell  # noqa: E402


HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
STATE = RUNTIME / "nocturne-capture.json"
PREFERENCES = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "nocturne" / "capture.json"

CSS = b"""
* { font-family: Inter, sans-serif; font-size: 11px; }
window, .shell { background: transparent; }
.card { background: alpha(@BASE@, .99); color: @TEXT@; border: 1px solid @ACCENT2@; border-bottom: 2px solid @LINE@; padding: 8px; }
.eyebrow { color: @ACCENT@; font-size: 9px; font-weight: 800; letter-spacing: 1px; }
.subtle { color: @MUTED@; font-size: 10px; }
.recording { color: #ff7b85; font-family: "MesloLGS Nerd Font Mono"; font-weight: 800; }
button { min-height: 31px; padding: 2px 10px; color: @TEXT@; background: @SURFACE@; border: 1px solid @LINE@; border-radius: 0; }
button:hover { color: @TEXT@; background: @OVERLAY@; border-color: @ACCENT@; }
button.active { color: @BASE@; background: @ACCENT@; border-color: @ACCENT2@; font-weight: 800; }
button.capture { min-width: 42px; color: @BASE@; background: @TEXT@; border-color: @ACCENT@; }
button.capture:hover { background: @ACCENT@; }
button.stop { color: #160507; background: #ff6572; border-color: #ff9aa3; font-weight: 800; }
separator { background: @LINE@; min-width: 1px; }
"""


def command(args: list[str], *, input_text: str | None = None, timeout: float = 15) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(args, input=input_text, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        return subprocess.CompletedProcess(args, 1, "", str(error))


def json_command(args: list[str]) -> Any:
    result = command(args)
    if result.returncode:
        return []
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return []


def themed_css(template: bytes) -> bytes:
    colors = {
        "BASE": "07090a", "SURFACE": "0b0f10", "OVERLAY": "111719",
        "LINE": "1b2925", "TEXT": "a7b8b1", "MUTED": "4d5d58",
        "ACCENT": "5f8f76", "ACCENT2": "477463",
    }
    config = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "nocturne"
    for filename in ("palette.css", "accent.css"):
        try:
            data = (config / filename).read_text(encoding="utf-8")
        except OSError:
            continue
        for name in colors:
            match = re.search(rf"^@define-color {name.lower()} #([0-9a-fA-F]{{6}});", data, re.MULTILINE)
            if match:
                colors[name] = match.group(1)
    for name, value in colors.items():
        template = template.replace(f"@{name}@".encode(), f"#{value}".encode())
    return template


def user_directory(kind: str) -> Path:
    result = command(["xdg-user-dir", kind.upper()])
    base = Path(result.stdout.strip()) if result.returncode == 0 and result.stdout.strip() else HOME / kind.title()
    directory = base / ("Screenshots" if kind == "pictures" else "Screenrecords")
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def output_path(recording: bool) -> Path:
    stamp = datetime.now().strftime("%Y-%m-%d-%H%M%S-%f")[:-3]
    if recording:
        return user_directory("videos") / f"Recording-{stamp}.mp4"
    return user_directory("pictures") / f"Screenshot-{stamp}.png"


def slurp(arguments: list[str], boxes: str | None = None) -> str:
    result = command(
        [
            "slurp", "-b", "07090acc", "-c", "5f8f76ff", "-s", "5f8f7633",
            "-B", "0b0f10ee", "-F", "Inter", "-w", "2", *arguments,
        ],
        input_text=boxes,
        timeout=300,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def select_target(source: str) -> tuple[str, str] | None:
    if source == "display":
        output = slurp(["-o", "-f", "%o"])
        return ("output", output) if output else None
    if source == "window":
        clients = json_command(["hyprctl", "clients", "-j"])
        boxes: list[str] = []
        for client in clients if isinstance(clients, list) else []:
            position = client.get("at", [0, 0])
            size = client.get("size", [0, 0])
            if client.get("mapped", True) and not client.get("hidden", False) and int(size[0]) > 1 and int(size[1]) > 1:
                label = str(client.get("title") or client.get("class") or "Window").replace("\n", " ")[:60]
                boxes.append(f"{int(position[0])},{int(position[1])} {int(size[0])}x{int(size[1])} {label}")
        geometry = slurp(["-r"], "\n".join(boxes) + "\n") if boxes else ""
        return ("geometry", geometry) if geometry else None
    geometry = slurp(["-d", "-x"])
    return ("geometry", geometry) if geometry else None


def notify(title: str, body: str) -> None:
    command(["notify-send", "-a", "Nocturne Capture", title, body], timeout=4)


def take_screenshot(source: str) -> int:
    time.sleep(0.22)
    target = select_target(source)
    if target is None:
        return 1
    path = output_path(False)
    kind, value = target
    args = ["grim", "-t", "png"]
    args.extend(["-o", value] if kind == "output" else ["-g", value])
    args.append(str(path))
    result = command(args, timeout=30)
    if result.returncode or not path.is_file():
        notify("Screenshot failed", result.stderr.strip() or "The selected area could not be captured")
        return 1
    try:
        with path.open("rb") as image:
            subprocess.run(["wl-copy", "--type", "image/png"], stdin=image, timeout=8, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass
    notify("Screenshot captured", f"Saved {path.name} · copied to clipboard")
    return 0


def read_state() -> dict[str, Any] | None:
    try:
        state = json.loads(STATE.read_text(encoding="utf-8"))
        pid = int(state["pid"])
        if not process_alive(pid):
            raise ValueError
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        if b"wf-recorder" not in cmdline:
            raise ValueError
        return state
    except (OSError, ValueError, KeyError, json.JSONDecodeError):
        STATE.unlink(missing_ok=True)
        return None


def process_alive(pid: int) -> bool:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").split()
        return len(fields) > 2 and fields[2] != "Z"
    except OSError:
        return False


def start_recording(source: str) -> int:
    time.sleep(0.22)
    if read_state():
        notify("Recording already active", "Use the REC indicator to stop and save it")
        return 1
    target = select_target(source)
    if target is None:
        return 1
    path = output_path(True)
    kind, value = target
    args = ["wf-recorder", "-r", "30", "-f", str(path)]
    args.extend(["-o", value] if kind == "output" else ["-g", value])
    log_path = RUNTIME / "nocturne-capture.log"
    try:
        log = log_path.open("ab")
        process = subprocess.Popen(
            args,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
        )
        log.close()
    except OSError as error:
        notify("Recording failed", str(error))
        return 1
    time.sleep(0.7)
    if process.poll() is not None:
        notify("Recording failed", "wf-recorder exited before the first frame")
        return 1
    STATE.write_text(
        json.dumps({"pid": process.pid, "started": int(time.time()), "path": str(path), "source": source}),
        encoding="utf-8",
    )
    notify("Recording started", "Click the red REC timer to stop and save")
    return 0


def stop_recording() -> int:
    state = read_state()
    if not state:
        return 0
    pid = int(state["pid"])
    try:
        os.killpg(pid, signal.SIGINT)
        for _attempt in range(100):
            if not process_alive(pid):
                break
            time.sleep(0.1)
        else:
            os.killpg(pid, signal.SIGTERM)
    except (OSError, ProcessLookupError):
        pass
    STATE.unlink(missing_ok=True)
    path = Path(str(state.get("path", "")))
    if path.is_file() and path.stat().st_size > 0:
        notify("Recording saved", path.name)
        return 0
    notify("Recording stopped", "No playable frames were written")
    return 1


class CaptureApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="com.nocturne.Capture", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window: Gtk.ApplicationWindow | None = None
        self.mode = "photo"
        self.source = "area"
        self.mode_buttons: dict[str, Gtk.Button] = {}
        self.source_buttons: dict[str, Gtk.Button] = {}
        self.pointer_inside = False
        self.dismiss_armed = False
        self._held = False
        try:
            saved = json.loads(PREFERENCES.read_text(encoding="utf-8"))
            if saved.get("mode") in {"photo", "video"}:
                self.mode = saved["mode"]
            if saved.get("source") in {"area", "window", "display"}:
                self.source = saved["source"]
        except (OSError, json.JSONDecodeError):
            pass

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        self.hold()
        self._held = True
        provider = Gtk.CssProvider()
        provider.load_from_data(themed_css(CSS))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self) -> None:
        return

    def do_command_line(self, command_line: Gio.ApplicationCommandLine) -> int:
        arguments = command_line.get_arguments()[1:]
        GLib.idle_add(self._dispatch, arguments)
        return 0

    def _dispatch(self, arguments: list[str]) -> bool:
        if arguments and arguments[0] == "close":
            self._close()
        elif self.window:
            self._close()
        else:
            self._show()
        return False

    def _show(self) -> None:
        window = Gtk.ApplicationWindow(application=self, title="Nocturne Capture")
        window.set_decorated(False)
        window.set_resizable(False)
        Gtk4LayerShell.init_for_window(window)
        Gtk4LayerShell.set_namespace(window, "nocturne-capture")
        Gtk4LayerShell.set_layer(window, Gtk4LayerShell.Layer.OVERLAY)
        Gtk4LayerShell.set_keyboard_mode(window, Gtk4LayerShell.KeyboardMode.ON_DEMAND)
        Gtk4LayerShell.set_anchor(window, Gtk4LayerShell.Edge.BOTTOM, True)
        Gtk4LayerShell.set_margin(window, Gtk4LayerShell.Edge.BOTTOM, 28)
        Gtk4LayerShell.set_exclusive_zone(window, -1)
        self._monitor_at_pointer(window)
        window.connect("notify::is-active", self._activity_changed)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key_pressed)
        window.add_controller(keys)
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", self._pointer_enter)
        motion.connect("leave", self._pointer_leave)
        window.add_controller(motion)

        shell = Gtk.CenterBox()
        shell.add_css_class("shell")
        shell.set_center_widget(self._recording_card() if read_state() else self._capture_card())
        window.set_child(shell)
        self.window = window
        window.present()
        GLib.timeout_add(450, self._arm_dismissal)

    @staticmethod
    def _monitor_at_pointer(window: Gtk.ApplicationWindow) -> None:
        cursor = json_command(["hyprctl", "cursorpos", "-j"])
        monitors = json_command(["hyprctl", "monitors", "-j"])
        if not isinstance(cursor, dict) or not isinstance(monitors, list):
            return
        cursor_x, cursor_y = int(cursor.get("x", 0)), int(cursor.get("y", 0))
        selected = next(
            (
                monitor
                for monitor in monitors
                if int(monitor.get("x", 0)) <= cursor_x < int(monitor.get("x", 0)) + int(monitor.get("width", 0))
                and int(monitor.get("y", 0)) <= cursor_y < int(monitor.get("y", 0)) + int(monitor.get("height", 0))
            ),
            None,
        )
        if not selected:
            return
        model = Gdk.Display.get_default().get_monitors()
        connector = str(selected.get("name", ""))
        for index in range(model.get_n_items()):
            monitor = model.get_item(index)
            if monitor and monitor.get_connector() == connector:
                Gtk4LayerShell.set_monitor(window, monitor)
                return

    def _capture_card(self) -> Gtk.Widget:
        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        card.add_css_class("card")
        title = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        title.append(self._label("NOCTURNE", "eyebrow"))
        title.append(self._label("CAPTURE", "subtle"))
        card.append(title)
        card.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        for key, label in (("photo", "PHOTO"), ("video", "VIDEO")):
            button = self._button(label, self._select_mode, key)
            self.mode_buttons[key] = button
            card.append(button)
        card.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        for key, label in (("area", "AREA"), ("window", "WINDOW"), ("display", "DISPLAY")):
            button = self._button(label, self._select_source, key)
            self.source_buttons[key] = button
            card.append(button)
        capture = Gtk.Button()
        capture.add_css_class("capture")
        icon = Gtk.Image.new_from_icon_name("camera-photo-symbolic" if self.mode == "photo" else "media-record-symbolic")
        icon.set_pixel_size(20)
        capture.set_child(icon)
        capture.connect("clicked", self._perform)
        card.append(capture)
        self._sync_buttons()
        return card

    def _recording_card(self) -> Gtk.Widget:
        state = read_state() or {"started": int(time.time()), "source": "screen"}
        elapsed = max(0, int(time.time()) - int(state.get("started", time.time())))
        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        card.add_css_class("card")
        label = self._label(f"●  REC  {elapsed // 60:02d}:{elapsed % 60:02d}", "recording")
        card.append(label)
        card.append(self._label(str(state.get("source", "screen")).upper(), "subtle"))
        card.append(self._button("STOP + SAVE", self._stop, css="stop"))
        GLib.timeout_add_seconds(1, self._refresh_recording)
        return card

    def _refresh_recording(self) -> bool:
        if self.window and read_state():
            shell = Gtk.CenterBox()
            shell.add_css_class("shell")
            shell.set_center_widget(self._recording_card())
            self.window.set_child(shell)
            return False
        return False

    @staticmethod
    def _label(text: str, css: str = "") -> Gtk.Label:
        label = Gtk.Label(label=text, xalign=0)
        if css:
            label.add_css_class(css)
        return label

    @staticmethod
    def _button(label: str, callback: Any, *args: Any, css: str = "") -> Gtk.Button:
        button = Gtk.Button(label=label)
        if css:
            button.add_css_class(css)
        button.connect("clicked", callback, *args)
        return button

    def _select_mode(self, _button: Gtk.Button, mode: str) -> None:
        self.mode = mode
        self._save_preferences()
        if self.window:
            shell = Gtk.CenterBox()
            shell.add_css_class("shell")
            shell.set_center_widget(self._capture_card())
            self.window.set_child(shell)

    def _select_source(self, _button: Gtk.Button, source: str) -> None:
        self.source = source
        self._save_preferences()
        self._sync_buttons()

    def _sync_buttons(self) -> None:
        for key, button in self.mode_buttons.items():
            (button.add_css_class if key == self.mode else button.remove_css_class)("active")
        for key, button in self.source_buttons.items():
            (button.add_css_class if key == self.source else button.remove_css_class)("active")

    def _save_preferences(self) -> None:
        try:
            PREFERENCES.parent.mkdir(parents=True, exist_ok=True)
            PREFERENCES.write_text(json.dumps({"mode": self.mode, "source": self.source}), encoding="utf-8")
        except OSError:
            pass

    def _perform(self, _button: Gtk.Button) -> None:
        action = "shot" if self.mode == "photo" else "record"
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), action, self.source],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        self._close()

    def _stop(self, _button: Gtk.Button) -> None:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "stop"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        self._close()

    def _activity_changed(self, window: Gtk.ApplicationWindow, _param: object) -> None:
        if not window.is_active() and self.dismiss_armed and not self.pointer_inside:
            GLib.timeout_add(80, self._close_if_outside)

    def _pointer_enter(self, *_args: object) -> None:
        self.pointer_inside = True
        self.dismiss_armed = True

    def _pointer_leave(self, *_args: object) -> None:
        self.pointer_inside = False

    def _arm_dismissal(self) -> bool:
        self.dismiss_armed = True
        return False

    def _close_if_outside(self) -> bool:
        if self.window and not self.window.is_active() and not self.pointer_inside:
            self._close()
        return False

    def _key_pressed(self, _controller: object, keyval: int, _keycode: int, _state: int) -> bool:
        if keyval == Gdk.KEY_Escape:
            self._close()
            return True
        return False

    def _close(self) -> None:
        if self.window:
            self.window.destroy()
            self.window = None
        if self._held:
            self.release()
            self._held = False
        self.quit()


def self_test() -> int:
    assert re.search(r"Volume", "Volume")
    assert output_path(False).parent.name == "Screenshots"
    assert output_path(True).parent.name == "Screenrecords"
    print("NOCTURNE // capture model tests passed")
    return 0


if __name__ == "__main__":
    arguments = sys.argv[1:]
    if arguments == ["--self-test"]:
        raise SystemExit(self_test())
    if arguments and arguments[0] == "shot":
        raise SystemExit(take_screenshot(arguments[1] if len(arguments) > 1 else "area"))
    if arguments and arguments[0] == "record":
        raise SystemExit(start_recording(arguments[1] if len(arguments) > 1 else "area"))
    if arguments and arguments[0] == "stop":
        raise SystemExit(stop_recording())
    raise SystemExit(CaptureApp().run([sys.argv[0], *(arguments or ["toggle"])]))
