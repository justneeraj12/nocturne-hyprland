    def find_wallpaper_sources(self) -> list[tuple[str, str]]:
        sources: list[tuple[str, str]] = []
        roots = [Path("/usr/share/backgrounds/Dynamic_Wallpapers"), HOME / ".local/share/backgrounds"]
        for root in roots:
            if not root.is_dir():
                continue
            for path in sorted(root.glob("*.xml")):
                name = re.sub(r"(?<!^)(?=[A-Z])", " ", path.stem).replace("-", " ").title()
                if path.name == "SolidForest.xml":
                    name = "Solid Forest · previous GNOME pack"
                sources.append((name, str(path)))
        return sources

    @staticmethod
    def draw_swatch(context: object, width: int, height: int, shade: Gdk.RGBA) -> None:
        context.set_source_rgba(shade.red, shade.green, shade.blue, shade.alpha)
        context.rectangle(0, 0, width, height)
        context.fill()

    def current_wallpaper_path(self) -> Path | None:
        for source in (WALLPAPER_STATE, WALLPAPER_CONFIG):
            try:
                data = json.loads(source.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            value = data.get("current") if source == WALLPAPER_STATE else data.get("source")
            if value:
                path = Path(value).expanduser()
                if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES:
                    return path.resolve()
        return None

    def find_static_wallpapers(self) -> list[Path]:
        try:
            WALLPAPER_LIBRARY.mkdir(parents=True, exist_ok=True)
        except OSError:
            pass

        candidates: list[Path] = []
        current = self.current_wallpaper_path()
        if current:
            candidates.append(current)

        for root in (WALLPAPER_LIBRARY, HOME / ".local/share/backgrounds/Nocturne_Abstract"):
            if not root.is_dir():
                continue
            candidates.extend(
                path for path in sorted(root.rglob("*"), key=lambda item: item.name.lower())
                if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES
            )

        background_root = HOME / ".local/share/backgrounds"
        if background_root.is_dir():
            candidates.extend(
                path for path in sorted(background_root.iterdir(), key=lambda item: item.name.lower())
                if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES
            )

        wallpapers: list[Path] = []
        seen: set[str] = set()
        for path in candidates:
            try:
                resolved = path.resolve()
            except OSError:
                continue
            key = str(resolved)
            if key not in seen:
                seen.add(key)
                wallpapers.append(resolved)
        return wallpapers

    def refresh_static_wallpapers(self) -> bool:
        if not hasattr(self, "static_wallpaper_grid"):
            return False
        child = self.static_wallpaper_grid.get_first_child()
        while child is not None:
            next_child = child.get_next_sibling()
            self.static_wallpaper_grid.remove(child)
            child = next_child

        current = self.current_wallpaper_path()
        wallpapers = self.find_static_wallpapers()
        visible_wallpapers = wallpapers if self.show_all_wallpapers else wallpapers[:6]
        self.wallpaper_expand_button.set_label(
            "SHOW LESS" if self.show_all_wallpapers else f"SHOW ALL ({len(wallpapers)})"
        )
        for path in visible_wallpapers:
            active = current == path
            button = Gtk.Button(tooltip_text=str(path))
            button.add_css_class("wallpaper-tile")
            if active:
                button.add_css_class("current-wallpaper")
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            overlay = Gtk.Overlay()
            picture = Gtk.Picture.new_for_filename(str(path))
            picture.set_content_fit(Gtk.ContentFit.COVER)
            picture.set_can_shrink(True)
            picture.set_size_request(184, 104)
            overlay.set_child(picture)
            if active:
                badge = Gtk.Label(label="CURRENT", halign=Gtk.Align.END, valign=Gtk.Align.START)
                badge.add_css_class("current-badge")
                overlay.add_overlay(badge)
            content.append(overlay)
            name = re.sub(r"^\d+[-_ ]*", "", path.stem).replace("-", " ").replace("_", " ").title()
            label = Gtk.Label(label=name, ellipsize=3, max_width_chars=25)
            label.add_css_class("wallpaper-name")
            content.append(label)
            button.set_child(content)
            button.connect("clicked", self.apply_static_wallpaper, str(path))
            self.static_wallpaper_grid.append(button)
        return False

    def toggle_wallpaper_library(self, _button: Gtk.Button) -> None:
        self.show_all_wallpapers = not self.show_all_wallpapers
        self.refresh_static_wallpapers()

    def apply_static_wallpaper(self, _button: object, path: str) -> None:
        self.run([str(WALLPAPER_TOOL), "apply-source", path])
        self.wallpaper_status.set_text(f"APPLYING · {Path(path).name} · all displays")
        GLib.timeout_add(900, self.refresh_static_wallpapers)
        GLib.timeout_add(1400, self.refresh_wallpaper_status)

    def open_wallpaper_library(self) -> None:
        try:
            WALLPAPER_LIBRARY.mkdir(parents=True, exist_ok=True)
        except OSError as error:
            self.toast(f"Could not create wallpaper folder: {error.strerror}")
            return
        self.run(["nautilus", "--new-window", str(WALLPAPER_LIBRARY)])

    def import_static_wallpaper(self, _button: Gtk.Button) -> None:
        dialog = Gtk.FileDialog(title="Add a wallpaper", modal=True)
        images = Gtk.FileFilter(name="Wallpaper images")
        for mime_type in ("image/png", "image/jpeg", "image/webp"):
            images.add_mime_type(mime_type)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(images)
        dialog.set_filters(filters)
        dialog.set_default_filter(images)
        initial = HOME / "Downloads"
        dialog.set_initial_folder(Gio.File.new_for_path(str(initial if initial.is_dir() else HOME)))
        self.wallpaper_file_dialog = dialog
        dialog.open(self, None, self.static_wallpaper_imported)

    def static_wallpaper_imported(self, dialog: Gtk.FileDialog, result: Gio.AsyncResult) -> None:
        try:
            selected = dialog.open_finish(result)
        except GLib.Error:
            return
        source_path = selected.get_path()
        if not source_path:
            self.toast("That wallpaper is not a local file")
            return
        source = Path(source_path)
        if source.suffix.lower() not in IMAGE_SUFFIXES:
            self.toast("Choose a PNG, JPEG or WebP image")
            return
        try:
            WALLPAPER_LIBRARY.mkdir(parents=True, exist_ok=True)
            target = WALLPAPER_LIBRARY / source.name
            if source.resolve() != target.resolve():
                counter = 2
                while target.exists():
                    target = WALLPAPER_LIBRARY / f"{source.stem}-{counter}{source.suffix.lower()}"
                    counter += 1
                shutil.copy2(source, target)
            else:
                target = source
        except OSError as error:
            self.toast(f"Could not add wallpaper: {error.strerror}")
            return
        self.apply_static_wallpaper(None, str(target))
        self.refresh_static_wallpapers()

    def wallpaper_config(self) -> dict:
        try:
            return json.loads(WALLPAPER_CONFIG.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}

    def source_images(self, source: str) -> list[Path]:
        path = Path(source).expanduser()
        images: list[Path] = []
        if path.is_dir():
            for pattern in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
                images.extend(sorted(path.glob(pattern)))
        elif path.suffix.lower() == ".xml" and path.is_file():
            try:
                for node in ET.parse(path).getroot().iter():
                    if node.tag.rsplit("}", 1)[-1] not in {"file", "from", "to"} or not node.text:
                        continue
                    image = Path(node.text.strip()).expanduser()
                    if not image.is_absolute():
                        image = path.parent / image
                    if image.is_file() and image not in images:
                        images.append(image)
            except (ET.ParseError, OSError):
                pass
        elif path.is_file():
            images.append(path)
        return images

    def update_wallpaper_preview(self, *_args: object) -> bool:
        if not hasattr(self, "wallpaper_sources") or not self.wallpaper_sources:
            return False
        index = self.wallpaper_source.get_selected()
        if index >= len(self.wallpaper_sources):
            index = 0
        name, source = self.wallpaper_sources[index]
        images = self.source_images(source)
        if not images:
            self.wallpaper_preview.set_paintable(None)
            self.wallpaper_preview_caption.set_text(f"{name} · no readable images")
            self.wallpaper_dynamic_info.set_text("This collection has no readable image phases.")
            return False
        image = images[0]
        schedule_copy = "Schedule details are unavailable."
        try:
            result = subprocess.run([str(WALLPAPER_TOOL), "phase", source], capture_output=True, text=True, timeout=2, check=False)
            phase = json.loads(result.stdout)
            scheduled = Path(phase.get("image", ""))
            if scheduled.is_file():
                image = scheduled
            next_change = datetime.fromisoformat(phase["next_change_at"]).strftime("%-I:%M %p")
            phase_number = int(phase.get("index", 0)) + 1
            phase_count = int(phase.get("phases", len(images)))
            kind = str(phase.get("kind", "phase")).replace("-", " ").upper()
            schedule_copy = f"Now: {image.stem}\nPhase: {phase_number} of {phase_count} · {kind}\nNext change: {next_change}"
        except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
            pass
        try:
            self.wallpaper_texture = Gdk.Texture.new_from_filename(str(image))
            self.wallpaper_preview.set_paintable(self.wallpaper_texture)
            self.wallpaper_preview_caption.set_text(f"{name} · {image.name}")
            self.wallpaper_dynamic_info.set_text(schedule_copy)
        except GLib.Error:
            self.wallpaper_preview.set_paintable(None)
            self.wallpaper_preview_caption.set_text(f"{name} · preview unavailable")
            self.wallpaper_dynamic_info.set_text("The schedule is readable, but this image could not be previewed.")
        return False

    def apply_selected_wallpaper(self, _button: Gtk.Button) -> None:
        if not self.wallpaper_sources:
            return
        index = min(self.wallpaper_source.get_selected(), len(self.wallpaper_sources) - 1)
        source = self.wallpaper_sources[index][1]
        self.run([str(WALLPAPER_TOOL), "apply-source", source])
        self.wallpaper_status.set_text("SYNCING · applying the current day-cycle phase…")
        GLib.timeout_add(1600, self.refresh_wallpaper_status)

    def enable_wallpapers(self, _button: Gtk.Button) -> None:
        if not self.wallpaper_sources:
            self.toast("No dynamic wallpaper packs were found")
            return
        source_index = min(self.wallpaper_source.get_selected(), len(self.wallpaper_sources) - 1)
        source = self.wallpaper_sources[source_index][1]
        self.run([str(WALLPAPER_TOOL), "enable", source])
        self.wallpaper_status.set_text("FOLLOWING · syncing to the collection's current phase…")
        GLib.timeout_add(1500, self.refresh_wallpaper_status)

    def stop_wallpapers(self, _button: Gtk.Button) -> None:
        self.run([str(WALLPAPER_TOOL), "disable"])
        self.wallpaper_status.set_text("STOPPED · the current image stays in place")
        GLib.timeout_add(900, self.refresh_wallpaper_status)

    def refresh_wallpaper_status(self) -> bool:
        try:
            result = subprocess.run([str(WALLPAPER_TOOL), "status"], capture_output=True, text=True, timeout=2, check=False)
            status = json.loads(result.stdout)
            enabled = bool(status.get("enabled"))
            service = bool(status.get("service_active"))
            display = bool(status.get("display_active"))
            if not display:
                state = "DISPLAY OFFLINE"
            elif enabled and service:
                state = "FOLLOWING DAY CYCLE"
            elif enabled:
                state = "DAY CYCLE PAUSED"
            else:
                state = "STATIC"
            count = status.get("count", 0)
            current = Path(status.get("current", "")).name or "not applied yet"
            monitors = status.get("monitors", [])
            target = f"{len(monitors)} displays" if monitors else "display auto-detect"
            next_copy = ""
            if status.get("next_change_at"):
                try:
                    next_time = datetime.fromisoformat(status["next_change_at"]).strftime("%-I:%M %p")
                    next_copy = f" · next {next_time}"
                except ValueError:
                    pass
            self.wallpaper_status.set_text(f"{state} · {target} · {current}{next_copy}")
            self.wallpaper_current = status.get("current", "")
            source = status.get("source", "")
            for index, (_name, path) in enumerate(self.wallpaper_sources):
                if path == source:
                    self.wallpaper_source.set_selected(index)
                    break
            self.refresh_static_wallpapers()
            self.update_wallpaper_preview()
        except (OSError, ValueError, subprocess.TimeoutExpired, AttributeError):
            if hasattr(self, "wallpaper_status"):
                self.wallpaper_status.set_text("Wallpaper controller is not installed yet · run apply-hyprland.sh")
        return False

    def set_accent(self, _button: Gtk.Button, color: str) -> None:
        for button, name in self.accent_buttons:
            if name == color:
                button.add_css_class("current-accent")
            else:
                button.remove_css_class("current-accent")
        self.run([str(SCRIPT_HOME / "accent"), color])
        self.toast(f"Accent changed to {color}")
        GLib.timeout_add(650, self.reload_css)

    def set_theme(self, _button: Gtk.Button, preset: str) -> None:
        selected_name = {
            "obsidian": "Obsidian Grid", "carbon": "Carbon Compact",
            "midnight": "Midnight Circuit", "phosphor": "Phosphor Terminal",
            "crimson": "Crimson Relay", "copper-blue": "Copper Blue",
            "copper-green": "Copper Deep Green", "copper-gold": "Copper Deep Gold",
        }.get(preset, preset.title())
        for button, name in self.theme_buttons:
            if name == selected_name:
                button.add_css_class("current-theme")
            else:
                button.remove_css_class("current-theme")
        self.run([str(SCRIPT_HOME / "theme-preset"), preset])
        self.toast(f"Applying {selected_name}")
        GLib.timeout_add(700, self.refresh_theme_ui)

    def refresh_theme_ui(self) -> bool:
        self.design_title.set_text(f"Surface preset · {current_theme_name()}")
        self.reload_css()
        return False

    def power_profile(self) -> str:
        try:
            result = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=1, check=False)
            return result.stdout.strip() or "balanced"
        except (OSError, subprocess.TimeoutExpired):
            return "balanced"

    def on_key(self, _controller: Gtk.EventControllerKey, keyval: int, _keycode: int, _state: Gdk.ModifierType) -> bool:
        if _state & Gdk.ModifierType.CONTROL_MASK and keyval in (Gdk.KEY_b, Gdk.KEY_B):
            self.toggle_sidebar(None)
            return True
        if keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up, Gdk.KEY_Home, Gdk.KEY_End):
            page = self.stack.get_visible_child()
            if isinstance(page, Gtk.ScrolledWindow):
                adjustment = page.get_vadjustment()
                maximum = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
                if keyval == Gdk.KEY_Page_Down:
                    value = adjustment.get_value() + adjustment.get_page_size() * 0.82
                elif keyval == Gdk.KEY_Page_Up:
                    value = adjustment.get_value() - adjustment.get_page_size() * 0.82
                elif keyval == Gdk.KEY_Home:
                    value = 0.0
                else:
                    value = maximum
                adjustment.set_value(min(max(value, 0.0), maximum))
                return True
        if keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.close()
            return True
        return False


class SettingsApplication(Gtk.Application):
    def __init__(self, start_page: str = "Overview"):
        super().__init__(application_id="com.nocturne.Settings", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start_page = start_page

    def do_activate(self) -> None:
        window = self.props.active_window
        if window is None:
            window = SettingsWindow(self)
        window.show_page(self.start_page)
        window.maximize()
        window.present()


if __name__ == "__main__":
    requested = sys.argv[1].title() if len(sys.argv) > 1 else "Overview"
    application = SettingsApplication(requested)
    raise SystemExit(application.run([sys.argv[0]]))
