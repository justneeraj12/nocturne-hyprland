    def shortcuts_page(self) -> Gtk.Widget:
        scroll, box = self.page("Shortcuts + habits", "You only need a small core. The rest becomes discoverable when you need it.")
        groups = [
            ("Start here", [("Super + Space", "Find any app"), ("Super + R", "Nocturne Settings"), ("Super + /", "Quick guide"), ("Super + Enter", "Terminal")]),
            ("Windows", [("Super + Q", "Close"), ("Super + M", "Minimize"), ("Super + Shift + M", "Restore minimized"), ("Super + F", "Fullscreen"), ("Super + A", "Snap a floating app"), ("Super + V", "Toggle floating")]),
            ("Move around", [("Super + H/J/K/L", "Focus tiles"), ("Super + Shift + H/J/K/L", "Move tile"), ("Super + 1…9", "Change workspace"), ("Super + Shift + 1…9", "Send window"), ("Super + S", "Show scratchpad"), ("Super + Shift + S", "Send to scratchpad")]),
            ("Useful tools", [("Super + E", "Files"), ("Super + B", "Browser"), ("Super + D", "VS Code"), ("Super + T", "Steam"), ("Super + N", "Notifications"), ("Super + Shift + V", "Clipboard"), ("Super + W", "Wallpaper"), ("Super + Esc", "Lock")]),
        ]
        for group, shortcuts in groups:
            self.section(box, group)
            for keys, meaning in shortcuts:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.add_css_class("card")
                key = Gtk.Label(label=keys, xalign=0)
                key.add_css_class("keycap")
                row.append(key)
                value = Gtk.Label(label=meaning, xalign=0, hexpand=True)
                value.add_css_class("row-title")
                row.append(value)
                box.append(row)
        self.section(box, "Workflow habits that actually help")
        for title, copy in [
            ("Keep fixed workspace roles", "A repeatable map is faster than remembering where a window went."),
            ("Send windows instead of dragging", "Super+Shift+number is precise, fast and preserves the tiling layout."),
            ("Scratchpad the temporary stuff", "A calculator, music player or spare terminal can appear anywhere with Super+S."),
            ("Fullscreen only for content", "Keep normal apps tiled; use fullscreen for video, games or focused reading."),
            ("Use caffeine deliberately", "Turn it on for presentations, long downloads or watching video; turn it off afterward."),
            ("Right-click the bar", "Most status items expose their second useful action on right-click or scroll."),
        ]:
            self.action_row(box, title, copy, [])
        return scroll

    def find_wallpaper_sources(self) -> list[tuple[str, str]]:
        sources: list[tuple[str, str]] = []
        roots = [Path("/usr/share/backgrounds/Dynamic_Wallpapers"), HOME / ".local/share/backgrounds"]
        for root in roots:
            if not root.is_dir():
                continue
            for path in sorted(root.glob("*.xml")):
                name = re.sub(r"(?<!^)(?=[A-Z])", " ", path.stem).replace("-", " ").title()
                if path.name == "SolidForest.xml":
                    name = "Solid Forest · previous GNOME pack"
                sources.append((name, str(path)))
        return sources

    def wallpaper_config(self) -> dict:
        try:
            return json.loads(WALLPAPER_CONFIG.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}

    def enable_wallpapers(self, _button: Gtk.Button) -> None:
        if not self.wallpaper_sources:
            self.toast("No dynamic wallpaper packs were found")
            return
        source_index = min(self.wallpaper_source.get_selected(), len(self.wallpaper_sources) - 1)
        interval_index = min(self.wallpaper_interval.get_selected(), len(self.intervals) - 1)
        source = self.wallpaper_sources[source_index][1]
        seconds = str(self.intervals[interval_index][1])
        self.run([str(WALLPAPER_TOOL), "enable", source, seconds])
        self.wallpaper_status.set_text("ENABLING · applying the first image…")
        GLib.timeout_add(1500, self.refresh_wallpaper_status)

    def next_wallpaper(self, _button: Gtk.Button) -> None:
        self.run([str(WALLPAPER_TOOL), "next"])
        self.wallpaper_status.set_text("ADVANCING · applying the next image…")
        GLib.timeout_add(1100, self.refresh_wallpaper_status)

    def use_gnome_wallpaper(self, _button: Gtk.Button) -> None:
        interval_index = min(self.wallpaper_interval.get_selected(), len(self.intervals) - 1)
        self.run([str(WALLPAPER_TOOL), "use-gnome", str(self.intervals[interval_index][1])])
        self.wallpaper_status.set_text("IMPORTING · using GNOME's current wallpaper source…")
        GLib.timeout_add(1500, self.refresh_wallpaper_status)

    def stop_wallpapers(self, _button: Gtk.Button) -> None:
        self.run([str(WALLPAPER_TOOL), "disable"])
        self.wallpaper_status.set_text("STOPPED · the current image stays in place")
        GLib.timeout_add(900, self.refresh_wallpaper_status)

    def refresh_wallpaper_status(self) -> bool:
        try:
            result = subprocess.run([str(WALLPAPER_TOOL), "status"], capture_output=True, text=True, timeout=2, check=False)
            status = json.loads(result.stdout)
            enabled = bool(status.get("enabled"))
            state = "ROTATING" if enabled else "STATIC"
            count = status.get("count", 0)
            current = Path(status.get("current", "")).name or "not applied yet"
            self.wallpaper_status.set_text(f"{state} · {count} images · current: {current}")
            source = status.get("source", "")
            for index, (_name, path) in enumerate(self.wallpaper_sources):
                if path == source:
                    self.wallpaper_source.set_selected(index)
                    break
            interval = int(status.get("interval", 900))
            for index, (_name, seconds) in enumerate(self.intervals):
                if seconds == interval:
                    self.wallpaper_interval.set_selected(index)
                    break
        except (OSError, ValueError, subprocess.TimeoutExpired, AttributeError):
            if hasattr(self, "wallpaper_status"):
                self.wallpaper_status.set_text("Wallpaper controller is not installed yet · run apply-hyprland.sh")
        return False

    def set_accent(self, _button: Gtk.Button, color: str) -> None:
        self.run([str(SCRIPT_HOME / "accent"), color])
        self.toast(f"Accent changed to {color}; reopen Settings to refresh this window")

    def power_profile(self) -> str:
        try:
            result = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=1, check=False)
            return result.stdout.strip() or "balanced"
        except (OSError, subprocess.TimeoutExpired):
            return "balanced"

    def on_key(self, _controller: Gtk.EventControllerKey, keyval: int, _keycode: int, _state: Gdk.ModifierType) -> bool:
        if keyval in (Gdk.KEY_Escape, Gdk.KEY_q):
            self.close()
            return True
        return False


class SettingsApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.nocturne.Settings", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self) -> None:
        window = self.props.active_window
        if window is None:
            window = SettingsWindow(self)
        window.maximize()
        window.present()


if __name__ == "__main__":
    application = SettingsApplication()
    raise SystemExit(application.run([sys.argv[0]]))
