#!/usr/bin/env python3
"""Native, sharp-edged control center for the Nocturne Hyprland desktop."""

from __future__ import annotations

import json
import os
import platform
import re
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SCRIPT_HOME = CONFIG_HOME / "hypr/scripts"
WALLPAPER_TOOL = HOME / ".local/bin/nocturne-wallpaper-cycle"
WALLPAPER_CONFIG = CONFIG_HOME / "nocturne/wallpaper.json"


def accent_color() -> str:
    try:
        match = re.search(r"@define-color\s+accent\s+(#[0-9a-fA-F]{6})", (CONFIG_HOME / "nocturne/accent.css").read_text())
        if match:
            return match.group(1)
    except OSError:
        pass
    return "#5f8f76"


def css() -> str:
    accent = accent_color()
    return f"""
    * {{ font-family: Inter, sans-serif; }}
    window {{ background: #090d0f; color: #d6ded9; }}
    .topbar {{ background: #0c1215; border-bottom: 1px solid #273239; min-height: 52px; }}
    .brand {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-weight: 800; font-size: 15px; color: {accent}; letter-spacing: 1px; }}
    .dim {{ color: #77858a; }}
    .close-button {{ min-width: 34px; min-height: 30px; padding: 0; background: transparent; color: #89969a; border: 1px solid transparent; border-radius: 0; }}
    .close-button:hover {{ color: #f0f4f2; border-color: #704444; background: #241416; }}
    .sidebar {{ background: #0b1013; border-right: 1px solid #222d32; padding: 10px; }}
    .nav-button {{ min-height: 40px; padding: 0 14px; border: 0; border-left: 2px solid transparent; border-radius: 0; background: transparent; color: #88969a; font-weight: 600; }}
    .nav-button:hover {{ background: #11191d; color: #dce4e0; }}
    .nav-button:checked {{ background: #131d20; color: {accent}; border-left-color: {accent}; }}
    .page {{ padding: 26px 30px 38px 30px; }}
    .page-title {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 24px; font-weight: 800; color: #eef3f0; }}
    .page-copy {{ color: #7f8d91; margin-bottom: 9px; }}
    .section-title {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 12px; font-weight: 800; color: {accent}; margin-top: 16px; letter-spacing: 1px; }}
    .card {{ background: #0e1518; border: 1px solid #253138; padding: 15px 17px; }}
    .card:hover {{ border-color: #35464e; background: #10191d; }}
    .row-title {{ color: #d9e1dd; font-weight: 700; }}
    .row-copy {{ color: #738186; font-size: 12px; }}
    button.action {{ min-height: 32px; padding: 4px 13px; border-radius: 0; border: 1px solid #344248; background: #151e22; color: #c9d2ce; }}
    button.action:hover {{ border-color: {accent}; color: #f2f5f3; background: #192529; }}
    button.primary {{ color: #07100c; background: {accent}; border-color: {accent}; font-weight: 800; }}
    button.danger:hover {{ border-color: #a96666; color: #dfa0a0; }}
    dropdown {{ border-radius: 0; border: 1px solid #344248; background: #11191d; color: #d4ddd8; min-height: 36px; }}
    popover contents {{ border-radius: 0; background: #10171a; border: 1px solid #344248; }}
    .metric {{ background: #0b1114; border: 1px solid #202b30; padding: 12px; }}
    .metric-value {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 19px; font-weight: 800; color: {accent}; }}
    .keycap {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-weight: 700; color: {accent}; background: #0a1012; border: 1px solid #334148; padding: 6px 9px; min-width: 150px; }}
    .accent-green {{ background: #5f8f76; }} .accent-teal {{ background: #4f9b95; }}
    .accent-slate {{ background: #82919c; }} .accent-blue {{ background: #638fb8; }}
    .accent-purple {{ background: #9476ad; }} .accent-red {{ background: #a96666; }}
    .accent-orange {{ background: #b17a51; }} .accent-yellow {{ background: #a9965c; }}
    .accent-choice {{ min-width: 30px; min-height: 30px; border-radius: 0; border: 2px solid #11181b; padding: 0; }}
    .accent-choice:hover {{ border-color: #e5ebe8; }}
    """


class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application):
        super().__init__(application=application, title="Nocturne Settings")
        self.set_default_size(1120, 730)
        self.set_size_request(850, 580)
        self.set_decorated(False)
        self.maximize()
        self.pages: dict[str, Gtk.Widget] = {}
        self.nav_buttons: list[Gtk.ToggleButton] = []

        provider = Gtk.CssProvider()
        provider.load_from_data(css().encode())
        Gtk.StyleContext.add_provider_for_display(self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(self.make_header())
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, hexpand=True, vexpand=True)
        body.append(self.make_sidebar())
        self.stack = Gtk.Stack(hexpand=True, vexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=130)
        body.append(self.stack)
        root.append(body)
        self.set_child(root)

        self.add_pages()
        self.nav_buttons[0].set_active(True)
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self.on_key)
        self.add_controller(controller)

    def make_header(self) -> Gtk.Widget:
        handle = Gtk.WindowHandle()
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bar.add_css_class("topbar")
        bar.set_margin_start(18)
        bar.set_margin_end(10)
        brand = Gtk.Label(label="NOCTURNE // SETTINGS", xalign=0, hexpand=True)
        brand.add_css_class("brand")
        bar.append(brand)
        session = Gtk.Label(label="HYPRLAND CONTROL PLANE")
        session.add_css_class("dim")
        bar.append(session)
        close = Gtk.Button(label="×", tooltip_text="Close · Esc or Super+Q")
        close.add_css_class("close-button")
        close.connect("clicked", lambda _button: self.close())
        bar.append(close)
        handle.set_child(bar)
        return handle

    def make_sidebar(self) -> Gtk.Widget:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        sidebar.add_css_class("sidebar")
        sidebar.set_size_request(220, -1)
        entries = [
            ("OVERVIEW", "Overview"),
            ("APPEARANCE", "Appearance"),
            ("CONNECTIVITY", "Connectivity"),
            ("SOUND + MEDIA", "Sound"),
            ("DESKTOP", "Desktop"),
            ("SYSTEM", "System"),
            ("SHORTCUTS", "Shortcuts"),
        ]
        group = None
        for label, name in entries:
            button = Gtk.ToggleButton(label=label)
            button.add_css_class("nav-button")
            if group is not None:
                button.set_group(group)
            else:
                group = button
            button.connect("toggled", self.navigate, name)
            sidebar.append(button)
            self.nav_buttons.append(button)
        spacer = Gtk.Box(vexpand=True)
        sidebar.append(spacer)
        hint = Gtk.Label(label="SUPER + /\nQUICK REFERENCE", xalign=0)
        hint.add_css_class("dim")
        sidebar.append(hint)
        return sidebar

    def navigate(self, button: Gtk.ToggleButton, name: str) -> None:
        if button.get_active() and hasattr(self, "stack"):
            self.stack.set_visible_child_name(name)
            if name == "Appearance":
                self.refresh_wallpaper_status()

    def add_pages(self) -> None:
        builders = {
            "Overview": self.overview_page,
            "Appearance": self.appearance_page,
            "Connectivity": self.connectivity_page,
            "Sound": self.sound_page,
            "Desktop": self.desktop_page,
            "System": self.system_page,
            "Shortcuts": self.shortcuts_page,
        }
        for name, builder in builders.items():
            page = builder()
            self.pages[name] = page
            self.stack.add_named(page, name)

    def page(self, title: str, copy: str) -> tuple[Gtk.ScrolledWindow, Gtk.Box]:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.add_css_class("page")
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("page-title")
        content.append(heading)
        description = Gtk.Label(label=copy, xalign=0, wrap=True)
        description.add_css_class("page-copy")
        content.append(description)
        scroll = Gtk.ScrolledWindow(child=content, hscrollbar_policy=Gtk.PolicyType.NEVER)
        return scroll, content

    def section(self, box: Gtk.Box, title: str) -> None:
        label = Gtk.Label(label=title.upper(), xalign=0)
        label.add_css_class("section-title")
        box.append(label)

    def action_row(self, box: Gtk.Box, title: str, copy: str, actions: list[tuple[str, list[str], str]]) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.add_css_class("card")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("row-title")
        labels.append(heading)
        detail = Gtk.Label(label=copy, xalign=0, wrap=True, max_width_chars=52)
        detail.add_css_class("row-copy")
        labels.append(detail)
        row.append(labels)
        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, valign=Gtk.Align.CENTER)
        for label, command, style in actions:
            button = Gtk.Button(label=label)
            button.add_css_class("action")
            if style:
                button.add_css_class(style)
            button.connect("clicked", lambda _button, cmd=command: self.run(cmd))
            controls.append(button)
        if actions:
            row.append(controls)
        box.append(row)
        return row

    def run(self, command: list[str]) -> None:
        command = [str(Path(item).expanduser()) if item.startswith("~/") else item for item in command]
        try:
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as error:
            self.toast(f"Could not launch {command[0]}: {error.strerror}")

    def toast(self, message: str) -> None:
        self.set_title(f"Nocturne Settings — {message}")
        GLib.timeout_add(2500, lambda: self.set_title("Nocturne Settings") or False)

    def overview_page(self) -> Gtk.Widget:
        scroll, box = self.page("System overview", "The useful controls, without falling back to a mismatched desktop shell.")
        metrics = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        info = [
            ("SESSION", "HYPRLAND"),
            ("KERNEL", platform.release().split("-")[0]),
            ("HOST", platform.node().split(".")[0].upper()),
            ("PROFILE", self.power_profile().upper()),
        ]
        for name, value in info:
            item = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            item.add_css_class("metric")
            number = Gtk.Label(label=value)
            number.add_css_class("metric-value")
            caption = Gtk.Label(label=name)
            caption.add_css_class("dim")
            item.append(number)
            item.append(caption)
            metrics.append(item)
        box.append(metrics)
        self.section(box, "Common controls")
        self.action_row(box, "Find anything", "Search installed apps; type a few letters and press Enter.", [("OPEN LAUNCHER", [str(SCRIPT_HOME / "launcher")], "primary")])
        self.action_row(box, "Hacker dashboard", "CPU, GPU, memory, disks, processes and live audio in one tiled view.", [("OPEN DASHBOARD", [str(HOME / ".local/bin/nocturne-dashboard")], "")])
        self.action_row(box, "Notifications", "Open searchable notification history and do-not-disturb controls.", [("OPEN HISTORY", ["swaync-client", "-t", "-sw"], "")])
        self.action_row(box, "Session", "Lock, suspend, log out, restart or power off from the themed card.", [("POWER CARD", [str(SCRIPT_HOME / "power-menu")], "")])
        self.section(box, "Best first habits")
        for title, copy in [
            ("Give workspaces jobs", "1 browser/chat · 2 code · 3 media · 4 games. Muscle memory beats window hunting."),
            ("Move; do not minimize", "Super+Shift+1…9 sends a window directly where it belongs. Use the scratchpad for temporary tools."),
            ("Use the keyboard, keep the mouse", "Super+H/J/K/L focuses tiles. Super+drag still moves or resizes anything unusual."),
        ]:
            self.action_row(box, title, copy, [])
        return scroll

    def appearance_page(self) -> Gtk.Widget:
        scroll, box = self.page("Appearance", "One visual language for the shell, apps, borders and wallpapers.")
        self.section(box, "Accent")
        accent_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        accent_card.add_css_class("card")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
        title = Gtk.Label(label="System accent", xalign=0)
        title.add_css_class("row-title")
        copy = Gtk.Label(label="Updates GTK, Waybar and the active Hyprland border together.", xalign=0)
        copy.add_css_class("row-copy")
        labels.append(title)
        labels.append(copy)
        accent_card.append(labels)
        for color in ("green", "teal", "slate", "blue", "purple", "red", "orange", "yellow"):
            button = Gtk.Button(tooltip_text=color.title())
            button.add_css_class("accent-choice")
            button.add_css_class(f"accent-{color}")
            button.connect("clicked", self.set_accent, color)
            accent_card.append(button)
        box.append(accent_card)

        self.section(box, "Dynamic wallpaper")
        wallpaper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=11)
        wallpaper.add_css_class("card")
        heading = Gtk.Label(label="Wallpaper rotation", xalign=0)
        heading.add_css_class("row-title")
        wallpaper.append(heading)
        copy = Gtk.Label(label="Uses GNOME dynamic XML packs or any image folder. Rotation runs only in your Hyprland session.", xalign=0, wrap=True)
        copy.add_css_class("row-copy")
        wallpaper.append(copy)

        source_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        source_label = Gtk.Label(label="COLLECTION", xalign=0, width_chars=13)
        source_label.add_css_class("dim")
        source_line.append(source_label)
        self.wallpaper_sources = self.find_wallpaper_sources()
        names = Gtk.StringList.new([name for name, _path in self.wallpaper_sources])
        self.wallpaper_source = Gtk.DropDown(model=names, hexpand=True)
        source_line.append(self.wallpaper_source)
        wallpaper.append(source_line)

        interval_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        interval_label = Gtk.Label(label="INTERVAL", xalign=0, width_chars=13)
        interval_label.add_css_class("dim")
        interval_line.append(interval_label)
        self.intervals = [("5 minutes", 300), ("15 minutes", 900), ("30 minutes", 1800), ("1 hour", 3600), ("3 hours", 10800), ("At login / 12h", 43200)]
        self.wallpaper_interval = Gtk.DropDown(model=Gtk.StringList.new([name for name, _seconds in self.intervals]), hexpand=True)
        self.wallpaper_interval.set_selected(1)
        interval_line.append(self.wallpaper_interval)
        wallpaper.append(interval_line)

        controls = Gtk.FlowBox(column_spacing=8, row_spacing=8, selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4)
        enable = Gtk.Button(label="ENABLE ROTATION")
        enable.add_css_class("action")
        enable.add_css_class("primary")
        enable.connect("clicked", self.enable_wallpapers)
        controls.append(enable)
        for label, callback, style in [
            ("NEXT", self.next_wallpaper, ""),
            ("USE GNOME CURRENT", self.use_gnome_wallpaper, ""),
            ("STOP", self.stop_wallpapers, "danger"),
        ]:
            button = Gtk.Button(label=label)
            button.add_css_class("action")
            if style:
                button.add_css_class(style)
            button.connect("clicked", callback)
            controls.append(button)
        wallpaper.append(controls)
        self.wallpaper_status = Gtk.Label(label="Checking wallpaper service…", xalign=0, ellipsize=3)
        self.wallpaper_status.add_css_class("row-copy")
        wallpaper.append(self.wallpaper_status)
        box.append(wallpaper)

        self.section(box, "Static wallpaper + application style")
        self.action_row(box, "Choose one wallpaper", "Picking a static image automatically pauses rotation.", [("CHOOSE IMAGE", [str(SCRIPT_HOME / "wallpaper")], "")])
        self.action_row(box, "GTK appearance", "Fine-tune GTK theme, icons, cursor and fonts.", [("OPEN NWG LOOK", ["nwg-look"], "")])
        self.action_row(box, "Nocturne Files", "Sharp header, compact list view, dark sidebar and matching selection accent.", [("OPEN FILES", ["nautilus", "--new-window"], "primary")])
        GLib.idle_add(self.refresh_wallpaper_status)
        return scroll

