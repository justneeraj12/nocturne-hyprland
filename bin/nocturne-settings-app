#!/usr/bin/env python3
"""Native, sharp-edged control center for the Nocturne Hyprland desktop."""

from __future__ import annotations

import json
import os
import platform
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
from datetime import datetime
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SCRIPT_HOME = CONFIG_HOME / "hypr/scripts"
WALLPAPER_TOOL = HOME / ".local/bin/nocturne-wallpaper-cycle"
WALLPAPER_CONFIG = CONFIG_HOME / "nocturne/wallpaper.json"


def accent_color() -> str:
    try:
        match = re.search(r"@define-color\s+accent\s+(#[0-9a-fA-F]{6})", (CONFIG_HOME / "nocturne/accent.css").read_text())
        if match:
            return match.group(1)
    except OSError:
        pass
    return "#5f8f76"


def palette_colors() -> dict[str, str]:
    colors = {
        "base": "#07090a", "surface": "#0b0f10", "overlay": "#111719",
        "line": "#1b2925", "text": "#a7b8b1", "muted": "#4d5d58",
        "view": "#0b1114", "sidebar": "#0a1012", "header": "#0c1215",
        "card": "#0e1518", "selection": "#15221e",
    }
    try:
        source = (CONFIG_HOME / "nocturne/palette.css").read_text(encoding="utf-8")
        for name, value in re.findall(r"@define-color\s+([a-z_]+)\s+(#[0-9a-fA-F]{6})", source):
            if name in colors:
                colors[name] = value
    except OSError:
        pass
    return colors


def current_theme_name() -> str:
    try:
        return json.loads((CONFIG_HOME / "nocturne/theme.json").read_text(encoding="utf-8")).get("name", "Obsidian Grid")
    except (OSError, ValueError):
        return "Obsidian Grid"


def css() -> str:
    accent = accent_color()
    colors = palette_colors()
    return f"""
    * {{ font-family: Inter, sans-serif; font-size: 10px; }}
    window, .app-root {{ background: {colors['base']}; color: {colors['text']}; }}
    .topbar {{ background: {colors['header']}; border-bottom: 1px solid {colors['line']}; min-height: 44px; }}
    .brand {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-weight: 700; font-size: 12px; color: {accent}; letter-spacing: 0.7px; }}
    .dim {{ color: {colors['muted']}; font-size: 9px; }}
    .close-button {{ min-width: 28px; min-height: 26px; padding: 0; background: transparent; color: {colors['muted']}; border: 1px solid transparent; border-radius: 0; }}
    .close-button:hover {{ color: #f0f4f2; border-color: #704444; background: #241416; }}
    .sidebar {{ background: {colors['sidebar']}; border-right: 1px solid {colors['line']}; padding: 7px; }}
    .nav-button {{ min-height: 34px; padding: 0 11px; border: 0; border-left: 2px solid transparent; border-radius: 0; background: transparent; color: {colors['muted']}; font-size: 9px; font-weight: 600; }}
    .nav-button:hover {{ background: {colors['overlay']}; color: {colors['text']}; }}
    .nav-button:checked {{ background: {colors['selection']}; color: {accent}; border-left-color: {accent}; }}
    .page {{ padding: 18px 22px 28px 22px; }}
    .page-title {{ font-family: Inter, sans-serif; font-size: 19px; font-weight: 700; color: #e9efec; }}
    .page-copy {{ color: {colors['muted']}; font-size: 10px; margin-bottom: 5px; }}
    .section-title {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 9px; font-weight: 700; color: {accent}; margin-top: 10px; letter-spacing: 0.8px; }}
    .card {{ background: {colors['card']}; border: 1px solid {colors['line']}; padding: 10px 12px; }}
    .card:hover {{ border-color: #35464e; background: {colors['surface']}; }}
    .row-title {{ color: #d5ddd9; font-size: 10px; font-weight: 650; }}
    .row-copy {{ color: {colors['muted']}; font-size: 9px; }}
    button.action {{ min-height: 28px; padding: 3px 10px; border-radius: 0; border: 1px solid #344248; background: {colors['overlay']}; color: #c9d2ce; font-size: 9px; }}
    button.action:hover {{ border-color: {accent}; color: #f2f5f3; background: {colors['selection']}; }}
    button.primary {{ color: #07100c; background: {accent}; border-color: {accent}; font-weight: 800; }}
    button.danger:hover {{ border-color: #a96666; color: #dfa0a0; }}
    dropdown {{ border-radius: 0; border: 1px solid #344248; background: {colors['overlay']}; color: #d4ddd8; min-height: 30px; }}
    popover contents {{ border-radius: 0; background: {colors['surface']}; border: 1px solid #344248; }}
    .metric {{ background: {colors['view']}; border: 1px solid {colors['line']}; padding: 9px; }}
    .metric-value {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 15px; font-weight: 700; color: {accent}; }}
    .keycap {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 9px; font-weight: 700; color: {accent}; background: {colors['view']}; border: 1px solid #334148; padding: 5px 8px; min-width: 135px; }}
    .accent-green {{ background: #5f8f76; }} .accent-teal {{ background: #4f9b95; }}
    .accent-cyan {{ background: #4aa6a8; }} .accent-ice {{ background: #8ab7c9; }}
    .accent-slate {{ background: #82919c; }} .accent-blue {{ background: #638fb8; }}
    .accent-indigo {{ background: #707fb8; }}
    .accent-purple {{ background: #9476ad; }} .accent-red {{ background: #a96666; }}
    .accent-magenta {{ background: #ad6f9d; }} .accent-pink {{ background: #c07f9a; }}
    .accent-rose {{ background: #b8737b; }}
    .accent-orange {{ background: #b17a51; }} .accent-yellow {{ background: #a9965c; }}
    .accent-amber {{ background: #b89355; }} .accent-lime {{ background: #86a65d; }}
    .accent-choice {{ min-width: 24px; min-height: 24px; border-radius: 0; border: 2px solid {colors['card']}; padding: 0; }}
    .accent-choice:hover {{ border-color: #e5ebe8; }}
    .theme-choice {{ min-height: 34px; border-radius: 0; border: 1px solid {colors['line']}; background: {colors['view']}; color: {colors['text']}; font-size: 9px; }}
    .theme-choice:hover {{ border-color: {accent}; background: {colors['selection']}; }}
    .wallpaper-preview {{ background: #040607; border: 1px solid {colors['line']}; }}
    .preview-caption {{ font-family: 'MesloLGS Nerd Font Mono', monospace; font-size: 9px; color: {colors['muted']}; }}
    """


class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application):
        super().__init__(application=application, title="Nocturne Settings")
        self.set_default_size(980, 680)
        self.set_size_request(600, 520)
        self.set_decorated(False)
        self.maximize()
        self.pages: dict[str, Gtk.Widget] = {}
        self.nav_buttons: list[Gtk.ToggleButton] = []
        self.nav_names = ["Overview", "Appearance", "Connectivity", "Sound", "Desktop", "System", "Shortcuts"]

        self.provider = Gtk.CssProvider()
        self.provider.load_from_data(css().encode())
        Gtk.StyleContext.add_provider_for_display(self.get_display(), self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.add_css_class("app-root")
        root.append(self.make_header())
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, hexpand=True, vexpand=True)
        body.append(self.make_sidebar())
        self.stack = Gtk.Stack(hexpand=True, vexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=130)
        body.append(self.stack)
        root.append(body)
        self.set_child(root)

        self.add_pages()
        self.nav_buttons[0].set_active(True)
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self.on_key)
        self.add_controller(controller)

    def make_header(self) -> Gtk.Widget:
        handle = Gtk.WindowHandle()
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bar.add_css_class("topbar")
        bar.set_margin_start(18)
        bar.set_margin_end(10)
        brand = Gtk.Label(label="NOCTURNE // SETTINGS", xalign=0, hexpand=True)
        brand.add_css_class("brand")
        bar.append(brand)
        session = Gtk.Label(label="HYPRLAND")
        session.add_css_class("dim")
        bar.append(session)
        close = Gtk.Button(label="×", tooltip_text="Close · Esc or Super+Q")
        close.add_css_class("close-button")
        close.connect("clicked", lambda _button: self.close())
        bar.append(close)
        handle.set_child(bar)
        return handle

    def make_sidebar(self) -> Gtk.Widget:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        sidebar.add_css_class("sidebar")
        sidebar.set_size_request(185, -1)
        entries = [
            ("OVERVIEW", "Overview"),
            ("APPEARANCE", "Appearance"),
            ("CONNECTIVITY", "Connectivity"),
            ("SOUND + MEDIA", "Sound"),
            ("DESKTOP", "Desktop"),
            ("SYSTEM", "System"),
            ("SHORTCUTS", "Shortcuts"),
        ]
        group = None
        for label, name in entries:
            button = Gtk.ToggleButton(label=label)
            button.add_css_class("nav-button")
            if group is not None:
                button.set_group(group)
            else:
                group = button
            button.connect("toggled", self.navigate, name)
            sidebar.append(button)
            self.nav_buttons.append(button)
        spacer = Gtk.Box(vexpand=True)
        sidebar.append(spacer)
        hint = Gtk.Label(label="SUPER + /\nQUICK REFERENCE", xalign=0)
        hint.add_css_class("dim")
        sidebar.append(hint)
        return sidebar

    def navigate(self, button: Gtk.ToggleButton, name: str) -> None:
        if button.get_active() and hasattr(self, "stack"):
            self.stack.set_visible_child_name(name)
            if name == "Appearance":
                self.refresh_wallpaper_status()

    def show_page(self, name: str) -> None:
        if name in self.nav_names:
            self.nav_buttons[self.nav_names.index(name)].set_active(True)

    def add_pages(self) -> None:
        builders = {
            "Overview": self.overview_page,
            "Appearance": self.appearance_page,
            "Connectivity": self.connectivity_page,
            "Sound": self.sound_page,
            "Desktop": self.desktop_page,
            "System": self.system_page,
            "Shortcuts": self.shortcuts_page,
        }
        for name, builder in builders.items():
            page = builder()
            self.pages[name] = page
            self.stack.add_named(page, name)

    def page(self, title: str, copy: str) -> tuple[Gtk.ScrolledWindow, Gtk.Box]:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.add_css_class("page")
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("page-title")
        content.append(heading)
        description = Gtk.Label(label=copy, xalign=0, wrap=True)
        description.add_css_class("page-copy")
        content.append(description)
        scroll = Gtk.ScrolledWindow(child=content, hscrollbar_policy=Gtk.PolicyType.NEVER)
        return scroll, content

    def section(self, box: Gtk.Box, title: str) -> None:
        label = Gtk.Label(label=title.upper(), xalign=0)
        label.add_css_class("section-title")
        box.append(label)

    def action_row(self, box: Gtk.Box, title: str, copy: str, actions: list[tuple[str, list[str], str]]) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.add_css_class("card")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
        heading = Gtk.Label(label=title, xalign=0)
        heading.add_css_class("row-title")
        labels.append(heading)
        detail = Gtk.Label(label=copy, xalign=0, wrap=True, max_width_chars=52)
        detail.add_css_class("row-copy")
        labels.append(detail)
        row.append(labels)
        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, valign=Gtk.Align.CENTER)
        for label, command, style in actions:
            button = Gtk.Button(label=label)
            button.add_css_class("action")
            if style:
                button.add_css_class(style)
            button.connect("clicked", lambda _button, cmd=command: self.run(cmd))
            controls.append(button)
        if actions:
            row.append(controls)
        box.append(row)
        return row

    def run(self, command: list[str]) -> None:
        command = [str(Path(item).expanduser()) if item.startswith("~/") else item for item in command]
        try:
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as error:
            self.toast(f"Could not launch {command[0]}: {error.strerror}")

    def toast(self, message: str) -> None:
        self.set_title(f"Nocturne Settings — {message}")
        GLib.timeout_add(2500, lambda: self.set_title("Nocturne Settings") or False)

    def reload_css(self) -> bool:
        Gtk.StyleContext.remove_provider_for_display(self.get_display(), self.provider)
        self.provider = Gtk.CssProvider()
        self.provider.load_from_data(css().encode())
        Gtk.StyleContext.add_provider_for_display(self.get_display(), self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        return False

    def overview_page(self) -> Gtk.Widget:
        scroll, box = self.page("System overview", "The useful controls, without falling back to a mismatched desktop shell.")
        metrics = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        info = [
            ("SESSION", "HYPRLAND"),
            ("KERNEL", platform.release().split("-")[0]),
            ("HOST", platform.node().split(".")[0].upper()),
            ("PROFILE", self.power_profile().upper()),
        ]
        for name, value in info:
            item = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            item.add_css_class("metric")
            number = Gtk.Label(label=value)
            number.add_css_class("metric-value")
            caption = Gtk.Label(label=name)
            caption.add_css_class("dim")
            item.append(number)
            item.append(caption)
            metrics.append(item)
        box.append(metrics)
        self.section(box, "Common controls")
        self.action_row(box, "Find anything", "Search installed apps; type a few letters and press Enter.", [("OPEN LAUNCHER", [str(SCRIPT_HOME / "launcher")], "primary")])
        self.action_row(box, "Hacker dashboard", "CPU, GPU, memory, disks, processes and live audio in one tiled view.", [("OPEN DASHBOARD", [str(HOME / ".local/bin/nocturne-dashboard")], "")])
        self.action_row(box, "Notifications", "Open searchable notification history and do-not-disturb controls.", [("OPEN HISTORY", ["swaync-client", "-t", "-sw"], "")])
        self.action_row(box, "Session", "Lock, suspend, log out, restart or power off from the themed card.", [("POWER CARD", [str(SCRIPT_HOME / "power-menu")], "")])
        self.section(box, "Best first habits")
        for title, copy in [
            ("Give workspaces jobs", "1 browser/chat · 2 code · 3 media · 4 games. Muscle memory beats window hunting."),
            ("Move; do not minimize", "Super+Shift+1…9 sends a window directly where it belongs. Use the scratchpad for temporary tools."),
            ("Use the keyboard, keep the mouse", "Super+H/J/K/L focuses tiles. Super+drag still moves or resizes anything unusual."),
        ]:
            self.action_row(box, title, copy, [])
        return scroll

    def appearance_page(self) -> Gtk.Widget:
        scroll, box = self.page("Appearance", "Coordinated desktop designs, accents and wallpapers. Shortcuts never change.")
        self.section(box, "Desktop design")
        design = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        design.add_css_class("card")
        self.design_title = Gtk.Label(label=f"Surface preset · {current_theme_name()}", xalign=0)
        self.design_title.add_css_class("row-title")
        design.append(self.design_title)
        design_copy = Gtk.Label(label="Changes shell surfaces, density, gaps and app colors as one set.", xalign=0)
        design_copy.add_css_class("row-copy")
        design.append(design_copy)
        designs = Gtk.FlowBox(column_spacing=6, row_spacing=6, selection_mode=Gtk.SelectionMode.NONE, min_children_per_line=2, max_children_per_line=2)
        for label, preset in [
            ("OBSIDIAN", "obsidian"), ("CARBON", "carbon"), ("MIDNIGHT", "midnight"),
            ("PHOSPHOR", "phosphor"), ("CRIMSON", "crimson"),
        ]:
            button = Gtk.Button(label=label)
            button.add_css_class("theme-choice")
            button.connect("clicked", self.set_theme, preset)
            designs.append(button)
        design.append(designs)
        box.append(design)

        self.section(box, "Accent")
        accent_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        accent_card.add_css_class("card")
        title = Gtk.Label(label="System accent", xalign=0)
        title.add_css_class("row-title")
        copy = Gtk.Label(label="Updates GTK, Waybar and the active Hyprland border together.", xalign=0)
        copy.add_css_class("row-copy")
        accent_card.append(title)
        accent_card.append(copy)
        accents = Gtk.FlowBox(column_spacing=7, row_spacing=7, selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=8)
        for color in ("green", "teal", "cyan", "ice", "slate", "blue", "indigo", "purple", "magenta", "pink", "red", "rose", "orange", "amber", "yellow", "lime"):
            button = Gtk.Button(tooltip_text=color.title())
            button.add_css_class("accent-choice")
            button.add_css_class(f"accent-{color}")
            button.connect("clicked", self.set_accent, color)
            accents.append(button)
        accent_card.append(accents)
        box.append(accent_card)

        self.section(box, "Wallpaper")
        wallpaper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        wallpaper.add_css_class("card")
        heading = Gtk.Label(label="Preview and day cycle", xalign=0)
        heading.add_css_class("row-title")
        wallpaper.append(heading)
        copy = Gtk.Label(label="Each XML follows its authored morning, afternoon, evening and night schedule.", xalign=0, wrap=True)
        copy.add_css_class("row-copy")
        wallpaper.append(copy)

        self.wallpaper_preview = Gtk.Picture(hexpand=True, can_shrink=True, content_fit=Gtk.ContentFit.COVER)
        self.wallpaper_preview.set_size_request(-1, 210)
        self.wallpaper_preview.add_css_class("wallpaper-preview")
        wallpaper.append(self.wallpaper_preview)
        self.wallpaper_preview_caption = Gtk.Label(label="Choose a collection", xalign=0, ellipsize=3)
        self.wallpaper_preview_caption.add_css_class("preview-caption")
        wallpaper.append(self.wallpaper_preview_caption)

        source_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        source_label = Gtk.Label(label="COLLECTION", xalign=0, width_chars=11)
        source_label.add_css_class("dim")
        source_line.append(source_label)
        self.wallpaper_sources = self.find_wallpaper_sources()
        names = Gtk.StringList.new([name for name, _path in self.wallpaper_sources])
        self.wallpaper_source = Gtk.DropDown(model=names, hexpand=True)
        self.wallpaper_source.connect("notify::selected", self.update_wallpaper_preview)
        source_line.append(self.wallpaper_source)
        wallpaper.append(source_line)

        controls = Gtk.FlowBox(column_spacing=8, row_spacing=8, selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=2)
        for label, callback, style in [
            ("APPLY CURRENT PHASE", self.apply_selected_wallpaper, "primary"),
            ("FOLLOW DAY CYCLE", self.enable_wallpapers, ""),
            ("STOP FOLLOWING", self.stop_wallpapers, "danger"),
        ]:
            button = Gtk.Button(label=label)
            button.add_css_class("action")
            if style:
                button.add_css_class(style)
            button.connect("clicked", callback)
            controls.append(button)
        wallpaper.append(controls)
        self.wallpaper_status = Gtk.Label(label="Checking wallpaper service…", xalign=0, ellipsize=3)
        self.wallpaper_status.add_css_class("row-copy")
        wallpaper.append(self.wallpaper_status)
        box.append(wallpaper)

        self.section(box, "Static wallpaper + application style")
        static_row = self.action_row(box, "Choose one wallpaper", "Picking a static image automatically pauses the day cycle.", [])
        choose = Gtk.Button(label="CHOOSE IMAGE", valign=Gtk.Align.CENTER)
        choose.add_css_class("action")
        choose.add_css_class("primary")
        choose.connect("clicked", self.choose_static_wallpaper)
        static_row.append(choose)
        self.action_row(box, "GTK appearance", "Fine-tune GTK theme, icons, cursor and fonts.", [("OPEN NWG LOOK", ["nwg-look"], "")])
        self.action_row(box, "Nocturne Files", "Sharp header, compact list view, dark sidebar and matching selection accent.", [("OPEN FILES", ["nautilus", "--new-window"], "primary")])
        GLib.idle_add(self.refresh_wallpaper_status)
        GLib.idle_add(self.update_wallpaper_preview)
        return scroll

    def connectivity_page(self) -> Gtk.Widget:
        scroll, box = self.page("Connectivity", "Fast themed cards for everyday use, with advanced tools one click away.")
        self.section(box, "Network")
        self.action_row(box, "Wi-Fi", "Connect, disconnect, scan and see the active network.", [("QUICK PANEL", [str(SCRIPT_HOME / "wifi-menu")], "primary"), ("ADVANCED", ["nm-connection-editor"], "")])
        self.action_row(box, "Bluetooth", "Power, scan, connect and disconnect devices.", [("QUICK PANEL", [str(SCRIPT_HOME / "bluetooth-menu")], "primary"), ("DEVICE MANAGER", ["blueman-manager"], "")])
        self.section(box, "Phone")
        self.action_row(box, "KDE Connect", "Clipboard, file transfer, battery, ringing and device status.", [("PHONE CARD", [str(SCRIPT_HOME / "kdeconnect-menu")], "primary"), ("DEVICE SETTINGS", [str(SCRIPT_HOME / "kdeconnect-settings")], "")])
        return scroll

    def sound_page(self) -> Gtk.Widget:
        scroll, box = self.page("Sound + media", "PipeWire controls, per-app volume, DSP and your Nocturne visualizer.")
        self.section(box, "Playback")
        self.action_row(box, "Volume and output", "Switch outputs and change individual app streams.", [("QUICK MIXER", [str(SCRIPT_HOME / "audio-menu")], "primary"), ("FULL MIXER", ["pavucontrol"], "")])
        self.action_row(box, "Audio routing graph", "Patch microphones, applications, effects and output devices visually.", [("OPEN GRAPH", ["qpwgraph"], "")])
        self.section(box, "Effects + visuals")
        self.action_row(box, "EasyEffects", "Equalizer, limiter, compressor and output effects. Start with subtle presets.", [("OPEN EQ", ["easyeffects"], "primary")])
        self.action_row(box, "Nocturne visualizer", "Open the tiled live spectrum or switch cyberdeck designs.", [("OPEN", [str(HOME / ".local/bin/nocturne-visualizer")], "primary"), ("CHOOSE DESIGN", [str(HOME / ".local/bin/nocturne-visualizer"), "choose"], "")])
        return scroll

    def desktop_page(self) -> Gtk.Widget:
        scroll, box = self.page("Desktop", "The shell features you use all day, collected in one place.")
        self.section(box, "Focus")
        self.action_row(box, "Caffeine mode", "Temporarily prevent idle dimming and locking.", [("TOGGLE", [str(SCRIPT_HOME / "caffeine"), "toggle"], "primary")])
        self.action_row(box, "Pomodoro", "Start or pause the status-bar focus timer.", [("START / PAUSE", [str(SCRIPT_HOME / "pomodoro"), "toggle"], "")])
        self.section(box, "Information")
        self.action_row(box, "World clock + weather", "Your family cities, local times and live weather in one compact card.", [("OPEN CLOCK", [str(SCRIPT_HOME / "clock-menu")], "")])
        self.action_row(box, "Notification history", "Review missed alerts or toggle do-not-disturb.", [("OPEN", ["swaync-client", "-t", "-sw"], "")])
        self.action_row(box, "Clipboard history", "Search and paste previous text or image clipboard items.", [("OPEN", [str(SCRIPT_HOME / "clipboard")], "")])
        self.section(box, "Session")
        self.action_row(box, "Lock screen", "Lock now with the Nocturne security console.", [("LOCK", ["hyprlock"], "")])
        return scroll

