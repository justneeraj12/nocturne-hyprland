    def shortcuts_page(self) -> Gtk.Widget:
        scroll, box = self.page("Shortcuts + habits", "You only need a small core. The rest becomes discoverable when you need it.")
        groups = [
            ("Start here", [("Super + Space", "Find any app"), ("Super + R", "Nocturne Settings"), ("Super + /", "Quick guide"), ("Super + Enter", "Terminal")]),
            ("Windows", [("Super + Q", "Close"), ("Super + M", "Minimize"), ("Super + Shift + M", "Restore minimized"), ("Super + F", "Fullscreen"), ("Super + A", "Snap a floating app"), ("Super + V", "Toggle floating")]),
            ("Move around", [("Super + H/J/K/L", "Focus tiles"), ("Super + Shift + H/J/K/L", "Move tile"), ("Super + 1…9", "Change workspace"), ("Super + Shift + 1…9", "Send window"), ("Super + S", "Show scratchpad"), ("Super + Shift + S", "Send to scratchpad")]),
            ("Useful tools", [("Super + E", "Files"), ("Super + B", "Browser"), ("Super + D", "VS Code"), ("Super + T", "Steam"), ("Super + N", "Notifications"), ("Super + Shift + V", "Clipboard"), ("Super + W", "Wallpaper"), ("Super + Esc", "Lock")]),
        ]
        for group, shortcuts in groups:
            self.section(box, group)
            for keys, meaning in shortcuts:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.add_css_class("card")
                key = Gtk.Label(label=keys, xalign=0)
                key.add_css_class("keycap")
                row.append(key)
                value = Gtk.Label(label=meaning, xalign=0, hexpand=True)
                value.add_css_class("row-title")
                row.append(value)
                box.append(row)
        self.section(box, "Workflow habits that actually help")
        for title, copy in [
            ("Keep fixed workspace roles", "A repeatable map is faster than remembering where a window went."),
