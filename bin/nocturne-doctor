#!/usr/bin/env bash
set -u

mode=human
case ${1:-} in
  '') ;;
  --json) mode=json ;;
  --summary) mode=summary ;;
  -h|--help)
    printf 'Usage: nocturne-doctor [--json|--summary]\n'
    exit 0
    ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
esac

pass=0
warn=0
fail=0
records=$(mktemp)
trap 'rm -f -- "$records"' EXIT
record() {
  jq -cn --arg status "$1" --arg message "$2" '{status:$status,message:$message}' >> "$records"
  if [[ $mode == human ]]; then
    case $1 in
      OK) printf '[ OK ] %s\n' "$2" ;;
      WARN) printf '[WARN] %s\n' "$2" ;;
      FAIL) printf '[FAIL] %s\n' "$2" ;;
    esac
  fi
}
ok() { record OK "$1"; pass=$((pass + 1)); }
warning() { record WARN "$1"; warn=$((warn + 1)); }
bad() { record FAIL "$1"; fail=$((fail + 1)); }

if [[ $mode == human ]]; then
  printf 'NOCTURNE // READ-ONLY NATIVE HEALTH CHECK\n'
  printf '%s\n\n' '────────────────────────────────────────'
fi

required=(Hyprland hyprctl hyprlock hypridle hyprpaper hyprsunset mako cliphist wl-copy nmcli bluetoothctl wpctl pactl brightnessctl powerprofilesctl fwupdmgr playerctl socat grim slurp hyprshot dolphin pcmanfm-qt qpdfview qalculate-qt convert upower)
missing=()
for program in "${required[@]}"; do
  command -v "$program" >/dev/null 2>&1 || missing+=("$program")
done
if ((${#missing[@]} == 0)); then ok 'Native desktop commands are installed'; else bad "Missing commands: ${missing[*]}"; fi

[[ -x $HOME/.local/bin/nocturne-native ]] \
  && "$HOME/.local/bin/nocturne-native" --self-test >/dev/null 2>&1 \
  && ok 'Nocturne native binary passed its self-test' \
  || bad 'Nocturne native binary is missing or failed its self-test'
if [[ $(hyprctl configerrors 2>/dev/null) == '' ]]; then ok 'Hyprland has no configuration errors'; else bad 'Hyprland reports configuration errors'; fi
provider=$(hyprctl systeminfo 2>/dev/null | sed -n 's/^configProvider: //p' | head -n1)
[[ $provider == lua ]] && ok 'Hyprland uses the Nocturne Lua provider' || bad "Unexpected config provider: ${provider:-unknown}"
pgrep -f '/nocturne-native bar($| )' >/dev/null 2>&1 && ok 'Native multi-monitor bar is running' || bad 'Native bar is not running'
pgrep -x mako >/dev/null 2>&1 && ok 'Mako notification daemon is running' || bad 'Mako is not running'
pgrep -x hypridle >/dev/null 2>&1 && ok 'Hypridle is running' || bad 'Hypridle is not running'

notification_owner=$(busctl --user --no-pager --list 2>/dev/null | awk '$1 == "org.freedesktop.Notifications" {print $2}')
[[ -n $notification_owner ]] && ok 'Notification D-Bus name has one owner' || bad 'Notification D-Bus name is unowned'
tray_owner=$(busctl --user --no-pager --list 2>/dev/null | awk '$1 == "org.kde.StatusNotifierWatcher" {print $2}')
[[ -n $tray_owner ]] && ok 'Native background-app watcher owns the tray' || bad 'StatusNotifier watcher is unowned'

if [[ -x /opt/Signal/signal-desktop ]] || flatpak info org.signal.Signal >/dev/null 2>&1; then
  secret_owner=$(busctl --user --no-pager --list 2>/dev/null | awk '$1 == "org.freedesktop.secrets" {print $2}')
  signal_exec=$(sed -n 's/^Exec=//p' "$HOME/.local/share/applications/signal-desktop.desktop" 2>/dev/null | head -n1)
  if [[ -n $secret_owner && -x $HOME/.local/bin/nocturne-signal && $signal_exec == *nocturne-signal* ]]; then
    ok 'Signal uses the preserved profile and unlocked Secret Service route'
  else
    bad 'Signal profile/keyring routing is incomplete'
  fi
fi

if systemctl --user is-active --quiet plasma-xdg-desktop-portal-kde.service \
    && systemctl --user is-active --quiet xdg-desktop-portal-hyprland.service; then
  ok 'Qt and Hyprland portal backends are active'
else
  bad 'Required portal backends are not both active'
fi
if command -v hyprland-share-picker >/dev/null 2>&1 \
    && grep -q 'class = "^(hyprland-share-picker)$"' "$HOME/.config/hypr/hyprland.lua" 2>/dev/null; then
  ok 'Meeting share chooser is compact, floating and pinned'
else
  warning 'Meeting share chooser rule or upstream picker is missing'
fi
capture_state=$($HOME/.local/bin/nocturne-native --capture-test 2>/dev/null || true)
if jq -e '(.screenSharing | type == "boolean") and (.items | type == "array")' <<<"$capture_state" >/dev/null 2>&1; then
  ok 'Capture privacy state is readable without false idle-device alerts'
else
  warning 'Capture privacy state could not be inspected'
fi
if ! systemctl --user is-active --quiet xdg-desktop-portal-gtk.service \
    && ! systemctl --user is-active --quiet xdg-desktop-portal-gnome.service; then
  ok 'Legacy GTK/GNOME portal backends are inactive'
else
  warning 'A legacy portal backend is still active'
fi

if systemctl --user is-enabled --quiet nocturne-session-health.timer 2>/dev/null \
    && systemctl --user is-active --quiet nocturne-session-health.timer; then
  ok 'Non-blocking post-login recovery check is scheduled'
else
  warning 'Post-login recovery timer is not active'
fi
[[ -x $HOME/.config/hypr/scripts/efficiency-control ]] \
  && ok 'On-demand efficiency telemetry is installed' \
  || warning 'Efficiency telemetry helper is missing'
performance_report=$($HOME/.local/bin/nocturne-benchmark --json 2>/dev/null || true)
if jq -e '.format == "nocturne-performance-report-v1" and .pass == true' <<<"$performance_report" >/dev/null 2>&1; then
  ok 'Native shell is inside its performance budget'
else
  warning 'Native shell performance budget needs attention'
fi
session_supervised=true
for supervised_unit in nocturne-session.target nocturne-bar.service nocturne-idle.service mako.service nocturne-polkit.service nocturne-clipboard-text.service nocturne-clipboard-image.service nocturne-wallpaper-cycle.service; do
  systemctl --user is-active --quiet "$supervised_unit" 2>/dev/null || session_supervised=false
done
if $session_supervised; then
  ok 'Nocturne session components are supervised'
else
  warning 'One or more supervised session components are not active'
fi
lock_style_state=$($HOME/.config/hypr/scripts/lock-style status 2>/dev/null || true)
if jq -e '.current as $current | .format == "nocturne-lock-style-v1" and (.styles|length) == 5 and ([.styles[].id]|index($current) != null)' <<<"$lock_style_state" >/dev/null 2>&1; then
  ok 'Lock screen style registry is valid'
else
  warning 'Lock screen style registry could not be validated'
fi
for control_spec in \
  'storage-control:nocturne-storage-v1:Storage Center' \
  'permission-control:nocturne-permissions-v1:Permission Center' \
  'system-guard:nocturne-guard-v1:NOC Guard' \
  'power-lab:nocturne-power-lab-v1:Power Lab' \
  'clipboard-control:nocturne-clipboard-v1:clipboard privacy'; do
  IFS=: read -r helper expected label <<< "$control_spec"
  control_state=$($HOME/.config/hypr/scripts/$helper status 2>/dev/null || true)
  if jq -e --arg expected "$expected" '.format == $expected' <<<"$control_state" >/dev/null 2>&1; then
    ok "$label state is valid"
  else
    warning "$label state could not be validated"
  fi
done
rules_state=$($HOME/.config/hypr/scripts/automation-rules status 2>/dev/null || true)
if jq -e '.format == "nocturne-rules-v1" and (.rules|type == "array")' <<<"$rules_state" >/dev/null 2>&1; then
  ok 'Bounded automation rules are valid'
else
  warning 'Automation rule state could not be validated'
fi
if ps -eo etimes=,args= | awk '$1 > 5 && $0 ~ /\/hypr\/scripts\/(storage-control|permission-control|system-guard|power-lab|automation-rules) / {found=1} END {exit !found}'; then
  warning 'An on-demand 1.1 control helper is unexpectedly persistent'
else
  ok 'Control-center helpers have zero persistent processes'
fi
if pgrep -af 'wl-paste --type text --watch .*/clipboard-control watch' >/dev/null 2>&1; then
  ok 'Sensitive clipboard filter owns text history ingestion'
else
  warning 'Sensitive clipboard filter is not watching text copies'
fi
for optional in swappy tesseract qrencode; do
  command -v "$optional" >/dev/null 2>&1 \
    && ok "Optional workflow command is installed: $optional" \
    || warning "Optional workflow command is missing: $optional"
done
desk_state=$($HOME/.config/hypr/scripts/desk status 2>/dev/null || true)
if jq -e '.format == "nocturne-desk-status-v1" and (.open|type == "number")' <<<"$desk_state" >/dev/null 2>&1; then
  ok 'NOC Desk local data is valid'
else
  warning 'NOC Desk data could not be validated'
fi
desk_file=${XDG_DATA_HOME:-"$HOME/.local/share"}/nocturne/desk.json
if [[ -e $desk_file && $(stat -c %a "$desk_file" 2>/dev/null) != 600 ]]; then
  warning 'NOC Desk data permissions are broader than 0600'
else
  ok 'NOC Desk content is private to the current user'
fi
if ps -eo etimes=,args= | awk '$1 > 5 && $0 ~ /\/hypr\/scripts\/desk (status|list|brief)/ {found=1} END {exit !found}'; then
  warning 'NOC Desk helper is unexpectedly persistent'
else
  ok 'NOC Desk has zero persistent processes'
fi
for workflow in habits vault; do
  workflow_state=$($HOME/.config/hypr/scripts/$workflow status 2>/dev/null || true)
  if jq -e --arg workflow "$workflow" '.format == ("nocturne-" + $workflow + "-status-v1")' <<<"$workflow_state" >/dev/null 2>&1; then
    ok "NOC ${workflow^} local data is valid"
  else
    warning "NOC ${workflow^} data could not be validated"
  fi
  workflow_file=${XDG_DATA_HOME:-"$HOME/.local/share"}/nocturne/$workflow.json
  if [[ -e $workflow_file && $(stat -c %a "$workflow_file" 2>/dev/null) != 600 ]]; then
    warning "NOC ${workflow^} data permissions are broader than 0600"
  else
    ok "NOC ${workflow^} content is private to the current user"
  fi
  if ps -eo etimes=,args= | awk -v workflow="$workflow" '$1 > 5 && index($0, "/hypr/scripts/" workflow " ") {found=1} END {exit !found}'; then
    warning "NOC ${workflow^} helper is unexpectedly persistent"
  else
    ok "NOC ${workflow^} has zero persistent processes"
  fi
done

for legacy in waybar swaync wofi nm-applet blueman-applet; do
  if pgrep -x "$legacy" >/dev/null 2>&1; then warning "Legacy shell process is running: $legacy"; else ok "Legacy shell process is absent: $legacy"; fi
done
for legacy_settings in gnome-control-center systemsettings; do
  if pgrep -x "$legacy_settings" >/dev/null 2>&1; then warning "Legacy settings UI is running: $legacy_settings"; else ok "Legacy settings UI is absent: $legacy_settings"; fi
done
[[ -r $HOME/.local/share/applications/org.gnome.Settings.desktop ]] \
  && grep -q '^Hidden=true' "$HOME/.local/share/applications/org.gnome.Settings.desktop" \
  && ok 'Duplicate desktop settings launchers are masked' || warning 'Duplicate settings launchers are not masked yet'

[[ $(xdg-mime query default inode/directory 2>/dev/null) == org.kde.dolphin.desktop ]] \
  && ok 'Nocturne Files is the folder handler' || warning 'Folder handler is not Nocturne Files'
if [[ -x $HOME/.local/bin/nocturne-files ]] \
    && grep -q '^PreviewSize=96$' "$HOME/.config/dolphinrc" 2>/dev/null \
    && grep -q '^PreviewsShown=true$' "$HOME/.local/share/dolphin/view_properties/global/.directory" 2>/dev/null; then
  ok 'Compact Dolphin profile and live previews are installed'
else
  warning 'Nocturne Files profile is incomplete'
fi
if systemctl --user is-enabled --quiet kde-baloo.service 2>/dev/null; then
  warning 'Baloo background indexing is enabled'
else
  ok 'Dolphin background indexing is disabled'
fi
if command -v ffmpegthumbnailer >/dev/null 2>&1; then
  ok 'Video-thumbnail helper is installed'
else
  warning 'Install ffmpegthumbnailer for video previews'
fi
video_decode=false
if command -v vainfo >/dev/null 2>&1; then
  for render_node in /dev/dri/renderD*; do
    [[ -e $render_node ]] || continue
    if vainfo --display drm --device "$render_node" 2>/dev/null | grep -q 'VAEntrypointVLD'; then
      video_decode=true
      break
    fi
  done
fi
if "$video_decode"; then
  ok 'Hardware video decode profiles are available'
else
  warning 'VA-API video decoding could not be verified'
fi
if [[ -x $HOME/.local/bin/nocturne-browser ]] \
    && grep -q 'AcceleratedVideoDecodeLinuxZeroCopyGL' "$HOME/.local/bin/nocturne-browser" 2>/dev/null; then
  ok 'Brave native-Wayland video acceleration launcher is installed'
else
  warning 'Brave video acceleration launcher is incomplete'
fi
[[ $(xdg-mime query default application/pdf 2>/dev/null) == qpdfview.desktop ]] \
  && ok 'qpdfview is the PDF handler' || warning 'PDF handler is not qpdfview'

wallpaper=$($HOME/.local/bin/nocturne-wallpaper-cycle status 2>/dev/null || true)
if jq -e '.display_active == true and (.monitors | length) > 0 and ((.mapped_monitors | sort) == (.monitors | sort))' >/dev/null 2>&1 <<<"$wallpaper"; then
  ok "Wallpaper engine covers $(jq -r '.monitors | length' <<<"$wallpaper") display(s)"
else
  warning 'Wallpaper engine does not currently cover every display'
fi
hyprpaper_count=$(pgrep -x hyprpaper 2>/dev/null | wc -l)
[[ $hyprpaper_count -eq 1 ]] \
  && ok 'Wallpaper service owns exactly one Hyprpaper process' \
  || warning "Expected one Hyprpaper process; found $hyprpaper_count"

nm_state=$(nmcli -t -f STATE general 2>/dev/null | head -n1)
[[ -n $nm_state ]] && ok "NetworkManager: $nm_state" || bad 'NetworkManager is unavailable'
bluetoothctl show >/dev/null 2>&1 && ok 'Bluetooth controller responds' || warning 'No Bluetooth controller is available'
wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && ok 'Default audio output responds' || bad 'Default audio output is unavailable'
wpctl get-volume @DEFAULT_AUDIO_SOURCE@ >/dev/null 2>&1 && ok 'Default microphone responds' || warning 'Default microphone is unavailable'
systemctl --user is-active --quiet nocturne-audio-autoswitch.service \
  && ok 'Bluetooth audio auto-routing is active' || warning 'Bluetooth audio auto-routing is inactive'
systemctl --user is-active --quiet nocturne-game-session.service \
  && ok 'Automatic gaming-session controller is active' || warning 'Automatic gaming-session controller is inactive'
systemctl --user is-active --quiet nocturne-notification-rules.timer \
  && ok 'Timed notification rules are scheduled' || warning 'Timed notification rules are not scheduled'
context_enabled=$(jq -r '.enabled // false' "$HOME/.config/nocturne/context.json" 2>/dev/null || printf false)
if [[ $context_enabled == true ]]; then
  systemctl --user is-active --quiet nocturne-context.timer \
    && ok 'Dock/power context checks are scheduled' || warning 'Context automation is enabled but its timer is inactive'
elif systemctl --user is-active --quiet nocturne-context.timer; then
  warning 'Context automation is disabled but its timer is still active'
else
  ok 'Disabled context automation has zero polling cost'
fi
if pgrep -f '/context-engine (refresh|status)' >/dev/null 2>&1; then warning 'Context helper is unexpectedly persistent'; else ok 'Context automation has zero persistent processes'; fi
brightnessctl -m >/dev/null 2>&1 && ok 'Hardware backlight responds' || warning 'No controllable backlight was found'
if command -v v4l2-ctl >/dev/null 2>&1; then
  camera_state=$($HOME/.config/hypr/scripts/camera-control status 2>/dev/null || true)
  jq -e '.available == true' >/dev/null 2>&1 <<<"$camera_state" \
    && ok 'Camera sensor controls are available' \
    || warning 'Camera controls are installed but no sensor is available'
else
  warning 'Install v4l-utils to enable Nocturne camera profiles'
fi
profile=$(powerprofilesctl get 2>/dev/null || true)
[[ -n $profile ]] && ok "Power profile: $profile" || warning 'Power profile service is unavailable'

if command -v lspci >/dev/null 2>&1 \
    && lspci -Dn 2>/dev/null | awk '$2 ~ /^030[02]:/ && $3 ~ /^10de:/' | grep -q .; then
  steam_gpu=$($HOME/.config/hypr/scripts/steam-launch --verify-gpu 2>/dev/null || true)
  if jq -e '.ok == true and .driver_ready == true and .libraries32 == true' >/dev/null 2>&1 <<<"$steam_gpu"; then
    ok "Steam offload: $(jq -r '.gpu' <<<"$steam_gpu")"
  else
    bad 'Steam cannot verify NVIDIA offload and 32-bit game libraries'
  fi
fi

if [[ -r $HOME/.config/hypr/hyprlock.conf && -x $HOME/.config/hypr/scripts/lock-screen && -r /etc/pam.d/hyprlock ]]; then
  ok 'Hyprlock and PAM authentication are wired'
else
  bad 'Hyprlock integration is incomplete'
fi
recovery=$($HOME/.local/bin/nocturne-recovery status 2>/dev/null || true)
if jq -e '.exists == true' >/dev/null 2>&1 <<<"$recovery"; then ok 'Last-known-good recovery checkpoint is ready'; else warning 'No recovery checkpoint exists yet'; fi
pgrep -x hyprpolkitagent >/dev/null 2>&1 && ok 'Hyprland password agent is running' || bad 'Hyprland password agent is not running'

if [[ -x $HOME/.local/bin/hyprshot ]] \
    && "$HOME/.local/bin/hyprshot" --help >/dev/null 2>&1; then
  ok 'Upstream Hyprshot screenshot utility responds'
else
  bad 'Hyprshot is missing or does not respond'
fi
if command -v flatpak >/dev/null 2>&1 \
    && flatpak info --user io.github.seadve.Kooha >/dev/null 2>&1; then
  ok 'Kooha screen recorder is installed'
else
  bad 'Kooha screen recorder is not installed for this user'
fi

pgrep -x easyeffects >/dev/null 2>&1 && ok 'EasyEffects is preserved and running' || warning 'EasyEffects is not running'
kdeconnect-cli --list-available >/dev/null 2>&1 && ok 'KDE Connect responds' || warning 'KDE Connect is unavailable'
if [[ -r /sys/power/mem_sleep ]] && rg -q '\[deep\]' /sys/power/mem_sleep; then ok 'Suspend uses ACPI S3 deep sleep'; else warning 'Deep sleep is not currently selected'; fi

for file in \
  "$HOME/.config/hypr/hyprland.lua" \
  "$HOME/.config/hypr/hyprlock.conf" \
  "$HOME/.config/mako/config" \
  "$HOME/.config/xdg-desktop-portal/hyprland-portals.conf" \
  "$HOME/.config/nocturne/locations.json"; do
  [[ -r $file ]] && ok "Readable config: ${file#$HOME/}" || bad "Missing config: ${file#$HOME/}"
done

if [[ $mode == json ]]; then
  jq -s --argjson passed "$pass" --argjson warnings "$warn" --argjson failed "$fail" \
    '{format:"nocturne-doctor-v1",ready:($failed == 0),summary:{passed:$passed,warnings:$warnings,failed:$failed},checks:.}' \
    "$records"
elif [[ $mode == summary ]]; then
  printf 'NOCTURNE  %d passed · %d warnings · %d failed\n' "$pass" "$warn" "$fail"
else
  printf '\n────────────────────────────────────────\n'
  printf 'RESULT  %d passed · %d warnings · %d failed\n' "$pass" "$warn" "$fail"
fi
((fail == 0))
