#!/usr/bin/env bash
set -u

pass=0
warn=0
fail=0

ok() { printf '[ OK ] %s\n' "$1"; pass=$((pass + 1)); }
warning() { printf '[WARN] %s\n' "$1"; warn=$((warn + 1)); }
bad() { printf '[FAIL] %s\n' "$1"; fail=$((fail + 1)); }

printf 'NOCTURNE // READ-ONLY HEALTH CHECK\n'
printf '%s\n\n' '────────────────────────────────'

required=(Hyprland hyprctl hyprpaper waybar swaync wofi kitty cliphist wpctl nmcli bluetoothctl brightnessctl powerprofilesctl playerctl nautilus grim slurp wl-copy wf-recorder)
missing=()
for command_name in "${required[@]}"; do
  command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done
if ((${#missing[@]} == 0)); then ok 'Required desktop commands are installed'; else bad "Missing commands: ${missing[*]}"; fi

if [[ $(hyprctl configerrors 2>/dev/null) == '' ]]; then ok 'Hyprland configuration has no parser errors'; else bad 'Hyprland reports configuration errors'; fi
pgrep -x waybar >/dev/null 2>&1 && ok 'Waybar is running' || bad 'Waybar is not running'
pgrep -x swaync >/dev/null 2>&1 && ok 'Notification center is running' || bad 'Notification center is not running'
pgrep -x hypridle >/dev/null 2>&1 && ok 'Idle and lock manager is running' || bad 'Hypridle is not running'

wallpaper=$($HOME/.local/bin/nocturne-wallpaper-cycle status 2>/dev/null || true)
if jq -e '.display_active == true and (.monitors | length) > 0 and ((.mapped_monitors | sort) == (.monitors | sort))' >/dev/null 2>&1 <<<"$wallpaper"; then
  count=$(jq -r '.monitors | length' <<<"$wallpaper")
  ok "Wallpaper engine is active on $count display(s)"
else
  bad 'Wallpaper engine is not active on detected displays'
fi
if jq -e '.count > 0' >/dev/null 2>&1 <<<"$wallpaper"; then ok 'Wallpaper collection contains readable images'; else bad 'Wallpaper collection has no readable images'; fi
if jq -e '.enabled == true and .mode == "day-cycle" and (.next_change_at | length) > 0' >/dev/null 2>&1 <<<"$wallpaper"; then
  next_phase=$(jq -r '.next_change_at' <<<"$wallpaper")
  ok "Authored wallpaper day cycle is active; next phase $next_phase"
else
  warning 'Wallpaper day cycle is paused or has no authored schedule'
fi

monitor_count=$(hyprctl -j monitors 2>/dev/null | jq 'length' 2>/dev/null || printf 0)
((monitor_count > 0)) && ok "Hyprland detects $monitor_count display(s)" || bad 'No active Hyprland display detected'

nm_state=$(nmcli -t -f STATE general 2>/dev/null | head -n1)
[[ -n $nm_state ]] && ok "NetworkManager: $nm_state" || bad 'NetworkManager is unavailable'
bluetoothctl show >/dev/null 2>&1 && ok 'Bluetooth controller is available' || warning 'No Bluetooth controller is currently available'
if ! pgrep -x nm-applet >/dev/null 2>&1; then
  ok 'Legacy NetworkManager tray icon is retired'
else
  warning 'nm-applet is still running and may duplicate the dedicated Wi-Fi control'
fi
pgrep -f '/usr/bin/blueman-applet' >/dev/null 2>&1 && ok 'Blueman pairing agent is running in the background' || warning 'Blueman pairing agent is not running'
if jq -e '.[] | select(.name == "main")
    | ((."modules-right" | index("network")) != null and (."modules-right" | index("bluetooth")) != null)' "$HOME/.config/waybar/config.jsonc" >/dev/null 2>&1; then
  ok 'Wi-Fi and compact Bluetooth controls are permanently visible'
else
  warning 'Connectivity controls may be missing from the visible bar'
fi
if jq -e '.[] | select(.name == "main")
    | ."modules-right"[-1] == "group/tray-expander"
    and ."group/tray-expander".modules == ["custom/tray-toggle", "tray"]' "$HOME/.config/waybar/config.jsonc" >/dev/null 2>&1; then
  ok 'Background apps are in the far-right tray drawer'
else
  warning 'Background app tray drawer is missing or misplaced'
fi
plugins=$(DCONF_PROFILE="$HOME/.config/dconf/hyprland-profile" gsettings get org.blueman.general plugin-list 2>/dev/null || true)
if [[ $plugins == *"!StatusIcon"* && $plugins == *"!StatusNotifierItem"* && $plugins == *"!ShowConnected"* ]] \
    && ! pgrep -f '/usr/bin/blueman-tray' >/dev/null 2>&1; then
  ok 'Duplicate Blueman status icon is fully disabled for Hyprland'
else
  warning 'Blueman may expose a duplicate tray icon'
fi
if [[ -x $HOME/.config/hypr/scripts/screenshot ]] \
    && [[ -x $HOME/.local/bin/nocturne-capture-ui ]] \
    && [[ -x $HOME/.local/bin/nocturne-freeze-frame ]] \
    && [[ -r /usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0 ]] \
    && python3 -c "import gi; gi.require_version('Gtk4LayerShell', '1.0'); from gi.repository import Gtk4LayerShell" 2>/dev/null \
    && $HOME/.config/hypr/scripts/screenshot status 2>/dev/null | jq -e 'has("text") and has("class")' >/dev/null 2>&1; then
  ok 'Native screenshot and screen-recording overlay responds'
else
  bad 'Capture panel is not responding'
fi
if [[ -r $HOME/.local/state/nocturne/lock-wallpaper ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-status ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-date ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-weather ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-world ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-media ]] \
    && [[ -x $HOME/.config/hypr/scripts/lock-notifications ]] \
    && rg -q 'path = ~/.local/state/nocturne/lock-wallpaper' "$HOME/.config/hypr/hyprlock.conf" \
    && rg -q 'lock-world' "$HOME/.config/hypr/hyprlock.conf" \
    && [[ -r /etc/pam.d/hyprlock ]]; then
  ok 'Lock screen weather, world time, media, notifications and PAM authentication are wired'
else
  bad 'Lock screen integration is incomplete'
fi
pgrep -x hyprpolkitagent >/dev/null 2>&1 \
  && ok 'Graphical administrator password agent is running' \
  || bad 'Graphical administrator password agent is not running'
wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && ok 'PipeWire default audio output responds' || bad 'Default audio output is unavailable'
wpctl get-volume @DEFAULT_AUDIO_SOURCE@ >/dev/null 2>&1 && ok 'PipeWire default microphone responds' || warning 'Default microphone is unavailable'
if systemctl --user is-active --quiet nocturne-audio-autoswitch.service \
    && [[ -x $HOME/.config/hypr/scripts/audio-route ]]; then
  ok 'Bluetooth output switching and microphone routing service is active'
else
  warning 'Automatic Bluetooth audio routing is not active'
fi
brightnessctl -m >/dev/null 2>&1 && ok 'Laptop brightness control responds' || warning 'No controllable backlight was found'
profile=$(powerprofilesctl get 2>/dev/null)
[[ -n $profile ]] && ok "Power profile service: $profile" || warning 'Power profile service is unavailable'
binds=$(hyprctl binds -j 2>/dev/null || printf '[]')
for action_key in XF86AudioMicMute XF86TouchpadToggle XF86WebCam XF86Tools; do
  jq -e --arg key "$action_key" '.[] | select(.key == $key)' <<<"$binds" >/dev/null \
    || warning "Hardware action key is not mapped: $action_key"
done
if [[ -d /sys/devices/platform/msi-ec ]]; then
  ok 'MSI embedded-controller hardware features are exposed'
else
  warning 'MSI EC rejected this firmware; keyboard-light software control is unavailable'
fi

if [[ -r /sys/power/mem_sleep ]] && rg -q '\[deep\]' /sys/power/mem_sleep; then
  ok 'Suspend policy is currently using ACPI S3 deep sleep'
else
  bad 'ACPI S3 deep sleep is not selected'
fi

if [[ -r /proc/driver/nvidia/params ]] && rg -q '^PreserveVideoMemoryAllocations: 1' /proc/driver/nvidia/params; then
  nvidia_sleep_units=(
    nvidia-suspend.service
    nvidia-resume.service
    nvidia-hibernate.service
    nvidia-suspend-then-hibernate.service
  )
  nvidia_hooks_ready=true
  for unit in "${nvidia_sleep_units[@]}"; do
    systemctl is-enabled --quiet "$unit" 2>/dev/null || nvidia_hooks_ready=false
  done
  $nvidia_hooks_ready && ok 'NVIDIA video-memory sleep hooks are enabled' || bad 'NVIDIA sleep hooks are incomplete'
fi

if pgrep -x easyeffects >/dev/null 2>&1 && pactl list short sinks 2>/dev/null | rg -q 'easyeffects_sink'; then
  ok 'EasyEffects service and PipeWire sink are active'
else
  warning 'EasyEffects processing is not active'
fi

kdeconnect-cli --list-available >/dev/null 2>&1 && ok 'KDE Connect service responds' || warning 'KDE Connect service is not responding'
fc-match 'Inter' | rg -qi 'Inter' && ok 'Inter UI font is installed' || warning 'Inter font fallback is in use'
fc-match 'MesloLGS Nerd Font Mono' | rg -qi 'Meslo' && ok 'Nerd Font icons are installed' || bad 'Meslo Nerd Font is missing'

for file in "$HOME/.config/waybar/config.jsonc" "$HOME/.config/swaync/config.json" "$HOME/.config/nocturne/locations.json"; do
  [[ -r $file ]] && ok "Readable config: ${file#$HOME/}" || bad "Missing config: ${file#$HOME/}"
done

printf '\n────────────────────────────────\n'
printf 'RESULT  %d passed · %d warnings · %d failed\n' "$pass" "$warn" "$fail"
((fail == 0))
