#!/usr/bin/env bash
set -euo pipefail

# Newly copied GNOME Shell extensions are discoverable only after a fresh login.
# This one-shot enables them once the new shell session has finished starting.
sleep 8

extensions=(
  tilingshell@ferrarodomenico.com
  pomodoro-timer@Oguzhankokulu.github.com
  date-menu-formatter@marcinjakubowski.github.com
  clipboard-history@alexsaveau.dev
  medialine@funinkina.co.in
  notification-icons@jiggak.io
  simple-weather@romanlefler.com
)

for uuid in "${extensions[@]}"; do
  gnome-extensions enable "$uuid"
done

# Avoid two extensions fighting over the same window snap gestures.
gnome-extensions disable tiling-assistant@ubuntu.com || true

launcher=${XDG_CONFIG_HOME:-"$HOME/.config"}/autostart/nocturne-first-login.desktop
rm -f -- "$launcher"

command -v notify-send >/dev/null && \
  notify-send 'Nocturne is ready' 'Desktop extensions, weather, clocks, and tiling are active.'
