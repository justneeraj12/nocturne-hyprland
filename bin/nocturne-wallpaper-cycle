#!/usr/bin/env python3
"""Hyprland-native static and rotating wallpaper controller for Nocturne."""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
import urllib.parse
import xml.etree.ElementTree as ET
from pathlib import Path

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
CONFIG = CONFIG_HOME / "nocturne/wallpaper.json"
RUNTIME_CONFIG = CONFIG_HOME / "hypr/nocturne-wallpaper.conf"
STATE = STATE_HOME / "nocturne/wallpaper-state.json"
LOG = STATE_HOME / "nocturne/hyprpaper.log"
SERVICE = "nocturne-wallpaper-cycle.service"
DEFAULT_SOURCE = "/usr/share/backgrounds/Dynamic_Wallpapers/SolidForest.xml"
DEFAULT_IMAGE = Path.home() / ".local/share/backgrounds/nocturne-grid.png"


def defaults() -> dict:
    source = DEFAULT_SOURCE if Path(DEFAULT_SOURCE).exists() else str(DEFAULT_IMAGE.parent)
    return {"enabled": False, "source": source, "interval": 900, "shuffle": False}


def read_json(path: Path, fallback: dict) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return fallback | value if isinstance(value, dict) else fallback
    except (OSError, ValueError):
        return fallback


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.replace(path)


def images_from(source: str) -> list[Path]:
    path = Path(source).expanduser()
    images: list[Path] = []
    if path.is_dir():
        for pattern in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
            images.extend(sorted(path.glob(pattern)))
    elif path.suffix.lower() == ".xml" and path.is_file():
        try:
            root = ET.parse(path).getroot()
            for node in root.iter():
                if node.tag.rsplit("}", 1)[-1] not in {"file", "from", "to"}:
                    continue
                if not node.text:
                    continue
                candidate = Path(node.text.strip()).expanduser()
                if not candidate.is_absolute():
                    candidate = path.parent / candidate
                if candidate.is_file():
                    images.append(candidate.resolve())
        except (ET.ParseError, OSError):
            pass
    elif path.is_file():
        images.append(path.resolve())

    unique: list[Path] = []
    seen: set[str] = set()
    for image in images:
        key = str(image)
        if key not in seen:
            seen.add(key)
            unique.append(image)
    return unique


def monitor_names() -> list[str]:
    try:
        result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=2, check=False)
        monitors = json.loads(result.stdout)
        return [item["name"] for item in monitors if item.get("name") and not item.get("disabled")]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def write_runtime_config(image: Path) -> list[str]:
    RUNTIME_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    temporary = RUNTIME_CONFIG.with_suffix(".tmp")
    monitors = monitor_names()
    targets = monitors or [""]
    lines = [f"preload = {image}"]
    lines.extend(f"wallpaper = {monitor},{image}" for monitor in targets)
    lines.extend(["splash = false", "ipc = on"])
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    temporary.replace(RUNTIME_CONFIG)
    return monitors


def quietly(command: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def process_running() -> bool:
    return quietly(["pgrep", "-x", "hyprpaper"]).returncode == 0


def start_hyprpaper() -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("ab") as stream:
        process = subprocess.Popen(
            ["hyprpaper", "-c", str(RUNTIME_CONFIG)],
            stdout=stream,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    time.sleep(0.45)
    if process.poll() is not None:
        raise SystemExit(f"Hyprpaper failed to start; inspect {LOG}")


def apply_image(image: Path, announce: bool = True) -> None:
    if not image.is_file():
        raise SystemExit(f"Wallpaper does not exist: {image}")
    image = image.resolve()
    monitors = write_runtime_config(image)

    running = process_running()
    ipc_ok = False
    if running:
        preload = quietly(["hyprctl", "hyprpaper", "preload", str(image)])
        wallpaper = quietly(["hyprctl", "hyprpaper", "wallpaper", f",{image}"])
        ipc_ok = preload.returncode == 0 and wallpaper.returncode == 0
        if ipc_ok:
            quietly(["hyprctl", "hyprpaper", "unload", "unused"])
    if not running or not ipc_ok:
        if running:
            quietly(["pkill", "-x", "hyprpaper"])
            for _ in range(10):
                if not process_running():
                    break
                time.sleep(0.1)
        start_hyprpaper()

    state = read_json(STATE, {})
    state["current"] = str(image)
    state["changed_at"] = int(time.time())
    state["monitors"] = monitors
    state["display_active"] = process_running()
    write_json(STATE, state)
    if announce:
        quietly(["notify-send", "-a", "Nocturne", "Wallpaper updated", image.stem])


def next_image(announce: bool = True) -> None:
    config = read_json(CONFIG, defaults())
    images = images_from(str(config.get("source", "")))
    if not images:
        raise SystemExit("No usable images found in the selected wallpaper source")
    state = read_json(STATE, {})
    current = state.get("current", "")
    try:
        index = (images.index(Path(current)) + 1) % len(images)
    except ValueError:
        index = 0
    apply_image(images[index], announce)


def set_enabled(enabled: bool, source: str | None = None, interval: str | None = None) -> None:
    config = read_json(CONFIG, defaults())
    if source:
        config["source"] = str(Path(source).expanduser())
    if interval:
        config["interval"] = max(60, int(interval))
    config["enabled"] = enabled
    write_json(CONFIG, config)
    if enabled:
        next_image()
    quietly(["systemctl", "--user", "restart", SERVICE])


def apply_source(source: str) -> None:
    images = images_from(source)
    if not images:
        raise SystemExit("No usable images found in the selected wallpaper source")
    config = read_json(CONFIG, defaults())
    config["source"] = str(Path(source).expanduser())
    config["enabled"] = False
    write_json(CONFIG, config)
    apply_image(images[0])
    quietly(["systemctl", "--user", "restart", SERVICE])


def use_gnome(interval: str | None = None) -> None:
    result = subprocess.run(
        ["gsettings", "get", "org.gnome.desktop.background", "picture-uri-dark"],
        capture_output=True,
        text=True,
        check=False,
    )
    uri = result.stdout.strip().strip("'")
    if not uri.startswith("file://"):
        raise SystemExit("GNOME's current wallpaper is not a local file")
    source = urllib.parse.unquote(urllib.parse.urlparse(uri).path)
    set_enabled(True, source, interval)


def status() -> None:
    config = read_json(CONFIG, defaults())
    state = read_json(STATE, {})
    images = images_from(str(config.get("source", "")))
    output = config | {
        "count": len(images),
        "current": state.get("current", ""),
        "service_active": quietly(["systemctl", "--user", "is-active", "--quiet", SERVICE]).returncode == 0,
        "display_active": process_running(),
        "monitors": state.get("monitors", []),
    }
    print(json.dumps(output))


def daemon() -> None:
    stopped = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    elapsed = 0
    while not stopped:
        config = read_json(CONFIG, defaults())
        interval = max(60, int(config.get("interval", 900)))
        state = read_json(STATE, {})
        current = Path(state.get("current", "")).expanduser()
        if not process_running() and current.is_file():
            try:
                apply_image(current, False)
            except SystemExit:
                pass
        if config.get("enabled") and elapsed >= interval:
            try:
                next_image(False)
                elapsed = 0
            except SystemExit:
                pass
        for _ in range(5):
            if stopped:
                return
            time.sleep(1)
        elapsed += 5


def usage() -> None:
    print("Usage: nocturne-wallpaper-cycle enable [SOURCE] [SECONDS] | disable | next | apply-source SOURCE | apply-file FILE | use-gnome [SECONDS] | status | daemon", file=sys.stderr)


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "enable":
        set_enabled(True, sys.argv[2] if len(sys.argv) > 2 else None, sys.argv[3] if len(sys.argv) > 3 else None)
    elif command == "disable":
        set_enabled(False)
    elif command == "next":
        next_image()
    elif command == "apply-source" and len(sys.argv) > 2:
        apply_source(sys.argv[2])
    elif command == "apply-file" and len(sys.argv) > 2:
        apply_image(Path(sys.argv[2]).expanduser())
    elif command == "use-gnome":
        use_gnome(sys.argv[2] if len(sys.argv) > 2 else None)
    elif command == "status":
        status()
    elif command == "daemon":
        daemon()
    else:
        usage()
        raise SystemExit(2)


if __name__ == "__main__":
    main()
