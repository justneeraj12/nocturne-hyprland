#!/usr/bin/env python3
"""Hyprland-native static and authored day-cycle wallpaper controller."""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
import urllib.parse
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta
from pathlib import Path

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
CONFIG = CONFIG_HOME / "nocturne/wallpaper.json"
RUNTIME_CONFIG = CONFIG_HOME / "hypr/nocturne-wallpaper.conf"
STATE = STATE_HOME / "nocturne/wallpaper-state.json"
LOG = STATE_HOME / "nocturne/hyprpaper.log"
SERVICE = "nocturne-wallpaper-cycle.service"
DEFAULT_SOURCE = "/usr/share/backgrounds/Dynamic_Wallpapers/SolidForest.xml"
DEFAULT_IMAGE = Path.home() / ".local/share/backgrounds/nocturne-grid.png"


def defaults() -> dict:
    source = DEFAULT_SOURCE if Path(DEFAULT_SOURCE).exists() else str(DEFAULT_IMAGE.parent)
    return {"enabled": False, "source": source, "mode": "day-cycle"}


def read_json(path: Path, fallback: dict) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return fallback | value if isinstance(value, dict) else fallback
    except (OSError, ValueError):
        return fallback


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.replace(path)


def images_from(source: str) -> list[Path]:
    path = Path(source).expanduser()
    images: list[Path] = []
    if path.is_dir():
        for pattern in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
            images.extend(sorted(path.glob(pattern)))
    elif path.suffix.lower() == ".xml" and path.is_file():
        try:
            root = ET.parse(path).getroot()
            for node in root.iter():
                if node.tag.rsplit("}", 1)[-1] not in {"file", "from", "to"}:
                    continue
                if not node.text:
                    continue
                candidate = Path(node.text.strip()).expanduser()
                if not candidate.is_absolute():
                    candidate = path.parent / candidate
                if candidate.is_file():
                    images.append(candidate.resolve())
        except (ET.ParseError, OSError):
            pass
    elif path.is_file():
        images.append(path.resolve())

    unique: list[Path] = []
    seen: set[str] = set()
    for image in images:
        key = str(image)
        if key not in seen:
            seen.add(key)
            unique.append(image)
    return unique


def _resolved_image(text: str | None, xml_path: Path) -> Path | None:
    if not text:
        return None
    image = Path(text.strip()).expanduser()
    if not image.is_absolute():
        image = xml_path.parent / image
    return image.resolve() if image.is_file() else None


def schedule_from(source: str) -> tuple[datetime, list[dict], float]:
    path = Path(source).expanduser()
    if path.suffix.lower() != ".xml" or not path.is_file():
        images = images_from(source)
        if not images:
            raise SystemExit("The selected wallpaper source has no readable images")
        now = datetime.now().astimezone()
        anchor = now.replace(hour=0, minute=0, second=0, microsecond=0)
        return anchor, [{"image": images[0], "duration": 86400.0, "kind": "static"}], 86400.0

    try:
        root = ET.parse(path).getroot()
    except (ET.ParseError, OSError) as error:
        raise SystemExit(f"Could not read dynamic wallpaper XML: {error}") from error

    now = datetime.now().astimezone()
    start = root.find("starttime")
    values = {name: int(start.findtext(name, default)) if start is not None else default for name, default in (
        ("hour", 0), ("minute", 0), ("second", 0)
    )}
    anchor = now.replace(hour=values["hour"], minute=values["minute"], second=values["second"], microsecond=0)
    phases: list[dict] = []
    for node in root:
        tag = node.tag.rsplit("}", 1)[-1]
        if tag not in {"static", "transition"}:
            continue
        try:
            duration = max(1.0, float(node.findtext("duration", "0")))
        except ValueError:
            continue
        if tag == "static":
            image = _resolved_image(node.findtext("file"), path)
            if image:
                phases.append({"image": image, "duration": duration, "kind": "static"})
        else:
            before = _resolved_image(node.findtext("from"), path)
            after = _resolved_image(node.findtext("to"), path)
            if before and after and before != after:
                # Hyprpaper cannot interpolate pixels like GNOME. Switching at
                # the transition midpoint most closely follows the authored
                # day/night phase without inventing a separate cadence.
                half = duration / 2.0
                phases.append({"image": before, "duration": half, "kind": "transition-from"})
                phases.append({"image": after, "duration": duration - half, "kind": "transition-to"})
            elif after or before:
                phases.append({"image": after or before, "duration": duration, "kind": "transition"})
    if not phases:
        raise SystemExit("The selected dynamic wallpaper contains no usable phases")

    merged: list[dict] = []
    for phase in phases:
        if merged and merged[-1]["image"] == phase["image"]:
            merged[-1]["duration"] += phase["duration"]
            merged[-1]["kind"] = f'{merged[-1]["kind"]}+{phase["kind"]}'
        else:
            merged.append(phase.copy())
    return anchor, merged, sum(float(item["duration"]) for item in merged)


def scheduled_phase(source: str, now: datetime | None = None) -> dict:
    anchor, phases, total = schedule_from(source)
    current_time = now.astimezone() if now is not None else datetime.now().astimezone()
    # Dynamic wallpaper packs are authored as repeating local-day cycles. Use
    # today's encoded start clock so daylight-saving changes cannot drift them.
    anchor = current_time.replace(hour=anchor.hour, minute=anchor.minute, second=anchor.second, microsecond=0)
    position = (current_time - anchor).total_seconds() % total
    cursor = 0.0
    for index, phase in enumerate(phases):
        end = cursor + float(phase["duration"])
        if position < end:
            seconds_until = max(1, int(end - position + 0.999))
            next_index = (index + 1) % len(phases)
            visited = 0
            while visited < len(phases) - 1 and phases[next_index]["image"] == phase["image"]:
                seconds_until += int(float(phases[next_index]["duration"]))
                next_index = (next_index + 1) % len(phases)
                visited += 1
            next_change = current_time + timedelta(seconds=seconds_until)
            return {
                "image": phase["image"],
                "kind": phase["kind"],
                "index": index,
                "phases": len(phases),
                "total": int(total),
                "seconds_until_change": seconds_until,
                "next_change_at": next_change.isoformat(timespec="seconds"),
                "anchor": anchor.isoformat(timespec="seconds"),
            }
        cursor = end
    raise SystemExit("Could not resolve the current wallpaper phase")


def monitor_names() -> list[str]:
    try:
        result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=2, check=False)
        monitors = json.loads(result.stdout)
        return [item["name"] for item in monitors if item.get("name") and not item.get("disabled")]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def write_runtime_config(image: Path) -> list[str]:
    RUNTIME_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    temporary = RUNTIME_CONFIG.with_suffix(".tmp")
    monitors = monitor_names()
    targets = monitors or [""]
    lines = ["splash = false", "ipc = on", ""]
    for monitor in targets:
        lines.extend([
            "wallpaper {",
            f"    monitor = {monitor}",
            f"    path = {image}",
            "    fit_mode = cover",
            "}",
            "",
        ])
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    temporary.replace(RUNTIME_CONFIG)
    return monitors


def quietly(command: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def process_running() -> bool:
    return quietly(["pgrep", "-x", "hyprpaper"]).returncode == 0


def wallpaper_monitors() -> list[str]:
    """Return monitors with a real Hyprpaper layer surface."""
    try:
        result = subprocess.run(["hyprctl", "-j", "layers"], capture_output=True, text=True, timeout=2, check=False)
        layers = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []

    mapped: list[str] = []
    for monitor, surface in layers.items():
        levels = surface.get("levels", {}) if isinstance(surface, dict) else {}
        entries = [entry for group in levels.values() for entry in group] if isinstance(levels, dict) else []
        if any("hyprpaper" in str(entry.get("namespace", "")).lower() for entry in entries if isinstance(entry, dict)):
            mapped.append(monitor)
    return mapped


def display_is_active(expected: list[str] | None = None) -> bool:
    targets = expected if expected is not None else monitor_names()
    mapped = set(wallpaper_monitors())
    return bool(targets) and set(targets).issubset(mapped)


def start_hyprpaper(expected: list[str]) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("ab") as stream:
        process = subprocess.Popen(
            ["hyprpaper", "-c", str(RUNTIME_CONFIG)],
            stdout=stream,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    for _ in range(25):
        if process.poll() is not None:
            raise SystemExit(f"Hyprpaper failed to start; inspect {LOG}")
        if display_is_active(expected):
            return
        time.sleep(0.2)
    raise SystemExit(f"Hyprpaper started without mapping every display; inspect {LOG}")


def apply_image(image: Path, announce: bool = True) -> None:
    if not image.is_file():
        raise SystemExit(f"Wallpaper does not exist: {image}")
    image = image.resolve()
    monitors = write_runtime_config(image)

    # Hyprpaper 0.8 uses declarative wallpaper blocks and no longer accepts
    # the legacy `hyprctl hyprpaper preload/wallpaper` requests. Phase changes
    # are infrequent, so restart it cleanly after atomically writing config.
    if process_running():
        quietly(["pkill", "-x", "hyprpaper"])
        for _ in range(20):
            if not process_running():
                break
            time.sleep(0.1)
    start_hyprpaper(monitors)

    mapped = wallpaper_monitors()
    state = read_json(STATE, {})
    state["current"] = str(image)
    state["changed_at"] = int(time.time())
    state["monitors"] = monitors
    state["mapped_monitors"] = mapped
    state["display_active"] = display_is_active(monitors)
    write_json(STATE, state)
    if announce:
        quietly(["notify-send", "-a", "Nocturne", "Wallpaper updated", image.stem])


def apply_scheduled(source: str, announce: bool = True) -> dict:
    phase = scheduled_phase(source)
    apply_image(Path(phase["image"]), announce)
    return phase


def set_enabled(enabled: bool, source: str | None = None) -> None:
    config = read_json(CONFIG, defaults())
    if source:
        config["source"] = str(Path(source).expanduser())
    config["enabled"] = enabled
    config["mode"] = "day-cycle"
    config.pop("interval", None)
    config.pop("shuffle", None)
    write_json(CONFIG, config)
    if enabled:
        apply_scheduled(str(config["source"]))
    quietly(["systemctl", "--user", "restart", SERVICE])


def apply_source(source: str) -> None:
    config = read_json(CONFIG, defaults())
    config["source"] = str(Path(source).expanduser())
    config["enabled"] = False
    config["mode"] = "day-cycle"
    config.pop("interval", None)
    config.pop("shuffle", None)
    write_json(CONFIG, config)
    apply_scheduled(source)
    quietly(["systemctl", "--user", "restart", SERVICE])


def use_gnome() -> None:
    result = subprocess.run(
        ["gsettings", "get", "org.gnome.desktop.background", "picture-uri-dark"],
        capture_output=True,
        text=True,
        check=False,
    )
    uri = result.stdout.strip().strip("'")
    if not uri.startswith("file://"):
        raise SystemExit("GNOME's current wallpaper is not a local file")
    source = urllib.parse.unquote(urllib.parse.urlparse(uri).path)
    set_enabled(True, source)


def status() -> None:
    config = read_json(CONFIG, defaults())
    state = read_json(STATE, {})
    images = images_from(str(config.get("source", "")))
    try:
        phase = scheduled_phase(str(config.get("source", "")))
        schedule = {
            "scheduled_image": str(phase["image"]),
            "phase_kind": phase["kind"],
            "next_change_at": phase["next_change_at"],
            "seconds_until_change": phase["seconds_until_change"],
            "cycle_seconds": phase["total"],
        }
    except SystemExit:
        schedule = {}
    monitors = monitor_names()
    mapped = wallpaper_monitors()
    output = config | schedule | {
        "count": len(images),
        "current": state.get("current", ""),
        "service_active": quietly(["systemctl", "--user", "is-active", "--quiet", SERVICE]).returncode == 0,
        "display_active": bool(monitors) and set(monitors).issubset(set(mapped)),
        "monitors": monitors,
        "mapped_monitors": mapped,
    }
    print(json.dumps(output))


def daemon() -> None:
    stopped = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopped:
        config = read_json(CONFIG, defaults())
        state = read_json(STATE, {})
        current = Path(state.get("current", "")).expanduser()
        scheduled: Path | None = None
        if config.get("enabled"):
            try:
                scheduled = Path(scheduled_phase(str(config.get("source", "")))["image"])
            except SystemExit:
                scheduled = None
        desired = scheduled or (current if current.is_file() else None)
        if desired and (not display_is_active() or current != desired):
            try:
                apply_image(desired, False)
            except SystemExit:
                pass
        for _ in range(5):
            if stopped:
                return
            time.sleep(1)


def usage() -> None:
    print("Usage: nocturne-wallpaper-cycle enable [SOURCE] | disable | apply-source SOURCE | apply-file FILE | use-gnome | phase SOURCE | status | daemon", file=sys.stderr)


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "enable":
        set_enabled(True, sys.argv[2] if len(sys.argv) > 2 else None)
    elif command == "disable":
        set_enabled(False)
    elif command == "apply-source" and len(sys.argv) > 2:
        apply_source(sys.argv[2])
    elif command == "apply-file" and len(sys.argv) > 2:
        apply_image(Path(sys.argv[2]).expanduser())
    elif command == "use-gnome":
        use_gnome()
    elif command == "phase" and len(sys.argv) > 2:
        phase = scheduled_phase(sys.argv[2])
        print(json.dumps({key: str(value) if isinstance(value, Path) else value for key, value in phase.items()}))
    elif command == "status":
        status()
    elif command == "daemon":
        daemon()
    else:
        usage()
        raise SystemExit(2)


if __name__ == "__main__":
    main()
