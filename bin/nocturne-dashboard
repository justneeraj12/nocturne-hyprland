#!/usr/bin/env bash
set -euo pipefail

SESSION_NAME=${NOCTURNE_SESSION_NAME:-nocturne-monitor-v2}

create_session() {
  tmux -f "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf" \
    new-session -d -s "$SESSION_NAME" -n dashboard

  tmux send-keys -t "$SESSION_NAME:dashboard.0" \
    "btop" Enter

  tmux split-window -h -p 42 -t "$SESSION_NAME:dashboard.0"
  tmux send-keys -t "$SESSION_NAME:dashboard.1" \
    "nvtop" Enter

  tmux split-window -v -p 38 -t "$SESSION_NAME:dashboard.1"
  tmux send-keys -t "$SESSION_NAME:dashboard.2" \
    "cava -p '${XDG_CONFIG_HOME:-$HOME/.config}/cava/tmux.conf'" Enter
  tmux set-option -t "$SESSION_NAME" pane-border-status top
  tmux set-option -t "$SESSION_NAME" pane-border-format \
    '#[fg=#4d5d58]─ #[fg=#6d9578,bold]#{?#{==:#{pane_index},0},PROCESS MATRIX,#{?#{==:#{pane_index},1},GPU TELEMETRY,AUDIO SPECTRUM}} #[fg=#4d5d58]────────────────'
  tmux select-pane -t "$SESSION_NAME:dashboard.0"
}

tmux has-session -t "$SESSION_NAME" 2>/dev/null || create_session

if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "$SESSION_NAME"
else
  exec kitty --class NocturneDashboard --title 'Nocturne Dashboard' \
    --override initial_window_width=190c \
    --override initial_window_height=50c \
    tmux attach-session -t "$SESSION_NAME"
fi
