#!/usr/bin/env -S LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0 python3
"""Compact Ubuntu-style screenshot/recording overlay for Nocturne."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path

import gi

# Layer-shell is a Wayland protocol. Force GTK onto Wayland even when Codex or
# an inherited compatibility environment advertises X11 first.
os.environ["GDK_BACKEND"] = "wayland"

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gtk, Gtk4LayerShell as Layer  # noqa: E402


RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
PID_FILE = RUNTIME / "nocturne-capture-ui.pid"


CSS = b"""
* {
  font-family: Inter, "MesloLGS Nerd Font Mono", sans-serif;
  font-size: 11px;
  font-weight: 600;
}
window { background: transparent; }
.capture-shell {
  background: rgba(6, 8, 9, 0.985);
  border: 1px solid #315345;
  border-bottom: 2px solid #233d33;
  padding: 7px;
}
.mode-rail, .target-rail {
  background: #090d0e;
  border: 1px solid #16241f;
  padding: 2px;
}
button {
  min-height: 34px;
  min-width: 42px;
  padding: 2px 11px;
  border: 1px solid transparent;
  border-radius: 0;
  color: #82958d;
  background: transparent;
  box-shadow: none;
}
button:hover {
  color: #e1ebe7;
  background: #111b18;
  border-color: #233b32;
}
button:checked {
  color: #e6f4ee;
  background: #13241e;
  border-color: #315345;
  border-bottom: 2px solid #55d6a9;
}
button:disabled { color: #394640; background: transparent; }
.shutter {
  min-width: 92px;
  color: #07100c;
  background: #55d6a9;
  border: 1px solid #82e7c4;
  font-weight: 800;
  letter-spacing: 0.5px;
}
.shutter:hover { color: #020504; background: #7be4c0; border-color: #b2f4dc; }
.shutter.record {
  color: #160507;
  background: #ff5f6d;
  border-color: #ff8c96;
}
.shutter.record:hover { background: #ff7a86; border-color: #ffadb4; }
.stop {
  min-width: 190px;
  color: #180507;
  background: #ff5f6d;
  border-color: #ff8c96;
  font-weight: 800;
  letter-spacing: 0.5px;
}
.close { min-width: 34px; padding: 0; color: #6e8078; }
.divider { min-width: 1px; background: #20322b; margin: 5px 3px; }
"""


class CaptureApplication(Gtk.Application):
    def __init__(self, monitor: str | None, recording: bool):
        super().__init__(application_id="com.nocturne.Capture", flags=0)
        self.monitor_name = monitor
        self.recording = recording
        self.mode = "screenshot"
        self.target = "area"
        self.window: Gtk.ApplicationWindow | None = None
        self.target_buttons: dict[str, Gtk.ToggleButton] = {}
        self.mode_buttons: dict[str, Gtk.ToggleButton] = {}
        self.annotate = False
        self.edit_button: Gtk.ToggleButton | None = None

    def do_activate(self) -> None:
        if self.window is not None:
            self.window.present()
            return

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        window = Gtk.ApplicationWindow(application=self)
        window.set_decorated(False)
        window.set_resizable(False)
        window.set_title("Nocturne Capture")
        Layer.init_for_window(window)
        Layer.set_namespace(window, "nocturne-capture")
        Layer.set_layer(window, Layer.Layer.OVERLAY)
        Layer.set_anchor(window, Layer.Edge.BOTTOM, True)
        Layer.set_margin(window, Layer.Edge.BOTTOM, 30)
        Layer.set_keyboard_mode(window, Layer.KeyboardMode.EXCLUSIVE)
        Layer.set_exclusive_zone(window, 0)
        self._place_on_monitor(window)

        if self.recording:
            root = self._recording_panel()
        else:
            root = self._capture_panel()
        root.add_css_class("capture-shell")
        window.set_child(root)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        window.add_controller(keys)
        self.window = window
        PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
        window.present()

    def _place_on_monitor(self, window: Gtk.Window) -> None:
        display = Gdk.Display.get_default()
        if not display or not self.monitor_name:
            return
        monitors = display.get_monitors()
        for index in range(monitors.get_n_items()):
            monitor = monitors.get_item(index)
            if monitor and monitor.get_connector() == self.monitor_name:
                Layer.set_monitor(window, monitor)
                return

    @staticmethod
    def _divider() -> Gtk.Box:
        divider = Gtk.Box()
        divider.add_css_class("divider")
        return divider

    @staticmethod
    def _rail() -> Gtk.Box:
        rail = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        rail.add_css_class("target-rail")
        return rail

    def _capture_panel(self) -> Gtk.Box:
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

        modes = self._rail()
        modes.remove_css_class("target-rail")
        modes.add_css_class("mode-rail")
        screenshot = Gtk.ToggleButton(label="󰄄  SHOT", tooltip_text="Screenshot mode")
        record = Gtk.ToggleButton(label="󰑊  REC", tooltip_text="Screen recording mode")
        record.set_group(screenshot)
        screenshot.set_active(True)
        screenshot.connect("toggled", self._set_mode, "screenshot")
        record.connect("toggled", self._set_mode, "record")
        self.mode_buttons = {"screenshot": screenshot, "record": record}
        modes.append(screenshot)
        modes.append(record)
        root.append(modes)
        root.append(self._divider())

        targets = self._rail()
        target_data = [
            ("area", "󰩬  AREA", "Drag to select a region"),
            ("display", "󰍹  DISPLAY", "Current display"),
            ("all", "󰹑  ALL", "All displays"),
            ("window", "󰖯  WINDOW", "Focused window"),
        ]
        first: Gtk.ToggleButton | None = None
        for target, label, tooltip in target_data:
            button = Gtk.ToggleButton(label=label, tooltip_text=tooltip)
            if first is None:
                first = button
            else:
                button.set_group(first)
            button.connect("toggled", self._set_target, target)
            targets.append(button)
            self.target_buttons[target] = button
        self.target_buttons["area"].set_active(True)
        root.append(targets)
        root.append(self._divider())

        self.edit_button = Gtk.ToggleButton(
            label="󰏫  EDIT", tooltip_text="Annotate the result in Swappy"
        )
        self.edit_button.connect("toggled", self._set_annotate)
        root.append(self.edit_button)

        self.shutter = Gtk.Button(label="CAPTURE")
        self.shutter.add_css_class("shutter")
        self.shutter.connect("clicked", self._submit)
        root.append(self.shutter)

        close = Gtk.Button(label="×", tooltip_text="Close · Esc")
        close.add_css_class("close")
        close.connect("clicked", lambda _button: self.quit())
        root.append(close)
        return root

    def _recording_panel(self) -> Gtk.Box:
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        state = Gtk.Label(label="󰑊  SCREEN RECORDING ACTIVE")
        state.set_margin_start(9)
        state.set_margin_end(8)
        root.append(state)
        stop = Gtk.Button(label="󰓛  STOP + SAVE")
        stop.add_css_class("stop")
        stop.connect("clicked", lambda _button: self._finish("stop-recording"))
        root.append(stop)
        close = Gtk.Button(label="×", tooltip_text="Close · Esc")
        close.add_css_class("close")
        close.connect("clicked", lambda _button: self.quit())
        root.append(close)
        return root

    def _set_mode(self, button: Gtk.ToggleButton, mode: str) -> None:
        if not button.get_active():
            return
        self.mode = mode
        recording = mode == "record"
        self.target_buttons["all"].set_sensitive(not recording)
        self.target_buttons["window"].set_sensitive(not recording)
        if self.edit_button is not None:
            self.edit_button.set_sensitive(not recording)
            if recording:
                self.edit_button.set_active(False)
        if recording and self.target in {"all", "window"}:
            self.target_buttons["area"].set_active(True)
        self.shutter.set_label("RECORD" if recording else "CAPTURE")
        if recording:
            self.shutter.add_css_class("record")
        else:
            self.shutter.remove_css_class("record")

    def _set_target(self, button: Gtk.ToggleButton, target: str) -> None:
        if button.get_active():
            self.target = target

    def _set_annotate(self, button: Gtk.ToggleButton) -> None:
        self.annotate = button.get_active()

    def _submit(self, _button: Gtk.Button | None = None) -> None:
        suffix = "-edit" if self.mode == "screenshot" and self.annotate else ""
        self._finish(f"{self.mode}-{self.target}{suffix}")

    def _finish(self, action: str) -> None:
        print(action, flush=True)
        self.quit()

    def _on_key(self, _controller, keyval, _keycode, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.recording:
                self._finish("stop-recording")
            else:
                self._submit()
            return True
        shortcuts = {
            Gdk.KEY_s: (self.mode_buttons, "screenshot"),
            Gdk.KEY_r: (self.mode_buttons, "record"),
            Gdk.KEY_a: (self.target_buttons, "area"),
            Gdk.KEY_d: (self.target_buttons, "display"),
            Gdk.KEY_l: (self.target_buttons, "all"),
            Gdk.KEY_w: (self.target_buttons, "window"),
        }
        if not self.recording and keyval in shortcuts:
            buttons, name = shortcuts[keyval]
            button = buttons.get(name)
            if button and button.get_sensitive():
                button.set_active(True)
            return True
        if not self.recording and keyval == Gdk.KEY_e and self.edit_button is not None:
            self.edit_button.set_active(not self.edit_button.get_active())
            return True
        return False

    def do_shutdown(self) -> None:
        try:
            if PID_FILE.read_text(encoding="utf-8").strip() == str(os.getpid()):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        Gtk.Application.do_shutdown(self)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--monitor")
    parser.add_argument("--recording", action="store_true")
    parser.add_argument("--diagnose", action="store_true")
    args = parser.parse_args()
    if args.diagnose:
        display = Gdk.Display.get_default()
        supported = bool(display and Layer.is_supported())
        print(json.dumps({"display": bool(display), "layer_shell": supported}))
        return 0 if supported else 1
    return CaptureApplication(args.monitor, args.recording).run([])


if __name__ == "__main__":
    raise SystemExit(main())
