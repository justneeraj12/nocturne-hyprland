#!/usr/bin/env python3
"""Nocturne Cyberdisc — a native GTK4/Cairo PipeWire visualizer."""

from __future__ import annotations

import math
import os
import signal
import subprocess
import sys
import threading
import time
from collections import deque
from pathlib import Path

import cairo
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402


TAU = math.tau


def rgb(hex_color: str, alpha: float = 1.0) -> tuple[float, float, float, float]:
    value = hex_color.lstrip("#")
    return (
        int(value[0:2], 16) / 255,
        int(value[2:4], 16) / 255,
        int(value[4:6], 16) / 255,
        alpha,
    )


class Cyberdisc(Gtk.Application):
    STYLES = {
        "cyberdisc", "blackice", "datafall", "ghostscope", "netrunner",
        "razorwire", "mainframe", "pulsegrid", "signaltower", "gridlock",
        "zeroday", "deeptrace", "synthcity", "kernelpanic", "voidscan",
    }

    def __init__(self, style: str = "cyberdisc") -> None:
        super().__init__(application_id="com.nocturne.Visualizer")
        self.style = style if style in self.STYLES else "cyberdisc"
        self.window: Gtk.ApplicationWindow | None = None
        self.area: Gtk.DrawingArea | None = None
        self.process: subprocess.Popen[str] | None = None
        self.lock = threading.Lock()
        self.target = [0.0] * 96
        self.spectrum = [0.0] * 96
        self.trace: deque[float] = deque([0.0] * 300, maxlen=300)
        self.spectral_history: deque[list[float]] = deque(
            ([0.0] * 96 for _ in range(84)), maxlen=84
        )
        self.angle = 0.0
        self.phase = 0.0
        self.frame = 0
        self.last_frame = time.monotonic()
        self.paused = False

    def do_activate(self) -> None:
        if self.window:
            self.window.present()
            return

        self.window = Gtk.ApplicationWindow(application=self)
        titles = {
            "cyberdisc": "Nocturne // Cyberdisc",
            "blackice": "Nocturne // Black ICE",
            "datafall": "Nocturne // Datafall",
            "ghostscope": "Nocturne // Ghostscope",
            "netrunner": "Nocturne // Netrunner",
            "razorwire": "Nocturne // Razorwire",
            "mainframe": "Nocturne // Mainframe",
            "pulsegrid": "Nocturne // Pulsegrid",
            "signaltower": "Nocturne // Signal Tower",
            "gridlock": "Nocturne // Gridlock",
            "zeroday": "Nocturne // Zero Day",
            "deeptrace": "Nocturne // Deep Trace",
            "synthcity": "Nocturne // Synth City",
            "kernelpanic": "Nocturne // Kernel Panic",
            "voidscan": "Nocturne // Void Scanner",
        }
        self.window.set_title(titles[self.style])
        self.window.set_default_size(1280, 720)
        self.window.set_decorated(False)
        self.window.connect("close-request", self.on_close)

        self.area = Gtk.DrawingArea()
        self.area.set_draw_func(self.draw)
        self.area.set_focusable(True)
        self.window.set_child(self.area)

        keyboard = Gtk.EventControllerKey()
        keyboard.connect("key-pressed", self.on_key)
        self.window.add_controller(keyboard)

        self.window.present()
        self.area.grab_focus()
        self.start_audio()
        GLib.timeout_add(16, self.animate)

    def start_audio(self) -> None:
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        config = config_home / "cava" / "cyberdisc.conf"
        try:
            self.process = subprocess.Popen(
                ["cava", "-p", str(config)],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
        except OSError:
            return
        threading.Thread(target=self.read_audio, daemon=True).start()

    def read_audio(self) -> None:
        if not self.process or not self.process.stdout:
            return
        for line in self.process.stdout:
            try:
                values = [
                    min(1.0, max(0.0, int(item) / 1000)) ** 0.62
                    for item in line.strip().split(";")
                    if item.strip()
                ]
            except ValueError:
                continue
            if values:
                with self.lock:
                    self.target = values[:96]

    def animate(self) -> bool:
        now = time.monotonic()
        dt = min(0.05, now - self.last_frame)
        self.last_frame = now
        with self.lock:
            target = self.target[:]
        if len(target) < len(self.spectrum):
            target.extend([0.0] * (len(self.spectrum) - len(target)))
        if not self.paused:
            for index, value in enumerate(target[: len(self.spectrum)]):
                attack = 0.42 if value > self.spectrum[index] else 0.12
                self.spectrum[index] += (value - self.spectrum[index]) * attack
            energy = sum(self.spectrum) / len(self.spectrum)
            bass = sum(self.spectrum[:16]) / 16
            self.angle = (self.angle + dt * (0.55 + bass * 2.8)) % TAU
            self.phase = (self.phase + dt * (7.0 + energy * 14.0)) % TAU
            mid = sum(self.spectrum[16:58]) / 42
            treble = sum(self.spectrum[58:]) / 38
            wave = (
                bass * 2.10 * math.sin(self.phase)
                + mid * 1.55 * math.sin(self.phase * 2.37 + 0.8)
                + treble * 1.15 * math.sin(self.phase * 4.91 + 1.6)
            )
            # Soft saturation keeps loud tracks vivid without flat-topped
            # clipping in the waveform chassis.
            self.trace.appendleft(math.tanh(wave * 0.52))
            self.frame += 1
            if self.frame % 3 == 0:
                self.spectral_history.appendleft(self.spectrum[:])
        if self.area:
            self.area.queue_draw()
        return GLib.SOURCE_CONTINUE

    def on_key(self, _controller, keyval, _keycode, _state) -> bool:
        if keyval in (Gdk.KEY_q, Gdk.KEY_Q, Gdk.KEY_Escape):
            if self.window:
                self.window.close()
            return True
        if keyval == Gdk.KEY_space:
            self.paused = not self.paused
            return True
        return False

    def on_close(self, _window) -> bool:
        self.stop_audio()
        return False

    def stop_audio(self) -> None:
        if self.process and self.process.poll() is None:
            self.process.send_signal(signal.SIGTERM)
        self.process = None

    @staticmethod
    def line(ctx: cairo.Context, points: list[tuple[float, float]], color: str, width: float, alpha: float = 1.0) -> None:
        if not points:
            return
        ctx.new_path()
        ctx.move_to(*points[0])
        for point in points[1:]:
            ctx.line_to(*point)
        ctx.set_source_rgba(*rgb(color, alpha))
        ctx.set_line_width(width)
        ctx.set_line_join(cairo.LINE_JOIN_MITER)
        ctx.set_line_cap(cairo.LINE_CAP_BUTT)
        ctx.stroke()

    @staticmethod
    def flat_grid(
        ctx: cairo.Context,
        width: int,
        height: int,
        background: str,
        grid: str,
        top: float = 0,
        step: int = 40,
    ) -> None:
        ctx.set_source_rgba(*rgb(background))
        ctx.paint()
        ctx.set_source_rgba(*rgb(grid, 0.12))
        ctx.set_line_width(1)
        for x in range(0, width + step, step):
            ctx.move_to(x, top)
            ctx.line_to(x, height)
            ctx.stroke()
        for y in range(int(top), height + step, step):
            ctx.move_to(0, y)
            ctx.line_to(width, y)
            ctx.stroke()

    @staticmethod
    def mono(
        ctx: cairo.Context,
        size: float,
        color: str,
        bold: bool = False,
        alpha: float = 1.0,
    ) -> None:
        ctx.select_font_face(
            "JetBrainsMono Nerd Font",
            cairo.FONT_SLANT_NORMAL,
            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL,
        )
        ctx.set_font_size(size)
        ctx.set_source_rgba(*rgb(color, alpha))

    @staticmethod
    def polygon_points(
        center_x: float,
        center_y: float,
        radius: float,
        sides: int,
        rotation: float = 0,
    ) -> list[tuple[float, float]]:
        return [
            (
                center_x + math.cos(rotation + index * TAU / sides) * radius,
                center_y + math.sin(rotation + index * TAU / sides) * radius,
            )
            for index in range(sides)
        ]

    def instrument_header(
        self,
        ctx: cairo.Context,
        width: int,
        height: int,
        title: str,
        status: str,
        accent: str,
        foreground: str = "#d7e0dc",
    ) -> tuple[float, float]:
        header = max(42.0, height * 0.075)
        pad = max(18.0, min(width, height) * 0.035)
        ctx.set_source_rgba(*rgb("#0a0e0f"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(accent))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        self.mono(ctx, max(12, height * 0.023), foreground, True)
        ctx.move_to(pad, header * 0.62)
        ctx.show_text(title)
        self.mono(ctx, max(8, height * 0.014), accent, True)
        extent = ctx.text_extents(status)
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)
        return header, pad

    @staticmethod
    def panel(
        ctx: cairo.Context,
        x: float,
        y: float,
        width: float,
        height: float,
        border: str,
        fill: str = "#090d0e",
        line_width: float = 2,
    ) -> None:
        ctx.set_source_rgba(*rgb(fill))
        ctx.rectangle(x, y, width, height)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(border))
        ctx.set_line_width(line_width)
        ctx.stroke()

    def trace_points(
        self,
        x: float,
        center_y: float,
        width: float,
        amplitude: float,
        reverse: bool = False,
    ) -> list[tuple[float, float]]:
        values = list(self.trace)
        if reverse:
            values.reverse()
        return [
            (
                x + index / max(1, len(values) - 1) * width,
                center_y - value * amplitude,
            )
            for index, value in enumerate(values)
        ]

    def draw(self, area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        renderer = {
            "cyberdisc": self.draw_cyberdisc,
            "blackice": self.draw_blackice,
            "datafall": self.draw_datafall,
            "ghostscope": self.draw_ghostscope,
            "netrunner": self.draw_netrunner,
            "razorwire": self.draw_razorwire,
            "mainframe": self.draw_mainframe,
            "pulsegrid": self.draw_pulsegrid,
            "signaltower": self.draw_signaltower,
            "gridlock": self.draw_gridlock,
            "zeroday": self.draw_zeroday,
            "deeptrace": self.draw_deeptrace,
            "synthcity": self.draw_synthcity,
            "kernelpanic": self.draw_kernelpanic,
            "voidscan": self.draw_voidscan,
        }[self.style]
        renderer(area, ctx, width, height)

    def draw_cyberdisc(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        # Flat Nocturne canvas: deliberately 2D, square, and terminal-like.
        ctx.set_source_rgba(*rgb("#07090a"))
        ctx.paint()

        compact = width < height * 1.18
        pad = max(22.0, min(width, height) * 0.045)
        header = max(42.0, height * 0.075)
        if compact:
            radius = min(width * 0.31, height * 0.245)
            disc_x, disc_y = width * 0.5, header + radius + pad * 0.35
            panel_x, panel_y = pad, disc_y + radius + pad * 0.7
            panel_w, panel_h = width - pad * 2, max(90.0, height - panel_y - pad)
        else:
            radius = min(height * 0.34, width * 0.245)
            disc_x, disc_y = max(pad + radius, width * 0.29), height * 0.53
            panel_x = max(disc_x + radius * 1.34, width * 0.545)
            panel_y = header + pad * 0.7
            panel_w, panel_h = width - panel_x - pad, height - panel_y - pad

        sage, cyan, amber, rose = "#6d9578", "#5fc3bc", "#c49a57", "#b86886"

        # Static instrument grid; no glossy perspective or bloom.
        ctx.set_line_width(1)
        for x in range(0, width + 1, 42):
            ctx.set_source_rgba(*rgb(sage, 0.055 if x % 84 else 0.09))
            ctx.move_to(x, header)
            ctx.line_to(x, height)
            ctx.stroke()
        for y in range(int(header), height + 1, 36):
            ctx.set_source_rgba(*rgb(sage, 0.055))
            ctx.move_to(0, y)
            ctx.line_to(width, y)
            ctx.stroke()

        # Header rail.
        ctx.set_source_rgba(*rgb("#0b0f10"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(sage))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        ctx.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        ctx.set_font_size(max(12, min(18, height * 0.026)))
        ctx.set_source_rgba(*rgb("#d5dfdb"))
        ctx.move_to(pad, header * 0.62)
        ctx.show_text("NOCTURNE::CYBERDISC")
        ctx.set_font_size(max(8, min(11, height * 0.017)))
        status = "[ TRACE HOLD ]" if self.paused else "[ LIVE / PIPEWIRE ]"
        extent = ctx.text_extents(status)
        ctx.set_source_rgba(*rgb(amber if self.paused else cyan))
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)

        # Flat record chassis, rotating grooves, and live spectral teeth.
        ctx.set_source_rgba(*rgb("#090d0e"))
        ctx.arc(disc_x, disc_y, radius, 0, TAU)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(sage))
        ctx.set_line_width(2)
        ctx.stroke()

        for ring in range(11, 0, -1):
            ring_radius = radius * (0.30 + ring * 0.052)
            color = sage if ring % 3 else cyan
            ctx.set_source_rgba(*rgb(color, 0.14 if ring % 3 else 0.24))
            ctx.set_line_width(1)
            ctx.arc(disc_x, disc_y, ring_radius, self.angle * (0.2 + ring / 30), self.angle * (0.2 + ring / 30) + math.pi * 1.72)
            ctx.stroke()

        bar_count = 72
        for index in range(bar_count):
            value = self.spectrum[int(index / bar_count * len(self.spectrum))]
            theta = index / bar_count * TAU - math.pi / 2
            inner = radius * 0.91
            outer = radius * (1.01 + value * 0.42)
            x1, y1 = disc_x + math.cos(theta) * inner, disc_y + math.sin(theta) * inner
            x2, y2 = disc_x + math.cos(theta) * outer, disc_y + math.sin(theta) * outer
            color = rose if index % 12 == 0 else (amber if index % 12 == 6 else cyan)
            ctx.set_source_rgba(*rgb(color, 0.72 + value * 0.28))
            ctx.set_line_width(max(1.5, radius / 110))
            ctx.move_to(x1, y1)
            ctx.line_to(x2, y2)
            ctx.stroke()

        # Rotating label, spindle and locator marks.
        ctx.save()
        ctx.translate(disc_x, disc_y)
        ctx.rotate(self.angle)
        ctx.set_source_rgba(*rgb("#111719"))
        ctx.arc(0, 0, radius * 0.29, 0, TAU)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(amber))
        ctx.set_line_width(2)
        ctx.stroke()
        for marker in range(4):
            theta = marker * math.pi / 2
            ctx.set_source_rgba(*rgb(rose if marker % 2 else cyan))
            ctx.rectangle(math.cos(theta) * radius * 0.21 - 2, math.sin(theta) * radius * 0.21 - 2, 4, 4)
            ctx.fill()
        ctx.restore()
        ctx.set_source_rgba(*rgb("#d5dfdb"))
        ctx.arc(disc_x, disc_y, max(5, radius * 0.032), 0, TAU)
        ctx.fill()

        # Square, flat graph chassis.
        ctx.rectangle(panel_x, panel_y, panel_w, panel_h)
        ctx.set_source_rgba(*rgb("#0b0f10"))
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(sage))
        ctx.set_line_width(2)
        ctx.stroke()
        for division in range(1, 8):
            gx = panel_x + panel_w * division / 8
            ctx.set_source_rgba(*rgb(sage, 0.12))
            ctx.move_to(gx, panel_y)
            ctx.line_to(gx, panel_y + panel_h)
            ctx.stroke()
        for division in range(1, 6):
            gy = panel_y + panel_h * division / 6
            ctx.set_source_rgba(*rgb(sage, 0.12))
            ctx.move_to(panel_x, gy)
            ctx.line_to(panel_x + panel_w, gy)
            ctx.stroke()

        # Pickup arm visually carries the signal off the disc and into the trace.
        pickup_theta = -0.34 + math.sin(self.angle * 0.7) * 0.035
        pickup = (disc_x + math.cos(pickup_theta) * radius * 0.72, disc_y + math.sin(pickup_theta) * radius * 0.72)
        elbow = (disc_x + radius * 1.18, disc_y - radius * 0.65)
        entry = (panel_x, panel_y + panel_h * 0.50)
        self.line(ctx, [pickup, elbow, (entry[0] - 14, entry[1]), entry], sage, 4)
        self.line(ctx, [pickup, elbow, (entry[0] - 14, entry[1]), entry], "#d5dfdb", 1)
        ctx.set_source_rgba(*rgb(rose))
        ctx.arc(*pickup, max(3, radius * 0.018), 0, TAU)
        ctx.fill()

        # Continuous oscilloscope memory: newest sample touches the pickup entry.
        trace_values = list(self.trace)
        points: list[tuple[float, float]] = []
        center_y = panel_y + panel_h * 0.50
        usable_h = panel_h * 0.33
        for index, value in enumerate(trace_values):
            x = panel_x + index / max(1, len(trace_values) - 1) * panel_w
            points.append((x, center_y - value * usable_h))
        self.line(ctx, points, rose, 2)

        # Small live spectrum trace along the lower edge adds readable frequency detail.
        spectrum_points = []
        lower_base = panel_y + panel_h * 0.88
        for index, value in enumerate(self.spectrum):
            x = panel_x + index / max(1, len(self.spectrum) - 1) * panel_w
            spectrum_points.append((x, lower_base - value * panel_h * 0.16))
        self.line(ctx, spectrum_points, amber, 1)

        ctx.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        ctx.set_font_size(max(8, min(11, height * 0.016)))
        ctx.set_source_rgba(*rgb(cyan))
        ctx.move_to(panel_x + 12, panel_y + 20)
        ctx.show_text("WAVEFORM MEMORY // FREQUENCY TRACE")
        footer = "Q / ESC  CLOSE     SPACE  HOLD TRACE"
        ctx.set_source_rgba(*rgb("#7f978d"))
        ctx.move_to(panel_x + 12, panel_y + panel_h - 12)
        ctx.show_text(footer)

    def draw_blackice(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        red, ice, white, dim = "#d85062", "#65d4d0", "#d8e4e1", "#496966"
        header = max(42.0, height * 0.075)
        pad = max(20.0, min(width, height) * 0.04)
        self.flat_grid(ctx, width, height, "#060809", "#26413f", header, 38)

        ctx.set_source_rgba(*rgb("#0d1112"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(red))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        self.mono(ctx, max(12, height * 0.023), white, True)
        ctx.move_to(pad, header * 0.62)
        ctx.show_text("BLACK_ICE // COUNTER-INTRUSION AUDIO CORE")
        self.mono(ctx, max(8, height * 0.015), red, True)
        status = "[ TRACE_LOCKED ]" if self.paused else "[ ICE_ACTIVE ]"
        extent = ctx.text_extents(status)
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)

        compact = width < height * 1.12
        if compact:
            radius = min(width * 0.31, height * 0.22)
            core_x, core_y = width * 0.5, header + radius + pad * 0.6
            panel_x, panel_y = pad, core_y + radius + pad
            panel_w, panel_h = width - pad * 2, height - panel_y - pad
        else:
            radius = min(height * 0.32, width * 0.25)
            core_x, core_y = width * 0.33, height * 0.53
            panel_x, panel_y = width * 0.61, header + pad
            panel_w, panel_h = width - panel_x - pad, height - panel_y - pad

        # Rotating hexagonal defense layers.
        for layer in range(6, 0, -1):
            layer_radius = radius * (0.25 + layer * 0.12)
            rotation = -math.pi / 2 + self.angle * (0.20 if layer % 2 else -0.12)
            points = self.polygon_points(core_x, core_y, layer_radius, 6, rotation)
            self.line(ctx, points + [points[0]], red if layer in (2, 5) else dim, 2 if layer in (2, 5) else 1, 0.84)

        # Audio spikes radiate from the protected core.
        for index in range(60):
            value = self.spectrum[int(index / 60 * len(self.spectrum))]
            theta = index / 60 * TAU - math.pi / 2
            inner = radius * 0.86
            outer = radius * (0.91 + value * 0.38)
            color = red if index % 10 in (0, 1) else ice
            self.line(
                ctx,
                [
                    (core_x + math.cos(theta) * inner, core_y + math.sin(theta) * inner),
                    (core_x + math.cos(theta) * outer, core_y + math.sin(theta) * outer),
                ],
                color,
                2,
                0.95,
            )

        inner_hex = self.polygon_points(core_x, core_y, radius * 0.22, 6, -math.pi / 2 - self.angle)
        ctx.set_source_rgba(*rgb("#101719"))
        ctx.move_to(*inner_hex[0])
        for point in inner_hex[1:]:
            ctx.line_to(*point)
        ctx.close_path()
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(ice))
        ctx.set_line_width(2)
        ctx.stroke()
        self.mono(ctx, max(8, radius * 0.07), white, True)
        label = "ICE"
        extent = ctx.text_extents(label)
        ctx.move_to(core_x - extent.width / 2, core_y + extent.height / 2)
        ctx.show_text(label)

        # Intercept trace and band threat meters.
        ctx.set_source_rgba(*rgb("#0a0f10"))
        ctx.rectangle(panel_x, panel_y, panel_w, panel_h)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(red))
        ctx.set_line_width(2)
        ctx.stroke()
        center_y = panel_y + panel_h * 0.45
        points = [
            (
                panel_x + index / (len(self.trace) - 1) * panel_w,
                center_y - value * panel_h * 0.27,
            )
            for index, value in enumerate(self.trace)
        ]
        self.line(ctx, points, ice, 2)
        self.mono(ctx, max(8, height * 0.014), red, True)
        ctx.move_to(panel_x + 10, panel_y + 18)
        ctx.show_text("INTERCEPT::WAVE_MEMORY")
        bands = (("LOW", self.spectrum[:20]), ("MID", self.spectrum[20:64]), ("HIGH", self.spectrum[64:]))
        meter_y = panel_y + panel_h * 0.79
        for index, (name, values) in enumerate(bands):
            level = sum(values) / len(values)
            x = panel_x + 10 + index * (panel_w - 20) / 3
            meter_w = (panel_w - 42) / 3
            self.mono(ctx, max(7, height * 0.012), white)
            ctx.move_to(x, meter_y - 7)
            ctx.show_text(name)
            ctx.set_source_rgba(*rgb(dim, 0.45))
            ctx.rectangle(x, meter_y, meter_w, 7)
            ctx.fill()
            ctx.set_source_rgba(*rgb(red if level > 0.48 else ice))
            ctx.rectangle(x, meter_y, meter_w * min(1.0, level * 1.55), 7)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.012), dim)
        ctx.move_to(panel_x + 10, panel_y + panel_h - 11)
        ctx.show_text("Q:TERMINATE  SPACE:LOCK_TRACE")

    def draw_datafall(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        green, bright, amber, dark = "#3f7c61", "#85d39d", "#c9a45f", "#183226"
        header = max(42.0, height * 0.075)
        pad = max(18.0, min(width, height) * 0.035)
        self.flat_grid(ctx, width, height, "#050907", "#1c392b", header, 32)
        ctx.set_source_rgba(*rgb("#09110d"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(bright))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        self.mono(ctx, max(12, height * 0.023), bright, True)
        ctx.move_to(pad, header * 0.62)
        ctx.show_text("DATAFALL::LIVE_SPECTRAL_MEMORY")
        self.mono(ctx, max(8, height * 0.014), amber)
        status = "[ BUFFER FROZEN ]" if self.paused else "[ STREAMING ]"
        extent = ctx.text_extents(status)
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)

        x0, y0 = pad, header + pad
        fall_w, fall_h = width - pad * 2, height - header - pad * 2.2
        ctx.set_source_rgba(*rgb("#070d09"))
        ctx.rectangle(x0, y0, fall_w, fall_h)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(green))
        ctx.set_line_width(2)
        ctx.stroke()

        history = list(self.spectral_history)
        band_count = 48
        cell_w = fall_w / band_count
        cell_h = fall_h / max(1, len(history))
        for row, spectrum in enumerate(history):
            y = y0 + row * cell_h
            fade = 1.0 - row / max(1, len(history)) * 0.72
            for band in range(band_count):
                value = (spectrum[band * 2] + spectrum[band * 2 + 1]) / 2
                if value < 0.055:
                    continue
                color = amber if value > 0.62 else (bright if value > 0.30 else green)
                ctx.set_source_rgba(*rgb(color, (0.22 + value * 0.78) * fade))
                inset = 1 if cell_w > 5 else 0
                ctx.rectangle(x0 + band * cell_w + inset, y, max(1, cell_w - inset * 2), max(1, cell_h - 1))
                ctx.fill()

        # Current spectrum rides along the top edge like a packet header.
        spectrum_points = []
        for index, value in enumerate(self.spectrum):
            x = x0 + index / (len(self.spectrum) - 1) * fall_w
            spectrum_points.append((x, y0 + 2 + value * fall_h * 0.14))
        self.line(ctx, spectrum_points, amber, 2)

        self.mono(ctx, max(7, height * 0.012), bright, True)
        labels = (("20HZ", x0), ("250HZ", x0 + fall_w * 0.25), ("2KHZ", x0 + fall_w * 0.5), ("8KHZ", x0 + fall_w * 0.75), ("20KHZ", x0 + fall_w - 45))
        for label, x in labels:
            ctx.move_to(x + 4, y0 + fall_h - 8)
            ctx.show_text(label)
        self.mono(ctx, max(7, height * 0.012), dark)
        ctx.move_to(x0 + 6, height - 7)
        ctx.show_text("NEWEST FRAME AT TOP // 4.2 SEC BUFFER // Q:EXIT // SPACE:HOLD")

    def draw_ghostscope(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        cyan, violet, rose, dim = "#72d8d2", "#9178b5", "#c17498", "#334d52"
        header = max(42.0, height * 0.075)
        pad = max(20.0, min(width, height) * 0.04)
        self.flat_grid(ctx, width, height, "#06080d", "#263242", header, 44)
        ctx.set_source_rgba(*rgb("#0b0d14"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(violet))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        self.mono(ctx, max(12, height * 0.023), "#d9e4e4", True)
        ctx.move_to(pad, header * 0.62)
        ctx.show_text("GHOSTSCOPE::PHASE_INTERCEPT")
        self.mono(ctx, max(8, height * 0.014), cyan)
        status = "[ PHASE HELD ]" if self.paused else "[ SIGNAL ACQUIRED ]"
        extent = ctx.text_extents(status)
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)

        x0, y0 = pad, header + pad
        scope_w, scope_h = width - pad * 2, height - header - pad * 2
        ctx.set_source_rgba(*rgb("#090b11"))
        ctx.rectangle(x0, y0, scope_w, scope_h)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(violet))
        ctx.set_line_width(2)
        ctx.stroke()
        center_x, center_y = x0 + scope_w * 0.50, y0 + scope_h * 0.51
        ctx.set_source_rgba(*rgb(dim, 0.75))
        ctx.set_line_width(1)
        ctx.move_to(center_x, y0)
        ctx.line_to(center_x, y0 + scope_h)
        ctx.stroke()
        ctx.move_to(x0, center_y)
        ctx.line_to(x0 + scope_w, center_y)
        ctx.stroke()
        for ring in range(1, 5):
            ctx.arc(center_x, center_y, min(scope_w, scope_h) * ring * 0.095, 0, TAU)
            ctx.stroke()

        bass = sum(self.spectrum[:22]) / 22
        mid = sum(self.spectrum[22:66]) / 44
        treble = sum(self.spectrum[66:]) / 30
        radius_x, radius_y = scope_w * 0.37, scope_h * 0.37
        for ghost, (color, alpha) in enumerate(((violet, 0.34), (rose, 0.56), (cyan, 0.95))):
            points = []
            for index in range(280):
                theta = index / 279 * TAU
                modulation = 0.68 + self.spectrum[index % len(self.spectrum)] * 0.30
                x = center_x + math.sin(theta * 3 + self.phase * 0.16 + ghost * 0.035) * radius_x * modulation
                y = center_y + math.sin(theta * 2 + self.phase * 0.11 + 0.8 + ghost * 0.025) * radius_y * (0.58 + bass * 0.44)
                x += math.sin(theta * 7) * treble * scope_w * 0.035
                y += math.cos(theta * 5) * mid * scope_h * 0.04
                points.append((x, y))
            self.line(ctx, points, color, 1 if ghost < 2 else 2, alpha)

        # Discrete band readouts keep the scope grounded in terminal telemetry.
        self.mono(ctx, max(7, height * 0.012), cyan, True)
        ctx.move_to(x0 + 10, y0 + 18)
        ctx.show_text("XY/PHASE  3:2  //  CHANNEL:MONITOR  //  MODE:VECTOR")
        readings = (("BASS", bass), ("MID", mid), ("TREBLE", treble))
        for index, (name, value) in enumerate(readings):
            y = y0 + 44 + index * 22
            ctx.set_source_rgba(*rgb(dim))
            ctx.rectangle(x0 + 10, y, scope_w * 0.14, 7)
            ctx.fill()
            ctx.set_source_rgba(*rgb((cyan, violet, rose)[index]))
            ctx.rectangle(x0 + 10, y, scope_w * 0.14 * min(1, value * 1.5), 7)
            ctx.fill()
            self.mono(ctx, max(7, height * 0.011), "#9fb0b1")
            ctx.move_to(x0 + 15 + scope_w * 0.14, y + 7)
            ctx.show_text(name)

    def draw_netrunner(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        green, cyan, amber, red = "#67a879", "#58c6bf", "#c8a15c", "#bd5963"
        header = max(42.0, height * 0.075)
        pad = max(18.0, min(width, height) * 0.035)
        self.flat_grid(ctx, width, height, "#050806", "#203a2a", header, 36)
        ctx.set_source_rgba(*rgb("#09100b"))
        ctx.rectangle(0, 0, width, header)
        ctx.fill()
        ctx.set_source_rgba(*rgb(green))
        ctx.rectangle(0, header - 2, width, 2)
        ctx.fill()
        self.mono(ctx, max(12, height * 0.023), "#d8e2db", True)
        ctx.move_to(pad, header * 0.62)
        ctx.show_text("NETRUNNER::PACKET_AUDIO_ANALYZER")
        self.mono(ctx, max(8, height * 0.014), cyan)
        status = "[ TRACE PAUSED ]" if self.paused else "[ UPLINK LIVE ]"
        extent = ctx.text_extents(status)
        ctx.move_to(width - pad - extent.width, header * 0.60)
        ctx.show_text(status)

        y0 = header + pad
        body_h = height - y0 - pad
        side_w = max(150.0, width * 0.235)
        main_x = pad + side_w + pad
        main_w = width - main_x - pad
        ctx.set_source_rgba(*rgb("#08100b"))
        ctx.rectangle(pad, y0, side_w, body_h)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(green))
        ctx.set_line_width(2)
        ctx.stroke()
        ctx.set_source_rgba(*rgb("#070c09"))
        ctx.rectangle(main_x, y0, main_w, body_h)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(green))
        ctx.stroke()

        # Left-side packet/band telemetry.
        self.mono(ctx, max(8, height * 0.013), amber, True)
        ctx.move_to(pad + 10, y0 + 20)
        ctx.show_text("NODE TELEMETRY")
        band_slices = (
            ("00 LOW", self.spectrum[:18]),
            ("01 BODY", self.spectrum[18:45]),
            ("02 PRES", self.spectrum[45:72]),
            ("03 AIR", self.spectrum[72:]),
        )
        for index, (name, values) in enumerate(band_slices):
            level = sum(values) / len(values)
            y = y0 + 52 + index * 46
            self.mono(ctx, max(7, height * 0.011), "#a5b7aa")
            ctx.move_to(pad + 10, y)
            ctx.show_text(f"{name}  {int(level * 100):02X}")
            ctx.set_source_rgba(*rgb("#1b3223"))
            ctx.rectangle(pad + 10, y + 10, side_w - 20, 8)
            ctx.fill()
            ctx.set_source_rgba(*rgb(red if level > 0.62 else cyan))
            ctx.rectangle(pad + 10, y + 10, (side_w - 20) * min(1, level * 1.45), 8)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.0105), green)
        packet_y = y0 + body_h - 105
        for row in range(6):
            a = int(self.spectrum[(row * 13) % 96] * 255)
            b = int(self.spectrum[(row * 13 + 7) % 96] * 255)
            ctx.move_to(pad + 10, packet_y + row * 15)
            ctx.show_text(f"{row:02X}: {a:02X} {b:02X}  ACK::{(a ^ b):02X}")

        # Main waveform and packet scan cursor.
        main_center = y0 + body_h * 0.42
        trace_points = [
            (
                main_x + index / (len(self.trace) - 1) * main_w,
                main_center - value * body_h * 0.25,
            )
            for index, value in enumerate(self.trace)
        ]
        self.line(ctx, trace_points, cyan, 2)
        cursor_x = main_x + ((self.angle / TAU) % 1.0) * main_w
        ctx.set_source_rgba(*rgb(amber, 0.72))
        ctx.set_line_width(1)
        ctx.move_to(cursor_x, y0)
        ctx.line_to(cursor_x, y0 + body_h)
        ctx.stroke()

        # Bottom frequency packet bars.
        bar_base = y0 + body_h * 0.91
        bar_zone = body_h * 0.22
        bar_w = main_w / 48
        for band in range(48):
            value = (self.spectrum[band * 2] + self.spectrum[band * 2 + 1]) / 2
            color = red if value > 0.68 else (amber if band % 8 == 0 else green)
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(main_x + band * bar_w + 1, bar_base - value * bar_zone, max(1, bar_w - 2), value * bar_zone)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.012), green, True)
        ctx.move_to(main_x + 10, y0 + 18)
        ctx.show_text("PACKET TRACE // MONITOR SINK // 96 BANDS")
        self.mono(ctx, max(7, height * 0.011), "#728b78")
        ctx.move_to(main_x + 10, y0 + body_h - 8)
        ctx.show_text("Q:DISCONNECT  SPACE:FREEZE  SOURCE:PIPEWIRE")

    def draw_razorwire(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        cyan, rose, steel = "#54c8c1", "#c15b82", "#3d5658"
        self.flat_grid(ctx, width, height, "#07080b", "#30313c", 0, 34)
        header, pad = self.instrument_header(
            ctx, width, height, "RAZORWIRE::DUAL_EDGE_SIGNAL", "[ ARMED ]", rose
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, steel, "#090b0e")
        center = y + panel_h * 0.5
        ctx.set_source_rgba(*rgb(steel))
        ctx.rectangle(x, center - 1, panel_w, 2)
        ctx.fill()

        upper = self.trace_points(x, center - panel_h * 0.13, panel_w, panel_h * 0.23)
        lower = [(px, center + panel_h * 0.13 + (center - panel_h * 0.13 - py)) for px, py in upper]
        self.line(ctx, upper, cyan, 2)
        self.line(ctx, lower, rose, 2)

        # Frequency needles cross the central rail like a moving razor fence.
        for index in range(64):
            value = self.spectrum[int(index / 64 * len(self.spectrum))]
            px = x + (index + 0.5) / 64 * panel_w
            reach = value * panel_h * 0.22
            color = rose if index % 8 == 0 else cyan
            self.line(ctx, [(px, center - reach), (px, center + reach)], color, 1)
        self.mono(ctx, max(8, height * 0.013), rose, True)
        ctx.move_to(x + 10, y + 19)
        ctx.show_text("EDGE_A // FORWARD TRACE")
        ctx.move_to(x + 10, y + panel_h - 10)
        ctx.show_text("EDGE_B // PHASE MIRROR")
        self.mono(ctx, max(7, height * 0.011), "#809396")
        footer = "96 NEEDLES  //  Q:DISARM  //  SPACE:LOCK"
        extent = ctx.text_extents(footer)
        ctx.move_to(x + panel_w - extent.width - 10, y + panel_h - 10)
        ctx.show_text(footer)

    def draw_mainframe(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        green, cyan, amber, border = "#70a77c", "#5bc4bd", "#c6a05b", "#3c5b48"
        self.flat_grid(ctx, width, height, "#060906", "#23362a", 0, 40)
        header, pad = self.instrument_header(
            ctx, width, height, "MAINFRAME::MULTI-CHANNEL CONSOLE", "[ ROOT / AUDIO ]", green
        )
        gap = max(10.0, pad * 0.45)
        top = header + pad
        usable_w, usable_h = width - pad * 2, height - top - pad
        left_w, top_h = usable_w * 0.54, usable_h * 0.56
        panels = (
            (pad, top, left_w, top_h),
            (pad + left_w + gap, top, usable_w - left_w - gap, top_h),
            (pad, top + top_h + gap, left_w, usable_h - top_h - gap),
            (pad + left_w + gap, top + top_h + gap, usable_w - left_w - gap, usable_h - top_h - gap),
        )
        for px, py, pw, ph in panels:
            self.panel(ctx, px, py, pw, ph, border, "#09100b", 1)

        # Spectrum rack.
        px, py, pw, ph = panels[0]
        bar_w = pw / 48
        for band in range(48):
            value = (self.spectrum[band * 2] + self.spectrum[band * 2 + 1]) / 2
            color = amber if band % 8 == 0 else green
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(px + band * bar_w + 1, py + ph - 8 - value * ph * 0.74, max(1, bar_w - 2), value * ph * 0.74)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.011), green, True)
        ctx.move_to(px + 8, py + 16)
        ctx.show_text("RACK_00::SPECTRUM")

        # Oscilloscope rack.
        px, py, pw, ph = panels[1]
        self.line(ctx, self.trace_points(px, py + ph * 0.52, pw, ph * 0.34), cyan, 2)
        self.mono(ctx, max(7, height * 0.011), cyan, True)
        ctx.move_to(px + 8, py + 16)
        ctx.show_text("RACK_01::WAVE_MEMORY")

        # Compressed waterfall rack.
        px, py, pw, ph = panels[2]
        history = list(self.spectral_history)[:28]
        for row, spectrum in enumerate(history):
            cell_h = ph / 28
            for band in range(24):
                value = sum(spectrum[band * 4:band * 4 + 4]) / 4
                if value < 0.08:
                    continue
                ctx.set_source_rgba(*rgb(amber if value > 0.55 else green, 0.25 + value * 0.7))
                ctx.rectangle(px + band / 24 * pw, py + row * cell_h, pw / 24 - 1, max(1, cell_h - 1))
                ctx.fill()
        self.mono(ctx, max(7, height * 0.011), amber, True)
        ctx.move_to(px + 8, py + 16)
        ctx.show_text("RACK_02::FRAME_CACHE")

        # Node load rack.
        px, py, pw, ph = panels[3]
        bands = (("LOW", self.spectrum[:20]), ("MID", self.spectrum[20:65]), ("AIR", self.spectrum[65:]))
        for index, (name, values) in enumerate(bands):
            value = sum(values) / len(values)
            yy = py + 31 + index * max(22, ph * 0.23)
            self.mono(ctx, max(7, height * 0.0105), "#9cb0a1")
            ctx.move_to(px + 8, yy)
            ctx.show_text(f"{name} {int(value * 255):02X}")
            ctx.set_source_rgba(*rgb("#1c3223"))
            ctx.rectangle(px + 58, yy - 7, max(8, pw - 68), 7)
            ctx.fill()
            ctx.set_source_rgba(*rgb((green, cyan, amber)[index]))
            ctx.rectangle(px + 58, yy - 7, max(8, pw - 68) * min(1, value * 1.5), 7)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.011), green, True)
        ctx.move_to(px + 8, py + 16)
        ctx.show_text("RACK_03::NODE_LOAD")

    def draw_pulsegrid(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        green, cyan, amber, grid = "#69a97b", "#5acbc2", "#d0a35b", "#294438"
        self.flat_grid(ctx, width, height, "#050907", grid, 0, 32)
        header, pad = self.instrument_header(
            ctx, width, height, "PULSEGRID::BIOSIGNAL AUDIO LINK", "[ HEARTBEAT SYNC ]", cyan
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, green, "#07100b")
        center = y + panel_h * 0.49

        # Expanding beat rings are flat outlines, driven by low-frequency energy.
        bass = sum(self.spectrum[:18]) / 18
        ring_center_x = x + panel_w * 0.20
        for index in range(4):
            phase = ((self.angle / TAU) + index / 4) % 1
            radius = 12 + phase * min(panel_w, panel_h) * 0.18
            ctx.set_source_rgba(*rgb(cyan, max(0.12, 0.72 - phase * 0.65) * (0.55 + bass)))
            ctx.set_line_width(2)
            ctx.arc(ring_center_x, center, radius, 0, TAU)
            ctx.stroke()

        # ECG-like trace with hard digital corners.
        values = list(self.trace)
        points = []
        for index, value in enumerate(values):
            px = x + index / (len(values) - 1) * panel_w
            stepped = round(value * 18) / 18
            points.append((px, center - stepped * panel_h * 0.29))
        self.line(ctx, points, green, 2)
        for fraction in (0.2, 0.4, 0.6, 0.8):
            px = x + panel_w * fraction
            sample = values[int((len(values) - 1) * fraction)]
            py = center - round(sample * 18) / 18 * panel_h * 0.29
            ctx.set_source_rgba(*rgb(amber))
            ctx.rectangle(px - 3, py - 3, 6, 6)
            ctx.fill()

        self.mono(ctx, max(8, height * 0.013), cyan, True)
        ctx.move_to(x + 10, y + 19)
        ctx.show_text("CH_01 // DIGITAL PULSE MEMORY")
        self.mono(ctx, max(7, height * 0.011), "#789184")
        ctx.move_to(x + 10, y + panel_h - 10)
        ctx.show_text("SAMPLE:60FPS  QUANT:18  SPACE:HOLD  Q:EXIT")

    def draw_signaltower(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        cyan, amber, rose, grid = "#5bc7c0", "#c8a05b", "#b96279", "#2a3d40"
        self.flat_grid(ctx, width, height, "#06080a", grid, 0, 36)
        header, pad = self.instrument_header(
            ctx, width, height, "SIGNAL_TOWER::VERTICAL ARRAY", "[ SCANNING ]", amber
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, cyan, "#080c0e")
        ground = y + panel_h * 0.88
        bar_w = panel_w / 72
        for band in range(72):
            value = self.spectrum[int(band / 72 * len(self.spectrum))]
            height_value = value * panel_h * 0.70
            color = rose if value > 0.68 else (amber if band % 9 == 0 else cyan)
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(x + band * bar_w + 1, ground - height_value, max(1, bar_w - 2), height_value)
            ctx.fill()
        scan_y = y + ((self.angle / TAU) % 1) * panel_h
        ctx.set_source_rgba(*rgb(amber, 0.85))
        ctx.rectangle(x, scan_y, panel_w, 2)
        ctx.fill()
        # Tower mast and frequency tick rail.
        ctx.set_source_rgba(*rgb(rose))
        ctx.rectangle(x + panel_w * 0.5 - 1, y + 24, 2, ground - y - 24)
        ctx.fill()
        for index in range(10):
            yy = y + 35 + index * (ground - y - 45) / 9
            self.line(ctx, [(x + 8, yy), (x + 24, yy)], cyan, 1)
            self.line(ctx, [(x + panel_w - 24, yy), (x + panel_w - 8, yy)], cyan, 1)
        self.mono(ctx, max(8, height * 0.013), amber, True)
        ctx.move_to(x + 10, y + 19)
        ctx.show_text("96-BAND UPLINK // RANGE 20HZ—20KHZ")
        self.mono(ctx, max(7, height * 0.011), "#7c9294")
        ctx.move_to(x + 10, y + panel_h - 9)
        ctx.show_text("AUTO-GAIN // PEAK MARKERS // Q:OFFLINE")

    def draw_gridlock(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        cyan, green, amber, rose = "#59c5be", "#649a72", "#c69e58", "#b96079"
        self.flat_grid(ctx, width, height, "#050807", "#1f3528", 0, 40)
        header, pad = self.instrument_header(
            ctx, width, height, "GRIDLOCK::SPECTRAL CELL MATRIX", "[ CELLS LIVE ]", green
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, green, "#070c09")
        cols, rows = 16, 10
        gap = max(2, min(width, height) * 0.004)
        cell_w = (panel_w - gap * (cols + 1)) / cols
        cell_h = (panel_h - gap * (rows + 1)) / rows
        history = list(self.spectral_history)
        for row in range(rows):
            spectrum = history[min(len(history) - 1, row * 5)]
            for col in range(cols):
                values = spectrum[col * 6:col * 6 + 6]
                value = sum(values) / len(values)
                color = rose if value > 0.68 else (amber if value > 0.43 else (cyan if value > 0.20 else "#183126"))
                alpha = 0.28 + value * 0.72
                ctx.set_source_rgba(*rgb(color, alpha))
                ctx.rectangle(x + gap + col * (cell_w + gap), y + gap + row * (cell_h + gap), cell_w, cell_h)
                ctx.fill()
        scan_col = int((self.angle / TAU) * cols) % cols
        ctx.set_source_rgba(*rgb(cyan))
        ctx.set_line_width(2)
        ctx.rectangle(x + gap + scan_col * (cell_w + gap), y + gap, cell_w, rows * (cell_h + gap) - gap)
        ctx.stroke()
        self.mono(ctx, max(7, height * 0.011), "#8ca494", True)
        ctx.move_to(x + 8, y + 16)
        ctx.show_text("X:FREQUENCY  Y:MEMORY  CELL:ENERGY")

    def draw_zeroday(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        red, amber, white, dark = "#d3545d", "#c89955", "#d9d7cf", "#49282b"
        self.flat_grid(ctx, width, height, "#090606", "#3a2022", 0, 38)
        header, pad = self.instrument_header(
            ctx, width, height, "ZERO_DAY::EXPLOIT TRACE", "[ CVE-00 LIVE ]", red, white
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, red, "#0d0909")

        # Broken diagonal rails and a hard red oscilloscope trace.
        for rail in range(6):
            offset = rail * panel_h * 0.13
            self.line(
                ctx,
                [(x, y + offset), (x + panel_w * 0.28, y + offset), (x + panel_w * 0.36, y + offset + panel_h * 0.08), (x + panel_w, y + offset + panel_h * 0.08)],
                dark,
                1,
            )
        center = y + panel_h * 0.47
        self.line(ctx, self.trace_points(x, center, panel_w, panel_h * 0.29), red, 2)

        # Exploit blocks use broad frequency bands as a severity map.
        for index in range(12):
            values = self.spectrum[index * 8:index * 8 + 8]
            value = sum(values) / len(values)
            block_w = panel_w / 12
            block_h = 8 + value * panel_h * 0.12
            ctx.set_source_rgba(*rgb(amber if value > 0.48 else red, 0.45 + value * 0.55))
            ctx.rectangle(x + index * block_w + 2, y + panel_h - block_h - 18, block_w - 4, block_h)
            ctx.fill()
            self.mono(ctx, max(6, height * 0.0095), white)
            ctx.move_to(x + index * block_w + 4, y + panel_h - 6)
            ctx.show_text(f"{index:02X}")
        self.mono(ctx, max(8, height * 0.013), red, True)
        ctx.move_to(x + 10, y + 19)
        ctx.show_text("UNPATCHED SIGNAL // MEMORY UNSAFE // TRACE ACTIVE")
        self.mono(ctx, max(7, height * 0.011), "#98787a")
        ctx.move_to(x + 10, y + panel_h - 24)
        ctx.show_text("Q:ABORT  SPACE:BREAKPOINT")

    def draw_deeptrace(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        cyan, green, amber, dim = "#52bdb8", "#65977a", "#c49c57", "#2c4a49"
        self.flat_grid(ctx, width, height, "#040809", "#20383a", 0, 44)
        header, pad = self.instrument_header(
            ctx, width, height, "DEEP_TRACE::SONAR INTERCEPT", "[ PASSIVE SCAN ]", cyan
        )
        compact = width < height * 1.18
        if compact:
            radius = min(width * 0.35, height * 0.25)
            center_x, center_y = width * 0.5, header + radius + pad
            trace_x, trace_y = pad, center_y + radius + pad
            trace_w, trace_h = width - pad * 2, height - trace_y - pad
        else:
            radius = min(height * 0.34, width * 0.28)
            center_x, center_y = width * 0.34, height * 0.53
            trace_x, trace_y = width * 0.64, header + pad
            trace_w, trace_h = width - trace_x - pad, height - trace_y - pad

        # Sonar scope with a single hard sweep line.
        ctx.set_source_rgba(*rgb("#071012"))
        ctx.arc(center_x, center_y, radius, 0, TAU)
        ctx.fill_preserve()
        ctx.set_source_rgba(*rgb(cyan))
        ctx.set_line_width(2)
        ctx.stroke()
        for ring in range(1, 5):
            ctx.set_source_rgba(*rgb(dim, 0.75))
            ctx.set_line_width(1)
            ctx.arc(center_x, center_y, radius * ring / 5, 0, TAU)
            ctx.stroke()
        sweep = self.angle * 1.7
        self.line(
            ctx,
            [(center_x, center_y), (center_x + math.cos(sweep) * radius, center_y + math.sin(sweep) * radius)],
            amber,
            2,
        )
        # Frequency bins become sonar contacts.
        for index in range(0, 96, 3):
            value = self.spectrum[index]
            if value < 0.16:
                continue
            theta = index / 96 * TAU + self.angle * 0.08
            contact_r = radius * (0.22 + (index % 21) / 28)
            px = center_x + math.cos(theta) * contact_r
            py = center_y + math.sin(theta) * contact_r
            size = 2 + value * 5
            ctx.set_source_rgba(*rgb(amber if value > 0.55 else green))
            ctx.rectangle(px - size / 2, py - size / 2, size, size)
            ctx.fill()

        self.panel(ctx, trace_x, trace_y, trace_w, trace_h, dim, "#071012", 1)
        self.line(ctx, self.trace_points(trace_x, trace_y + trace_h * 0.5, trace_w, trace_h * 0.31), cyan, 2)
        self.mono(ctx, max(7, height * 0.011), green, True)
        ctx.move_to(trace_x + 8, trace_y + 16)
        ctx.show_text("RETURN ECHO // DEPTH UNKNOWN")
        self.mono(ctx, max(7, height * 0.0105), "#6f8c8a")
        ctx.move_to(trace_x + 8, trace_y + trace_h - 9)
        ctx.show_text("Q:SURFACE  SPACE:HOLD")

    def draw_synthcity(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        magenta, cyan, amber, violet = "#bd5f91", "#58c5c1", "#d1a15a", "#675681"
        self.flat_grid(ctx, width, height, "#08070b", "#332b45", 0, 42)
        header, pad = self.instrument_header(
            ctx, width, height, "SYNTH_CITY::NIGHT SIGNAL", "[ 02:17 / UPLINK ]", magenta
        )
        x, y = pad, header + pad
        panel_w, panel_h = width - pad * 2, height - header - pad * 2
        self.panel(ctx, x, y, panel_w, panel_h, violet, "#0b0910")
        horizon = y + panel_h * 0.66

        # Flat striped signal sun.
        sun_x, sun_y = x + panel_w * 0.74, y + panel_h * 0.34
        sun_r = min(panel_w, panel_h) * 0.20
        ctx.save()
        ctx.arc(sun_x, sun_y, sun_r, 0, TAU)
        ctx.clip()
        for stripe in range(11):
            yy = sun_y - sun_r + stripe * sun_r * 2 / 11
            color = amber if stripe < 6 else magenta
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(sun_x - sun_r, yy, sun_r * 2, max(2, sun_r / 14))
            ctx.fill()
        ctx.restore()
        ctx.set_source_rgba(*rgb(magenta))
        ctx.set_line_width(2)
        ctx.arc(sun_x, sun_y, sun_r, 0, TAU)
        ctx.stroke()

        # Spectrum skyline on the horizon.
        bar_w = panel_w / 64
        for band in range(64):
            value = self.spectrum[int(band / 64 * 96)]
            building = panel_h * (0.04 + value * 0.32)
            color = cyan if band % 7 else magenta
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(x + band * bar_w + 1, horizon - building, max(1, bar_w - 2), building)
            ctx.fill()
        self.line(ctx, [(x, horizon), (x + panel_w, horizon)], amber, 2)
        self.line(ctx, self.trace_points(x, horizon + panel_h * 0.13, panel_w, panel_h * 0.10), magenta, 2)
        self.mono(ctx, max(8, height * 0.013), cyan, True)
        ctx.move_to(x + 10, y + 19)
        ctx.show_text("NIGHT DRIVE // 96 TOWERS // LIVE WAVE")
        self.mono(ctx, max(7, height * 0.0105), "#8e7fa2")
        ctx.move_to(x + 10, y + panel_h - 9)
        ctx.show_text("Q:EXIT_CITY  SPACE:FREEZE_FRAME")

    def draw_kernelpanic(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        red, amber, cyan, white, gray = "#d3545d", "#c99b55", "#59bdb6", "#d8dbd7", "#453638"
        self.flat_grid(ctx, width, height, "#080606", "#352426", 0, 38)
        header, pad = self.instrument_header(
            ctx, width, height, "KERNEL_PANIC::HYBRID AUDIO CORE", "[ FAULT / LIVE ]", red, white
        )
        gap = max(10.0, pad * 0.55)
        body_x, body_y = pad, header + pad
        body_w, body_h = width - pad * 2, height - header - pad * 2
        left_w = body_w * 0.67
        core_x = body_x + left_w + gap
        core_w = body_w - left_w - gap
        wave_h = body_h * 0.63
        spectrum_y = body_y + wave_h + gap
        spectrum_h = body_h - wave_h - gap

        # One dominant waveform: large enough to make every transient obvious.
        self.panel(ctx, body_x, body_y, left_w, wave_h, red, "#0d0909")
        wave_center = body_y + wave_h * 0.53
        for division in range(1, 4):
            yy = body_y + wave_h * division / 4
            self.line(ctx, [(body_x, yy), (body_x + left_w, yy)], gray, 1, 0.50)
        for division in range(1, 8):
            xx = body_x + left_w * division / 8
            self.line(ctx, [(xx, body_y), (xx, body_y + wave_h)], gray, 1, 0.38)
        waveform = self.trace_points(body_x, wave_center, left_w, wave_h * 0.40)
        self.line(ctx, waveform, red, 3)
        if waveform:
            ctx.set_source_rgba(*rgb(white))
            ctx.rectangle(waveform[0][0] - 3, waveform[0][1] - 3, 6, 6)
            ctx.fill()
        playhead_x = body_x + ((self.angle / TAU) % 1.0) * left_w
        ctx.set_source_rgba(*rgb(amber, 0.80))
        ctx.rectangle(playhead_x, body_y, 2, wave_h)
        ctx.fill()
        self.mono(ctx, max(8, height * 0.0125), white, True)
        ctx.move_to(body_x + 9, body_y + 18)
        ctx.show_text("PANIC WAVE // LIVE MEMORY")
        trace_values = list(self.trace)
        rms = math.sqrt(sum(value * value for value in trace_values) / len(trace_values))
        peak = max(abs(value) for value in trace_values)
        telemetry = f"RMS {int(rms * 99):02d}  PEAK {int(peak * 99):02d}"
        self.mono(ctx, max(7, height * 0.0105), amber)
        extent = ctx.text_extents(telemetry)
        ctx.move_to(body_x + left_w - extent.width - 9, body_y + 17)
        ctx.show_text(telemetry)

        # Current 48-band spectrum rack below the waveform.
        self.panel(ctx, body_x, spectrum_y, left_w, spectrum_h, gray, "#0b0909", 1)
        bar_w = left_w / 48
        band_values = [
            (self.spectrum[band * 2] + self.spectrum[band * 2 + 1]) / 2
            for band in range(48)
        ]
        for band, value in enumerate(band_values):
            color = white if value > 0.76 else (amber if value > 0.47 or band % 8 == 0 else red)
            bar_h = max(2, value * spectrum_h * 0.77)
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(body_x + band * bar_w + 1, spectrum_y + spectrum_h - bar_h - 4, max(1, bar_w - 2), bar_h)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.0105), amber, True)
        ctx.move_to(body_x + 8, spectrum_y + 15)
        ctx.show_text("FAULT SPECTRUM // 48 BANDS")
        peak_band = max(range(48), key=band_values.__getitem__)
        marker_x = body_x + (peak_band + 0.5) * bar_w
        ctx.set_source_rgba(*rgb(cyan))
        ctx.rectangle(marker_x - 2, spectrum_y + 4, 4, 4)
        ctx.fill()

        # Radial core combines the same frequencies into a compact rotating view.
        self.panel(ctx, core_x, body_y, core_w, body_h, red, "#0b0808")
        dial_x = core_x + core_w * 0.50
        dial_y = body_y + body_h * 0.37
        radius = min(core_w * 0.44, body_h * 0.31)
        for ring in (0.34, 0.60, 0.84):
            ctx.set_source_rgba(*rgb(gray, 0.82))
            ctx.set_line_width(1)
            ctx.arc(dial_x, dial_y, radius * ring, 0, TAU)
            ctx.stroke()
        for band, value in enumerate(band_values):
            theta = band / 48 * TAU - math.pi / 2
            inner = radius * 0.72
            outer = radius * (0.78 + value * 0.40)
            color = amber if band % 6 == 0 else (white if value > 0.72 else red)
            self.line(
                ctx,
                [
                    (dial_x + math.cos(theta) * inner, dial_y + math.sin(theta) * inner),
                    (dial_x + math.cos(theta) * outer, dial_y + math.sin(theta) * outer),
                ],
                color,
                2,
            )
        # Two sparse rotating rails give the core more mechanical detail.
        for offset, color, direction in ((0.0, amber, 1), (math.pi, cyan, -1)):
            start = offset + self.angle * direction * 0.55
            ctx.set_source_rgba(*rgb(color))
            ctx.set_line_width(2)
            ctx.arc(dial_x, dial_y, radius * 1.05, start, start + math.pi * 0.42)
            ctx.stroke()
        for theta in (0, math.pi / 2, math.pi, math.pi * 1.5):
            self.line(
                ctx,
                [
                    (dial_x + math.cos(theta) * radius * 1.08, dial_y + math.sin(theta) * radius * 1.08),
                    (dial_x + math.cos(theta) * radius * 1.14, dial_y + math.sin(theta) * radius * 1.14),
                ],
                white,
                1,
            )
        scan = -math.pi / 2 + self.angle * 1.8
        self.line(
            ctx,
            [(dial_x, dial_y), (dial_x + math.cos(scan) * radius * 0.92, dial_y + math.sin(scan) * radius * 0.92)],
            cyan,
            2,
        )
        bass = sum(self.spectrum[:20]) / 20
        ctx.set_source_rgba(*rgb(red))
        core_size = 8 + bass * 17
        ctx.rectangle(dial_x - core_size / 2, dial_y - core_size / 2, core_size, core_size)
        ctx.fill()

        energy = sum(self.spectrum) / len(self.spectrum)
        self.mono(ctx, max(8, height * 0.012), white, True)
        readout_y = body_y + body_h * 0.70
        ctx.move_to(core_x + 10, readout_y)
        ctx.show_text(f"LOAD  {int(energy * 100):02d}%")
        ctx.set_source_rgba(*rgb(gray))
        ctx.rectangle(core_x + 10, readout_y + 10, core_w - 20, 8)
        ctx.fill()
        ctx.set_source_rgba(*rgb(red))
        ctx.rectangle(core_x + 10, readout_y + 10, (core_w - 20) * min(1, energy * 1.8), 8)
        ctx.fill()
        bands = (
            ("LOW", bass, red),
            ("MID", sum(self.spectrum[20:65]) / 45, amber),
            ("AIR", sum(self.spectrum[65:]) / 31, cyan),
        )
        meter_y = readout_y + 35
        meter_x = core_x + 42
        meter_w = core_w - 52
        for index, (name, level, color) in enumerate(bands):
            yy = meter_y + index * 18
            self.mono(ctx, max(7, height * 0.010), white, True)
            ctx.move_to(core_x + 10, yy + 6)
            ctx.show_text(name)
            ctx.set_source_rgba(*rgb(gray))
            ctx.rectangle(meter_x, yy, meter_w, 6)
            ctx.fill()
            ctx.set_source_rgba(*rgb(color))
            ctx.rectangle(meter_x, yy, meter_w * min(1, level * 1.55), 6)
            ctx.fill()
        self.mono(ctx, max(7, height * 0.0105), "#957a7c")
        ctx.move_to(core_x + 10, body_y + body_h - 10)
        ctx.show_text("SPACE:HOLD  Q:ABORT")

    def draw_voidscan(self, _area: Gtk.DrawingArea, ctx: cairo.Context, width: int, height: int) -> None:
        white, cyan, amber, dim = "#cbd8d4", "#58bdb8", "#bf9654", "#304543"
        self.flat_grid(ctx, width, height, "#030506", "#172322", 0, 52)
        header, pad = self.instrument_header(
            ctx, width, height, "VOID_SCAN::MINIMAL ARRAY", "[ LISTENING ]", cyan
        )
        center_x, center_y = width * 0.5, header + (height - header) * 0.50
        radius = min(width * 0.31, (height - header) * 0.36)
        # Sparse rotating arcs and cardinal rails.
        for ring in range(1, 6):
            ring_radius = radius * ring / 6
            start = self.angle * (0.18 if ring % 2 else -0.12) + ring * 0.4
            ctx.set_source_rgba(*rgb(cyan if ring in (2, 5) else dim, 0.9))
            ctx.set_line_width(2 if ring in (2, 5) else 1)
            ctx.arc(center_x, center_y, ring_radius, start, start + math.pi * (0.9 + ring * 0.12))
            ctx.stroke()
        self.line(ctx, [(center_x - radius, center_y), (center_x + radius, center_y)], dim, 1)
        self.line(ctx, [(center_x, center_y - radius), (center_x, center_y + radius)], dim, 1)

        # Only strong bins appear as isolated contacts around the void.
        for index in range(0, 96, 2):
            value = self.spectrum[index]
            if value < 0.24:
                continue
            theta = index / 96 * TAU - math.pi / 2
            inner = radius * 0.72
            outer = inner + value * radius * 0.32
            color = amber if value > 0.62 else cyan
            self.line(
                ctx,
                [
                    (center_x + math.cos(theta) * inner, center_y + math.sin(theta) * inner),
                    (center_x + math.cos(theta) * outer, center_y + math.sin(theta) * outer),
                ],
                color,
                2,
            )
        ctx.set_source_rgba(*rgb(white))
        ctx.rectangle(center_x - 3, center_y - 3, 6, 6)
        ctx.fill()
        self.mono(ctx, max(8, height * 0.013), white, True)
        ctx.move_to(pad, header + pad + 12)
        ctx.show_text("NOISE FLOOR / CONTACTS ONLY")
        self.mono(ctx, max(7, height * 0.0105), dim)
        ctx.move_to(pad, height - pad)
        ctx.show_text("Q:CLOSE  SPACE:HOLD  THRESHOLD:24%")

    def do_shutdown(self) -> None:
        self.stop_audio()
        super().do_shutdown()


if __name__ == "__main__":
    selected_style = sys.argv[1].lower() if len(sys.argv) > 1 else "cyberdisc"
    raise SystemExit(Cyberdisc(selected_style).run([sys.argv[0]]))
