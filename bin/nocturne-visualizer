#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/nocturne
state_file=$state_home/visualizer-theme
mkdir -p "$state_home"

if [[ ${1:-} == choose ]]; then
  choice=$(printf '%s\n' \
    '󰐾  Cyberdisc · flat terminal frequency deck' \
    '󰯂  Black ICE · angular intrusion core' \
    '󰇚  Datafall · spectral memory waterfall' \
    '󱎖  Ghostscope · phase intercept vectors' \
    '󰌘  Netrunner · packet-grid analyzer' \
    '󰎈  Obsidian · muted green spectrum' \
    '󰘨  Matrix · terminal green signal' \
    '󰈸  Amber · warm retro analyzer' \
    '󰖩  Ice · cyan-blue telemetry' \
    '󰜎  Wave · purple flowing signal' | \
    "$HOME/.config/hypr/scripts/quick-menu" VISUALIZER auto 410 390) || exit 0
  case "$choice" in
    *Cyberdisc*) theme=cyberdisc ;;
    *'Black ICE'*) theme=blackice ;;
    *Datafall*) theme=datafall ;;
    *Ghostscope*) theme=ghostscope ;;
    *Netrunner*) theme=netrunner ;;
    *Obsidian*) theme=obsidian ;;
    *Matrix*) theme=matrix ;;
    *Amber*) theme=amber ;;
    *Ice*) theme=ice ;;
    *Wave*) theme=wave ;;
    *) exit 0 ;;
  esac
else
  theme=${1:-}
  [[ -n $theme ]] || theme=$(cat "$state_file" 2>/dev/null || printf 'cyberdisc')
fi

case "$theme" in
  cyberdisc|blackice|datafall|ghostscope|netrunner|obsidian|matrix|amber|ice|wave) ;;
  *) theme=cyberdisc ;;
esac
printf '%s\n' "$theme" > "$state_file"
visualizer_config="$config_home/cava/themes/$theme.conf"

if command -v hyprctl >/dev/null; then
  address=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class == "NocturneVisualizer" or .class == "com.nocturne.Visualizer") | .address' | head -n 1)
  if [[ -n $address ]]; then
    if [[ ${1:-} == choose || -n ${1:-} ]]; then
      hyprctl dispatch closewindow "address:$address" >/dev/null
      sleep 0.2
    else
      hyprctl dispatch focuswindow "address:$address" >/dev/null
      exit 0
    fi
  fi
fi

case "$theme" in
  cyberdisc|blackice|datafall|ghostscope|netrunner)
    exec "$HOME/.local/bin/nocturne-cyberdisc" "$theme"
    ;;
esac

if [[ "${TERM:-}" == xterm-kitty ]]; then
  exec cava -p "$visualizer_config"
fi
exec kitty --class NocturneVisualizer --title 'Nocturne Visualizer' \
  cava -p "$visualizer_config"
