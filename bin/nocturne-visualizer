#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/nocturne
state_file=$state_home/visualizer-theme
mkdir -p "$state_home"

if [[ ${1:-} == choose ]]; then
  choice=$(printf '%s\n' \
    '󰐾  Cyberdisc · flat terminal frequency deck' \
    '󰯂  Black ICE · angular intrusion core' \
    '󰇚  Datafall · spectral memory waterfall' \
    '󱎖  Ghostscope · phase intercept vectors' \
    '󰌘  Netrunner · packet-grid analyzer' \
    '󱇪  Razorwire · mirrored dual-edge trace' \
    '󰢮  Mainframe · four-rack analyzer console' \
    '󱐋  Pulsegrid · digital biosignal monitor' \
    '󰞇  Signal Tower · vertical scanner array' \
    '󰘨  Gridlock · spectral memory cells' \
    '󰒓  Zero Day · exploit stack trace' \
    '󰛳  Deep Trace · passive sonar intercept' \
    '󰖨  Synth City · night-drive signal skyline' \
    '󰚌  Kernel Panic · multi-core fault traces' \
    '󰈈  Void Scanner · sparse contact array' \
    '󰁔  Classic Cava designs…' | \
    "$HOME/.config/hypr/scripts/quick-menu" VISUALIZER auto 430 610) || exit 0
  case "$choice" in
    *Cyberdisc*) theme=cyberdisc ;;
    *'Black ICE'*) theme=blackice ;;
    *Datafall*) theme=datafall ;;
    *Ghostscope*) theme=ghostscope ;;
    *Netrunner*) theme=netrunner ;;
    *Razorwire*) theme=razorwire ;;
    *Mainframe*) theme=mainframe ;;
    *Pulsegrid*) theme=pulsegrid ;;
    *'Signal Tower'*) theme=signaltower ;;
    *Gridlock*) theme=gridlock ;;
    *'Zero Day'*) theme=zeroday ;;
    *'Deep Trace'*) theme=deeptrace ;;
    *'Synth City'*) theme=synthcity ;;
    *'Kernel Panic'*) theme=kernelpanic ;;
    *'Void Scanner'*) theme=voidscan ;;
    *'Classic Cava'*)
      classic=$(printf '%s\n' \
        '󰎈  Obsidian · muted green spectrum' \
        '󰘨  Matrix · terminal green signal' \
        '󰈸  Amber · warm retro analyzer' \
        '󰖩  Ice · cyan-blue telemetry' \
        '󰜎  Wave · purple flowing signal' | \
        "$HOME/.config/hypr/scripts/quick-menu" 'CAVA CLASSICS' auto 400 230) || exit 0
      case "$classic" in
        *Obsidian*) theme=obsidian ;;
        *Matrix*) theme=matrix ;;
        *Amber*) theme=amber ;;
        *Ice*) theme=ice ;;
        *Wave*) theme=wave ;;
        *) exit 0 ;;
      esac
      ;;
    *) exit 0 ;;
  esac
else
  theme=${1:-}
  [[ -n $theme ]] || theme=$(cat "$state_file" 2>/dev/null || printf 'cyberdisc')
fi

case "$theme" in
  cyberdisc|blackice|datafall|ghostscope|netrunner|razorwire|mainframe|pulsegrid|signaltower|gridlock|zeroday|deeptrace|synthcity|kernelpanic|voidscan|obsidian|matrix|amber|ice|wave) ;;
  *) theme=cyberdisc ;;
esac
printf '%s\n' "$theme" > "$state_file"
visualizer_config="$config_home/cava/themes/$theme.conf"

if command -v hyprctl >/dev/null; then
  address=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class == "NocturneVisualizer" or .class == "com.nocturne.Visualizer") | .address' | head -n 1)
  if [[ -n $address ]]; then
    if [[ ${1:-} == choose || -n ${1:-} ]]; then
      hyprctl dispatch closewindow "address:$address" >/dev/null
      sleep 0.2
    else
      hyprctl dispatch focuswindow "address:$address" >/dev/null
      exit 0
    fi
  fi
fi

case "$theme" in
  cyberdisc|blackice|datafall|ghostscope|netrunner|razorwire|mainframe|pulsegrid|signaltower|gridlock|zeroday|deeptrace|synthcity|kernelpanic|voidscan)
    exec "$HOME/.local/bin/nocturne-cyberdisc" "$theme"
    ;;
esac

if [[ "${TERM:-}" == xterm-kitty ]]; then
  exec cava -p "$visualizer_config"
fi
exec kitty --class NocturneVisualizer --title 'Nocturne Visualizer' \
  cava -p "$visualizer_config"
