#!/usr/bin/env python3
"""Nocturne month calendar card for the centered Waybar clock."""

from __future__ import annotations

import os
import json
import re
import signal
import subprocess
from pathlib import Path

os.environ["GDK_BACKEND"] = "wayland"

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402


RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
PID_FILE = RUNTIME / "nocturne-calendar.pid"

CSS_TEMPLATE = b"""
* { font-family: Inter, sans-serif; font-size: 11px; }
window { background: transparent; }
.card {
  background: alpha(@BASE@, 0.985);
  color: @TEXT@;
  border: 1px solid @ACCENT2@;
  border-bottom: 2px solid @LINE@;
  padding: 13px;
}
.eyebrow { color: @ACCENT@; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
.date { color: @TEXT@; font-size: 17px; font-weight: 800; }
calendar { background: @SURFACE@; color: @TEXT@; border: 1px solid @LINE@; padding: 7px; }
calendar.header { color: @ACCENT@; font-weight: 800; }
calendar.button { color: @MUTED@; }
calendar:selected { background: @ACCENT@; color: @BASE@; }
button {
  min-height: 30px; padding: 2px 11px; border-radius: 0;
  color: @TEXT@; background: @SURFACE@; border: 1px solid @LINE@;
}
button:hover { color: @TEXT@; background: @OVERLAY@; border-color: @ACCENT@; }
.primary { color: @BASE@; background: @ACCENT@; border-color: @ACCENT2@; font-weight: 800; }
"""


def themed_css(template: bytes) -> bytes:
    colors = {
        "BASE": "07090a", "SURFACE": "0b0f10", "OVERLAY": "111719",
        "LINE": "1b2925", "TEXT": "a7b8b1", "MUTED": "4d5d58",
        "ACCENT": "5f8f76", "ACCENT2": "477463",
    }
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "nocturne"
    for filename in ("palette.css", "accent.css"):
        try:
            data = (config / filename).read_text(encoding="utf-8")
        except OSError:
            continue
        for name in colors:
            match = re.search(rf"^@define-color {name.lower()} #([0-9a-fA-F]{{6}});", data, re.MULTILINE)
            if match:
                colors[name] = match.group(1)
    for name, value in colors.items():
        template = template.replace(f"@{name}@".encode(), f"#{value}".encode())
    return template


def stop_existing() -> bool:
    try:
        pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        command = Path(f"/proc/{pid}/cmdline").read_bytes()
        if b"nocturne-calendar" not in command:
            PID_FILE.unlink(missing_ok=True)
            return False
        os.kill(pid, 0)
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        PID_FILE.unlink(missing_ok=True)
        return False


class CalendarApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="com.nocturne.Calendar")
        self.window: Gtk.ApplicationWindow | None = None
        self.selected = Gtk.Label()
        self.was_active = False

    def do_activate(self) -> None:
        provider = Gtk.CssProvider()
        provider.load_from_data(themed_css(CSS_TEMPLATE))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        window = Gtk.ApplicationWindow(application=self)
        window.set_decorated(False)
        window.set_resizable(False)
        window.set_title("Nocturne Calendar")
        window.set_default_size(340, 386)
        window.connect("notify::is-active", self._activity_changed)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.add_css_class("card")
        eyebrow = Gtk.Label(label="NOCTURNE // CALENDAR", xalign=0)
        eyebrow.add_css_class("eyebrow")
        root.append(eyebrow)
        self.selected.set_xalign(0)
        self.selected.add_css_class("date")
        root.append(self.selected)

        calendar = Gtk.Calendar()
        calendar.set_show_day_names(True)
        calendar.set_show_heading(True)
        calendar.connect("day-selected", self._update_date)
        calendar.connect("next-month", self._update_date)
        calendar.connect("prev-month", self._update_date)
        root.append(calendar)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        today = Gtk.Button(label="TODAY")
        today.add_css_class("primary")
        today.connect("clicked", lambda _button: calendar.select_day(GLib.DateTime.new_now_local()))
        open_app = Gtk.Button(label="OPEN AGENDA")
        open_app.connect("clicked", self._open_agenda)
        close = Gtk.Button(label="CLOSE")
        close.connect("clicked", lambda _button: self.quit())
        actions.append(today)
        actions.append(open_app)
        actions.append(close)
        root.append(actions)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        window.add_controller(keys)
        window.set_child(root)
        self.window = window
        PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
        self._update_date(calendar)
        window.present()
        GLib.timeout_add(35, self._place_window)

    def _activity_changed(self, window: Gtk.ApplicationWindow, _param: object) -> None:
        if window.is_active():
            self.was_active = True
        elif self.was_active:
            GLib.idle_add(self.quit)

    def _place_window(self) -> bool:
        """Place the popover below the bar on the monitor under the pointer."""
        if self.window is None:
            return False
        try:
            clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
            monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], text=True))
            cursor = json.loads(subprocess.check_output(["hyprctl", "cursorpos", "-j"], text=True))
            client = next(item for item in clients if item.get("pid") == os.getpid())
            px, py = int(cursor["x"]), int(cursor["y"])
            monitor = next(
                item
                for item in monitors
                if item["x"] <= px < item["x"] + item["width"]
                and item["y"] <= py < item["y"] + item["height"]
            )
            width = int(client["size"][0])
            x = int(monitor["x"] + (monitor["width"] - width) / 2)
            y = int(monitor["y"] + 34)
            subprocess.run(
                ["hyprctl", "dispatch", "movewindowpixel", f"exact {x} {y},address:{client['address']}"],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return False
        except (OSError, ValueError, KeyError, StopIteration, subprocess.SubprocessError):
            return True

    def _update_date(self, calendar: Gtk.Calendar, *_args) -> None:
        selected = calendar.get_date()
        self.selected.set_text(selected.format("%A · %d %B %Y"))

    def _open_agenda(self, _button: Gtk.Button) -> None:
        try:
            subprocess.Popen(
                ["gnome-calendar"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            pass
        self.quit()

    def _on_key(self, _controller, keyval, _keycode, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def do_shutdown(self) -> None:
        try:
            if PID_FILE.read_text(encoding="utf-8").strip() == str(os.getpid()):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    if stop_existing():
        raise SystemExit(0)
    raise SystemExit(CalendarApp().run([]))
