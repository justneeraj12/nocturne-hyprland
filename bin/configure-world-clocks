#!/usr/bin/gjs

imports.gi.versions.GWeather = '4.0';

const { Gio, GLib, GWeather } = imports.gi;

if (ARGV.length !== 1) {
    printerr('Usage: configure-world-clocks /path/to/locations.json');
    imports.system.exit(2);
}

const [, contents] = GLib.file_get_contents(ARGV[0]);
const config = JSON.parse(new TextDecoder().decode(contents));
const locations = config.weather_locations.map(place =>
    GWeather.Location.new_detached(
        place.label,
        null,
        place.latitude,
        place.longitude
    )
);
const serialized = locations.map(location => location.serialize());

const clocks = new Gio.Settings({ schema_id: 'org.gnome.clocks' });
clocks.set_value(
    'world-clocks',
    new GLib.Variant('aa{sv}', serialized.map(location => ({ location })))
);

const shellClocks = new Gio.Settings({ schema_id: 'org.gnome.shell.world-clocks' });
shellClocks.set_value('locations', new GLib.Variant('av', serialized));

const extensionUuids = [
    'tilingshell@ferrarodomenico.com',
    'pomodoro-timer@Oguzhankokulu.github.com',
    'date-menu-formatter@marcinjakubowski.github.com',
    'clipboard-history@alexsaveau.dev',
    'medialine@funinkina.co.in',
    'notification-icons@jiggak.io',
    'simple-weather@romanlefler.com',
];
const replacedTiler = 'tiling-assistant@ubuntu.com';
const shell = new Gio.Settings({ schema_id: 'org.gnome.shell' });
let enabled = shell.get_strv('enabled-extensions').filter(uuid => uuid !== replacedTiler);
for (const uuid of extensionUuids) {
    if (!enabled.includes(uuid))
        enabled.push(uuid);
}
shell.set_strv('enabled-extensions', enabled);

let disabled = shell.get_strv('disabled-extensions')
    .filter(uuid => !extensionUuids.includes(uuid));
if (!disabled.includes(replacedTiler))
    disabled.push(replacedTiler);
shell.set_strv('disabled-extensions', disabled);

print(`Configured ${locations.length} world clocks and ${extensionUuids.length} GNOME extensions.`);
