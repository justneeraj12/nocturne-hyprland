#!/usr/bin/env python3
"""Generate bounded Hyprland Lua window rules from declarative JSON."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path
from typing import Any


HOME = Path(os.environ.get("HOME", str(Path.home())))
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CONFIG = CONFIG_HOME / "nocturne/window-rules.json"
GENERATED = CONFIG_HOME / "nocturne/window-rules.lua"
FORMAT = "nocturne-window-rules-v1"
ACTIONS = {"tile", "float", "workspace", "opacity", "monitor", "size", "pin", "idle-inhibit"}


def atomic_text(path: Path, value: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(value)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load() -> dict[str, Any]:
    try:
        config = json.loads(CONFIG.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        config = {}
    if config.get("format") != FORMAT or not isinstance(config.get("rules"), list):
        config = {"format": FORMAT, "rules": []}
        save(config, reload=False)
    else:
        os.chmod(CONFIG, 0o600)
    return config


def lua_string(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ") + '"'


def exact_pattern(value: str) -> str:
    return "^" + re.escape(value) + "$"


def action_lua(rule: dict[str, Any]) -> str:
    action = rule["action"]
    value = str(rule.get("value", ""))
    if action in {"tile", "float", "pin"}:
        return f"{action.replace('-', '_')} = true"
    if action == "workspace":
        return f"workspace = {lua_string(value)}"
    if action == "monitor":
        return f"monitor = {lua_string(value)}"
    if action == "opacity":
        return f"opacity = {lua_string(value + ' override ' + value + ' override ' + value + ' override')}"
    if action == "idle-inhibit":
        return 'idle_inhibit = "always"'
    width, height = value.lower().split("x", 1)
    return f"size = {{{int(width)}, {int(height)}}}"


def render(config: dict[str, Any]) -> str:
    lines = [
        "-- Generated by nocturne-window-rules. Edit through NOC Settings.",
        "-- Invalid or disabled entries are never emitted.",
    ]
    for rule in config["rules"]:
        if not isinstance(rule, dict) or not rule.get("enabled", True):
            continue
        try:
            window_class = str(rule["class"])
            title = str(rule.get("title", ""))
            action = str(rule["action"])
            value = validate(action, str(rule.get("value", "")))
            if not window_class or any(ord(char) < 32 for char in window_class + title):
                continue
            normalized = {**rule, "class": window_class, "title": title, "action": action, "value": value}
            match = f"class = {lua_string(exact_pattern(window_class))}"
            if title:
                match += f", title = {lua_string(exact_pattern(title))}"
            lines.append(f"hl.window_rule({{ match = {{ {match} }}, {action_lua(normalized)} }})")
        except (KeyError, TypeError, ValueError, SystemExit):
            continue
    lines.append("")
    return "\n".join(lines)


def save(config: dict[str, Any], reload: bool = True) -> None:
    atomic_text(CONFIG, json.dumps(config, ensure_ascii=False, separators=(",", ":")) + "\n")
    atomic_text(GENERATED, render(config), 0o600)
    if reload and os.environ.get("NOCTURNE_NO_RESTART") != "1":
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def validate(action: str, value: str) -> str:
    if action not in ACTIONS:
        raise SystemExit("Unsupported rule action")
    if action == "workspace" and not re.fullmatch(r"(?:[1-9][0-9]?|special:[A-Za-z0-9_.-]+)", value):
        raise SystemExit("Workspace must be 1..99 or special:name")
    if action == "opacity":
        try:
            number = float(value)
        except ValueError as exc:
            raise SystemExit("Opacity must be between 0.40 and 1.00") from exc
        if not 0.4 <= number <= 1.0:
            raise SystemExit("Opacity must be between 0.40 and 1.00")
        value = f"{number:.2f}"
    if action == "monitor" and not re.fullmatch(r"[A-Za-z0-9_.-]+", value):
        raise SystemExit("Invalid monitor output")
    if action == "size" and not re.fullmatch(r"[3-9][0-9]{2,3}x[2-9][0-9]{2,3}", value):
        raise SystemExit("Size must look like 960x720")
    if action in {"tile", "float", "pin", "idle-inhibit"}:
        value = ""
    return value


def capture() -> dict[str, Any]:
    try:
        process = subprocess.run(["hyprctl", "-j", "activewindow"], capture_output=True, text=True, timeout=2, check=False)
        data = json.loads(process.stdout or "{}")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        data = {}
    return {
        "class": str(data.get("class", ""))[:160],
        "title": str(data.get("title", ""))[:240],
        "workspace": data.get("workspace", {}).get("name", "") if isinstance(data.get("workspace"), dict) else "",
        "monitor": data.get("monitor", -1),
        "floating": bool(data.get("floating", False)),
    }


def clients() -> list[dict[str, str]]:
    try:
        process = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=2, check=False)
        values = json.loads(process.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        values = []
    result: list[dict[str, str]] = []
    seen: set[tuple[str, str]] = set()
    for value in values if isinstance(values, list) else []:
        window_class = str(value.get("class", ""))[:160]
        title = str(value.get("title", ""))[:240]
        key = (window_class, title)
        if not window_class or key in seen:
            continue
        seen.add(key)
        result.append({"class": window_class, "title": title, "label": f"{window_class} · {title}"[:180]})
    return sorted(result, key=lambda item: item["label"].lower())


def status() -> None:
    config = load()
    print(json.dumps({"format": FORMAT, "count": len(config["rules"]), "active": sum(1 for item in config["rules"] if item.get("enabled", True)), "actions": sorted(ACTIONS), "rules": config["rules"], "focused": capture(), "clients": clients()}, separators=(",", ":")))


def add(name: str, window_class: str, title: str, action: str, value: str) -> None:
    name = name.strip()[:80]
    window_class = window_class.strip()[:160]
    title = "" if title == "-" else title.strip()[:240]
    if not name or not window_class or any(ord(char) < 32 for char in window_class + title):
        raise SystemExit("A name and valid application class are required")
    value = validate(action, value)
    config = load()
    config["rules"].append({"id": uuid.uuid4().hex[:10], "name": name, "class": window_class, "title": title, "action": action, "value": value, "enabled": True})
    save(config)
    status()


def mutate(identifier: str, operation: str) -> None:
    config = load()
    match = next((item for item in config["rules"] if item.get("id") == identifier), None)
    if match is None:
        raise SystemExit("Unknown rule")
    if operation == "remove":
        config["rules"] = [item for item in config["rules"] if item.get("id") != identifier]
    else:
        match["enabled"] = operation == "enable"
    save(config)
    status()


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else "status"
    if command == "status":
        status()
    elif command == "capture":
        print(json.dumps(capture(), separators=(",", ":")))
    elif command == "add" and len(argv) == 7:
        add(*argv[2:7])
    elif command in {"remove", "enable", "disable"} and len(argv) == 3:
        mutate(argv[2], command)
    elif command == "rebuild":
        save(load())
        status()
    else:
        print("Usage: nocturne-window-rules status|capture|add NAME CLASS TITLE|- ACTION VALUE|remove ID|enable ID|disable ID|rebuild", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
