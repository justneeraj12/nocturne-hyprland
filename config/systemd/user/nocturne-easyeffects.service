[Unit]
Description=Nocturne EasyEffects audio processing
After=pipewire.service wireplumber.service graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/easyeffects --service-mode
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
