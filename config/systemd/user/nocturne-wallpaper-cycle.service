[Unit]
Description=Nocturne dynamic wallpaper rotation
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nocturne-wallpaper-cycle daemon
Restart=always
RestartSec=3

# Hyprland owns startup after exporting WAYLAND_DISPLAY and the instance
# signature. Enabling this unit at default.target races the compositor.
