[Unit]
Description=Nocturne native multi-display shell
After=graphical-session.target
PartOf=nocturne-session.target graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.config/hypr/scripts/bar
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
MemoryHigh=384M
OOMPolicy=stop

