{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/noc.txt",
    "color": {
      "1": "#fff4dc",
      "2": "#d9b086",
      "3": "#b96e47",
      "4": "#7aa58b",
      "5": "#345d50",
      "6": "#e17780"
    },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ·  ",
    "color": { "keys": "#6d9578", "title": "#fff0d4" },
    "key": { "width": 13 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "Compositor" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk" },
    "break",
    "colors"
  ]
}
