#!/usr/bin/env bash
set -euo pipefail

read -r _ total used available percent _ < <(df -hP / | tail -n 1)
number=${percent%%%}
class=normal
((number >= 90)) && class=critical
((number >= 80 && number < 90)) && class=warning

printf -v tooltip 'SYSTEM DISK\nUsed %s / %s  ·  %s free\nClick: Files  ·  Right: Resources' "$used" "$total" "$available"
jq -cn --arg text "󰋊 $percent" --arg class "$class" \
  --arg tooltip "$tooltip" \
  '{text:$text,class:$class,tooltip:$tooltip}'
