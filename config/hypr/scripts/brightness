#!/usr/bin/env bash
set -euo pipefail

read_percent() {
  brightnessctl -m | awk -F, 'NR == 1 {gsub(/%/, "", $4); print $4}'
}

set_percent() {
  local percent=$1 device maximum raw
  ((percent < 5)) && percent=5
  ((percent > 100)) && percent=100
  device=$(brightnessctl -m | awk -F, 'NR == 1 {print $1}')
  maximum=$(brightnessctl max)
  raw=$((maximum * percent / 100))
  busctl call org.freedesktop.login1 \
    /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness \
    ssu backlight "$device" "$raw" >/dev/null
}

status() {
  local percent icon
  percent=$(read_percent)
  if ((percent < 25)); then icon='󰃞';
  elif ((percent < 50)); then icon='󰃟';
  elif ((percent < 75)); then icon='󰃝';
  else icon='󰃠'; fi
  printf -v tooltip 'Laptop brightness %s%%\nScroll: adjust · Click: choose level' "$percent"
  jq -cn --arg text "$icon ${percent}%" \
    --arg tooltip "$tooltip" \
    '{text:$text,tooltip:$tooltip,class:"brightness"}'
}

adjust() {
  local current
  current=$(read_percent)
  case $1 in
    up) set_percent "$((current + 5))" ;;
    down) set_percent "$((current - 5))" ;;
  esac
}

pick() {
  local current choice value
  if "$HOME/.config/hypr/scripts/quick-menu" --toggle BRIGHTNESS; then exit 0; fi
  current=$(read_percent)
  choice=$(printf '%s\n' \
    "󰃠  Laptop display · ${current}%" \
    '󰃞  Dim · 20%' \
    '󰃟  Low · 35%' \
    '󰃝  Balanced · 55%' \
    '󰃠  Bright · 75%' \
    '󰃠  Very bright · 90%' \
    '󰃠  Maximum · 100%' | \
    "$HOME/.config/hypr/scripts/quick-menu" BRIGHTNESS auto 330 220) || exit 0
  case "$choice" in
    *'20%'*) value=20 ;;
    *'35%'*) value=35 ;;
    *'55%'*) value=55 ;;
    *'75%'*) value=75 ;;
    *'90%'*) value=90 ;;
    *'100%'*) value=100 ;;
    *) exit 0 ;;
  esac
  set_percent "$value"
  notify-send -a Nocturne 'Display brightness' "Set to ${value}%"
}

case ${1:-status} in
  status) status ;;
  up|down) adjust "$1" ;;
  pick) pick ;;
  *) printf 'Usage: %s status|up|down|pick\n' "$0" >&2; exit 2 ;;
esac
