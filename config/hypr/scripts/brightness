#!/usr/bin/env bash
set -euo pipefail

read_percent() {
  brightnessctl -m | awk -F, 'NR == 1 {gsub(/%/, "", $4); print $4}'
}

power_config=${XDG_CONFIG_HOME:-"$HOME/.config"}/nocturne/power-lab.json
brightness_floor() {
  local value
  value=$(jq -r '.brightnessFloor // 5' "$power_config" 2>/dev/null || printf 5)
  [[ $value =~ ^(1|2|5|10|15|20)$ ]] && printf '%s\n' "$value" || printf '5\n'
}

brightness_step() {
  local value
  value=$(jq -r '.brightnessStep // 5' "$power_config" 2>/dev/null || printf 5)
  [[ $value =~ ^(1|2|5|10)$ ]] && printf '%s\n' "$value" || printf '5\n'
}

set_percent() {
  local percent=$1 device maximum raw
  local floor
  [[ $percent =~ ^[0-9]{1,3}$ ]] || { printf 'Brightness must be an integer from 0 to 100.\n' >&2; exit 2; }
  floor=$(brightness_floor)
  ((percent < floor)) && percent=$floor
  ((percent > 100)) && percent=100
  device=$(brightnessctl -m | awk -F, 'NR == 1 {print $1}')
  maximum=$(brightnessctl max)
  raw=$((maximum * percent / 100))
  busctl call org.freedesktop.login1 \
    /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness \
    ssu backlight "$device" "$raw" >/dev/null
}

status() {
  local percent icon
  percent=$(read_percent)
  icon='󰖨'
  printf -v tooltip 'Laptop brightness %s%%\nScroll: adjust · Click: choose level' "$percent"
  jq -cn --arg text "$icon ${percent}%" \
    --arg tooltip "$tooltip" \
    '{text:$text,tooltip:$tooltip,class:"brightness"}'
}

adjust() {
  local current step
  current=$(read_percent)
  step=$(brightness_step)
  case $1 in
    up) set_percent "$((current + step))" ;;
    down) set_percent "$((current - step))" ;;
  esac
}

pick() {
  exec "$HOME/.local/bin/nocturne-native" brightness
}

case ${1:-status} in
  status) status ;;
  value) read_percent ;;
  up|down) adjust "$1" ;;
  set) set_percent "${2:?brightness percentage required}" ;;
  pick) pick ;;
  *) printf 'Usage: %s status|value|up|down|set PERCENT|pick\n' "$0" >&2; exit 2 ;;
esac
