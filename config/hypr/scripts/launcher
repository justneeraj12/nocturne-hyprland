#!/usr/bin/env bash
set -euo pipefail

runtime=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
pid_file="$runtime/nocturne-launcher.pid"

if [[ -r $pid_file ]]; then
  old_pid=$(<"$pid_file")
  if [[ $old_pid =~ ^[0-9]+$ ]] \
      && kill -0 "$old_pid" 2>/dev/null \
      && tr '\0' ' ' < "/proc/$old_pid/cmdline" 2>/dev/null | grep -q 'wofi'; then
    kill "$old_pid" 2>/dev/null || true
    exit 0
  fi
  rm -f -- "$pid_file"
fi

wofi --show drun \
  --conf "$HOME/.config/wofi/config" \
  --style "$HOME/.config/wofi/style.css" &
launcher_pid=$!
printf '%s\n' "$launcher_pid" > "$pid_file"

cleanup() {
  if [[ -r $pid_file ]] && [[ $(<"$pid_file") == "$launcher_pid" ]]; then
    rm -f -- "$pid_file"
  fi
}
trap cleanup EXIT INT TERM
wait "$launcher_pid" || true
