#!/usr/bin/env bash
set -euo pipefail

if "$HOME/.config/hypr/scripts/quick-menu" --toggle AUDIO; then exit 0; fi

menu() {
  local prompt=${1:-AUDIO}
  "$HOME/.config/hypr/scripts/quick-menu" "$prompt" auto 380 260
}

while true; do
  default_sink=$(pactl get-default-sink)
  default_volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
  volume=$(awk '{printf "%d", $2 * 100}' <<<"$default_volume")
  muted=''
  grep -q MUTED <<<"$default_volume" && muted=' · MUTED'
  default_name=$(pactl -f json list sinks | jq -r --arg sink "$default_sink" \
    '.[] | select(.name == $sink) | .description' | head -n 1)
  [[ -n $default_name ]] || default_name='Default output'

  declare -A output_sink=() input_source=() app_id=() app_name=()
  entries=(
    "󰕾  $default_name · ${volume}%${muted}"
    '󰝝  Volume +5%'
    '󰝞  Volume −5%'
    '󰝟  Toggle output mute'
    '──────── OUTPUTS ────────'
  )

  while IFS=$'\t' read -r sink name level is_muted; do
    [[ -n $sink ]] || continue
    suffix=''
    [[ $is_muted == true ]] && suffix=' · muted'
    marker='○'
    [[ $sink == "$default_sink" ]] && marker='●'
    label="$marker  $name · ${level}%${suffix}"
    entries+=("$label")
    output_sink["$label"]=$sink
  done < <(pactl -f json list sinks | jq -r '
    .[]
    | select((.properties["node.virtual"] // "false") != "true")
    | select((.ports | length) == 0 or ([.ports[] | select(.availability != "not available")] | length) > 0)
    | [.name, (.description // .name),
       (.volume | to_entries[0].value.value_percent | sub("%"; "")), .mute]
    | @tsv
  ')

  current_mic_id=$("$HOME/.config/hypr/scripts/audio-route" current-mic-id 2>/dev/null || true)
  entries+=('──────── MICROPHONES ────────')
  while IFS=$'\t' read -r source name object_id level is_muted; do
    [[ -n $source ]] || continue
    suffix=''
    [[ $is_muted == true ]] && suffix=' · muted'
    marker='○'
    [[ -n $object_id && $object_id == "$current_mic_id" ]] && marker='●'
    label="$marker  $name · ${level}%${suffix}"
    [[ -n ${input_source["$label"]:-} ]] && label="$marker  $name ($object_id) · ${level}%${suffix}"
    entries+=("$label")
    input_source["$label"]=$source
  done < <(pactl -f json list sources | jq -r '
    .[]
    | select((.name | endswith(".monitor")) | not)
    | select(.name != "easyeffects_source")
    | select((.properties["node.virtual"] // "false") != "true")
    | select((.ports | length) == 0 or ([.ports[] | select(.availability != "not available")] | length) > 0)
    | [.name, (.description // .name), (.properties["object.id"] // ""),
       (.volume | to_entries[0].value.value_percent | sub("%"; "")), .mute]
    | @tsv
  ')

  entries+=('──────── APP VOLUMES ────────')
  while IFS=$'\t' read -r id name media; do
    [[ -n $id ]] || continue
    state=$(wpctl get-volume "$id" 2>/dev/null || printf 'Volume: 0')
    level=$(awk '{printf "%d", $2 * 100}' <<<"$state")
    suffix=''
    grep -q MUTED <<<"$state" && suffix=' · muted'
    label="󰎆  ${name:-$media} · ${level}%${suffix}"
    [[ -n ${app_id["$label"]:-} ]] && label="󰎆  ${name:-$media} ($id) · ${level}%${suffix}"
    entries+=("$label")
    app_id["$label"]=$id
    app_name["$label"]=${name:-$media}
  done < <(pw-dump 2>/dev/null | jq -r '
    .[] | select(.type == "PipeWire:Interface:Node")
    | select(.info.props["media.class"] == "Stream/Output/Audio" and .info.state == "running")
    | [.id, (.info.props["application.name"] // "App"), (.info.props["media.name"] // "Playback")] | @tsv
  ')

  entries+=(
    '──────── TOOLS ──────────'
    '󰎈  Nocturne visualizer'
    '󰏘  Visualizer theme'
    '󱡬  Audio routing graph'
  )

  choice=$(printf '%s\n' "${entries[@]}" | menu AUDIO) || exit 0
  [[ -n $choice ]] || exit 0
  case "$choice" in
    *'Volume +5%'*) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    *'Volume −5%'*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    *'Toggle output mute'*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *'Nocturne visualizer'*) exec "$HOME/.local/bin/nocturne-visualizer" ;;
    *'Visualizer theme'*) exec "$HOME/.local/bin/nocturne-visualizer" choose ;;
    *'routing graph'*) exec qpwgraph ;;
    '────────'*|"󰕾"*) continue ;;
    *)
      sink=${output_sink["$choice"]:-}
      if [[ -n $sink ]]; then
        name=${choice#*  }
        name=${name%% ·*}
        if "$HOME/.config/hypr/scripts/audio-route" set "$sink" "$name"; then
          exit 0
        fi
        notify-send -u critical -a Nocturne 'Audio output failed' "$name could not become the default output."
        exit 0
      fi

      source=${input_source["$choice"]:-}
      if [[ -n $source ]]; then
        name=${choice#*  }
        name=${name%% ·*}
        if "$HOME/.config/hypr/scripts/audio-route" set-mic "$source" "$name"; then
          exit 0
        fi
        notify-send -u critical -a Nocturne 'Microphone failed' "$name could not become the active microphone."
        exit 0
      fi

      id=${app_id["$choice"]:-}
      [[ -n $id ]] || continue
      name=${app_name["$choice"]:-App}
      action=$(printf '%s\n' \
        '󰝝  App volume +5%' \
        '󰝞  App volume −5%' \
        '󰝟  Toggle app mute' \
        '󰁍  Back' | menu "$name") || continue
      case "$action" in
        *'+5%'*) wpctl set-volume -l 1.5 "$id" 5%+ ;;
        *'−5%'*) wpctl set-volume "$id" 5%- ;;
        *'mute'*) wpctl set-mute "$id" toggle ;;
      esac
      ;;
  esac
done
