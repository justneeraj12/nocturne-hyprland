#!/usr/bin/env bash
set -euo pipefail

clock=$(date '+%I:%M')
clock=${clock#0}
if [[ $(date '+%p') == AM ]]; then marker='+'; else marker='−'; fi
printf -v tooltip '%s\n%s' "$(date '+%A, %d %B %Y')" '+ AM  ·  − PM'
jq -cn --arg text "${clock}${marker}" --arg tooltip "$tooltip" \
  '{text:$text,tooltip:$tooltip,class:"local-clock"}'
