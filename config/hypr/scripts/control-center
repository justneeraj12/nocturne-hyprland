#!/usr/bin/env bash
set -euo pipefail

if "$HOME/.config/hypr/scripts/quick-menu" --toggle SETTINGS; then exit 0; fi

choice=$(printf '%s\n' \
  '󰒓  Open full Nocturne Settings' \
  '󰏘  Accent color' \
  '󰸉  Wallpaper' \
  '󰏘  GTK application style' \
  '──────── DEVICES ───────────' \
  '󰃠  Display brightness' \
  '󰤨  Wi-Fi and network' \
  '󰂯  Bluetooth devices' \
  '󰦝  VPN connections' \
  '󰄜  Phone / KDE Connect' \
  '──────── SOUND ─────────────' \
  '󰕾  Audio outputs and apps' \
  '󰎈  Nocturne visualizer' \
  '󰏘  Visualizer theme' \
  '󱡬  Audio routing graph' \
  '──────── DESKTOP ───────────' \
  '󰥔  Clock and world weather' \
  '󱅫  Notifications' \
  '󰅶  Toggle caffeine' \
  '󱎫  Pomodoro toggle' \
  '󰌌  Keyboard shortcuts' \
  '──────── SYSTEM ────────────' \
  '󰍛  System resources' \
  '󰫮  Hacker dashboard' \
  '󰐥  Session and power' | \
  "$HOME/.config/hypr/scripts/quick-menu" SETTINGS auto 390 600)

case "$choice" in
  '────────'*) exit 0 ;;
  *'full Nocturne'*) exec nocturne-settings ;;
  *Accent*) exec "$HOME/.config/hypr/scripts/accent" ;;
  *Wallpaper) exec "$HOME/.config/hypr/scripts/wallpaper" ;;
  *'GTK application'*) exec nwg-look ;;
  *brightness) exec "$HOME/.local/bin/nocturne-panel" toggle brightness ;;
  *Wi-Fi*) exec "$HOME/.local/bin/nocturne-panel" toggle connectivity wifi ;;
  *Bluetooth*) exec "$HOME/.local/bin/nocturne-panel" toggle connectivity bluetooth ;;
  *VPN*) exec "$HOME/.local/bin/nocturne-panel" toggle connectivity vpn ;;
  *KDE*) exec "$HOME/.config/hypr/scripts/kdeconnect-menu" ;;
  *'Audio outputs'*) exec "$HOME/.config/hypr/scripts/audio-panel" ;;
  *'Nocturne visualizer'*) exec "$HOME/.local/bin/nocturne-visualizer" ;;
  *'Visualizer theme'*) exec "$HOME/.local/bin/nocturne-visualizer" choose ;;
  *routing*) exec qpwgraph ;;
  *'Clock and'*) exec "$HOME/.local/bin/nocturne-panel" toggle world ;;
  *Notifications) exec swaync-client -t -sw ;;
  *caffeine) exec "$HOME/.config/hypr/scripts/caffeine" toggle ;;
  *Pomodoro) exec "$HOME/.config/hypr/scripts/pomodoro" toggle ;;
  *shortcuts) exec "$HOME/.config/hypr/scripts/help" ;;
  *resources) exec resources ;;
  *Hacker*) exec nocturne-dashboard ;;
  *power) exec "$HOME/.config/hypr/scripts/power-menu" ;;
esac
