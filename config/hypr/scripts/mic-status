#!/usr/bin/env bash
set -euo pipefail

state=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || printf 'Volume: 0 [MUTED]')
volume=$(awk '{printf "%d", $2 * 100}' <<<"$state")
device=$(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | sed -n 's/.*node.nick = "\(.*\)"/\1/p' | head -n 1)
apps=$(pw-dump 2>/dev/null | jq -r '
  [.[] | select(.type == "PipeWire:Interface:Node")
   | select(.info.props["media.class"] == "Stream/Input/Audio" and .info.state == "running")
   | select((.info.props["application.name"] // "" | ascii_downcase) as $app
       | ($app != "cava" and $app != "easyeffects"))
   | select((.info.props["node.name"] // "" | ascii_downcase | contains("monitor")) | not)
   | .info.props["application.name"]] | unique | join(", ")
')

if grep -q MUTED <<<"$state"; then
  text='󰍭'
  class='muted'
  detail='Muted'
elif [[ -n $apps ]]; then
  text='󰍬'
  class='active'
  detail="In use by $apps"
else
  text='󰍬'
  class='idle'
  detail='Not in use'
fi

printf -v tooltip 'MICROPHONE  ·  %s\n%s%%  ·  %s\nClick: mute  ·  Right: audio panel' \
  "${device:-Default}" "$volume" "$detail"
jq -cn --arg text "$text" --arg class "$class" \
  --arg tooltip "$tooltip" \
  '{text:$text,class:$class,tooltip:$tooltip}'
