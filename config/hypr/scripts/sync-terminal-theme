#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
palette="$config_home/nocturne/palette.css"
accent_file="$config_home/nocturne/accent.css"
kitty_theme="$config_home/nocturne/kitty-theme.conf"
zsh_palette="$config_home/nocturne/terminal-palette.zsh"

hex() {
  local file=$1 name=$2 fallback=$3 value
  value=$(sed -nE "s/^@define-color ${name} #([0-9a-fA-F]{6});/\1/p" "$file" 2>/dev/null | head -n1)
  printf '%s' "${value:-$fallback}" | tr '[:upper:]' '[:lower:]'
}

base=$(hex "$palette" base 07090a)
surface=$(hex "$palette" surface 0b0f10)
overlay=$(hex "$palette" overlay 111719)
line=$(hex "$palette" line 1b2925)
text=$(hex "$palette" text a7b8b1)
muted=$(hex "$palette" muted 4d5d58)
selection=$(hex "$palette" selection 15221e)
accent=$(hex "$accent_file" accent 5f8f76)
accent2=$(hex "$accent_file" accent2 477463)

mkdir -p "$config_home/nocturne"
kitty_tmp="$kitty_theme.tmp"
cat > "$kitty_tmp" <<EOF
# Generated by NOC. Change the desktop theme or accent; do not edit this file.
background #$base
foreground #$text
selection_background #$selection
selection_foreground #$text
cursor #$accent
cursor_text_color #$base
url_color #$accent
active_border_color #$accent
inactive_border_color #$line
active_tab_background #$accent2
active_tab_foreground #$text
inactive_tab_background #$surface
inactive_tab_foreground #$muted
color0 #$base
color1 #c75c66
color2 #6d9578
color3 #c69b54
color4 #668e80
color5 #8c8090
color6 #$accent
color7 #$text
color8 #$overlay
color9 #e17780
color10 #82ad8c
color11 #d9a85f
color12 #7aa899
color13 #ad91b2
color14 #8bbda6
color15 #dce7e2
EOF
mv -f -- "$kitty_tmp" "$kitty_theme"

zsh_tmp="$zsh_palette.tmp"
cat > "$zsh_tmp" <<EOF
# Generated by NOC. Sourced by ~/.config/nocturne/zsh.zsh.
typeset -g NOC_BASE='#$base'
typeset -g NOC_SURFACE='#$surface'
typeset -g NOC_OVERLAY='#$overlay'
typeset -g NOC_LINE='#$line'
typeset -g NOC_TEXT='#$text'
typeset -g NOC_MUTED='#$muted'
typeset -g NOC_SELECTION='#$selection'
typeset -g NOC_ACCENT='#$accent'
typeset -g NOC_ACCENT2='#$accent2'
EOF
mv -f -- "$zsh_tmp" "$zsh_palette"

