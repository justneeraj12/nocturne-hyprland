#!/usr/bin/env bash
set -euo pipefail

find_window() {
  hyprctl clients -j 2>/dev/null | jq -r '
    first(.[] | select((.class | ascii_downcase) == "hyprpwcenter") | .address) // empty
  '
}

if [[ ${1:-} == --guard ]]; then
  address=${2:-}
  [[ -n $address ]] || exit 0
  sleep 0.35
  hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1 || exit 0
  sleep 0.15
  while hyprctl clients -j 2>/dev/null | jq -e --arg address "$address" \
      'any(.[]; .address == $address)' >/dev/null 2>&1; do
    active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null || true)
    if [[ -n $active && $active != "$address" ]]; then
      hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
      exit 0
    fi
    sleep 0.10
  done
  exit 0
fi

if address=$(find_window) && [[ -n $address ]]; then
  hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
  exit 0
fi

uwsm app -- hyprpwcenter >/dev/null 2>&1 &
for _ in {1..50}; do
  address=$(find_window)
  [[ -n $address ]] && break
  sleep 0.02
done
[[ -n ${address:-} ]] || exit 1
nohup "$0" --guard "$address" >/dev/null 2>&1 &
