#!/usr/bin/env bash
set -euo pipefail

data=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw \
  --format=csv,noheader,nounits 2>/dev/null | head -n 1) || exit 0
IFS=, read -r usage temp used total power <<<"$data"
usage=${usage// /}; temp=${temp// /}; used=${used// /}; total=${total// /}; power=${power// /}

jq -cn --arg text "󰢮 ${usage}%" \
  --arg tooltip "NVIDIA RTX 3050 Ti\nGPU ${usage}% · ${temp}°C\nVRAM ${used} / ${total} MiB\nPower ${power} W\nLeft: Resources · Right: dashboard" \
  '{text:$text,tooltip:$tooltip,class:(if ($text|test(" (8[5-9]|9[0-9]|100)%")) then "busy" else "normal" end)}'
