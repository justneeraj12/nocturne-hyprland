#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  combined)
    wifi_state=$(nmcli -t -f WIFI general 2>/dev/null || printf disabled)
    wifi_row=$(nmcli -t --escape yes -f IN-USE,SSID,SIGNAL device wifi list --rescan no 2>/dev/null | awk -F: '$1 == "*" {print; exit}')
    wifi_icon='󰤭'
    wifi_detail='Wi-Fi off'
    class=off
    if [[ $wifi_state == enabled ]]; then
      wifi_icon='󰤯'
      wifi_detail='Wi-Fi disconnected'
      class=idle
      if [[ -n $wifi_row ]]; then
        signal=${wifi_row##*:}
        ssid=${wifi_row#*:}; ssid=${ssid%:*}; ssid=${ssid//\\:/:}
        if ((signal >= 75)); then wifi_icon='󰤨'; elif ((signal >= 50)); then wifi_icon='󰤥'; elif ((signal >= 25)); then wifi_icon='󰤢'; else wifi_icon='󰤟'; fi
        wifi_detail="$ssid · ${signal}%"
        class=connected
      fi
    fi
    bluetooth_show=$(bluetoothctl show 2>/dev/null || true)
    bluetooth_icon='󰂲'
    bluetooth_detail='Bluetooth off'
    if grep -q $'Powered: yes' <<<"$bluetooth_show"; then
      bluetooth_icon='󰂯'
      mapfile -t bluetooth_devices < <(bluetoothctl devices Connected 2>/dev/null | sed -E 's/^Device [0-9A-F:]+ //')
      if ((${#bluetooth_devices[@]})); then
        bluetooth_icon='󰂱'
        bluetooth_detail=$(printf '%s\n' "${bluetooth_devices[@]}" | paste -sd, - | sed 's/,/, /g')
      else
        bluetooth_detail='Bluetooth on · no active device'
      fi
    fi
    vpn_count=$(nmcli -t --escape no -f TYPE connection show --active 2>/dev/null | awk '$0 == "vpn" || $0 == "wireguard" {count++} END {print count + 0}')
    vpn_icon='󰦝'
    ((vpn_count)) && class=connected
    printf -v tooltip 'CONNECTIVITY\n%s\n%s\nVPN · %s active\nClick: unified controls' "$wifi_detail" "$bluetooth_detail" "$vpn_count"
    jq -cn --arg text "$wifi_icon $bluetooth_icon $vpn_icon" --arg class "$class" --arg tooltip "$tooltip" \
      '{text:$text,class:$class,tooltip:$tooltip}'
    ;;
  wifi)
    if [[ $(nmcli -t -f WIFI general 2>/dev/null) != enabled ]]; then
      jq -cn '{text:"󰤭",class:"off",tooltip:"Wi-Fi is off\nClick: open connectivity"}'
      exit 0
    fi
    row=$(nmcli -t -f IN-USE,SSID,SIGNAL device wifi list --rescan no 2>/dev/null | awk -F: '$1 == "*" {print; exit}')
    if [[ -z $row ]]; then
      jq -cn '{text:"󰤯",class:"disconnected",tooltip:"Wi-Fi disconnected\nClick: choose a network"}'
      exit 0
    fi
    IFS=: read -r _ ssid signal <<<"$row"
    signal=${signal:-0}
    if ((signal >= 75)); then icon='󰤨'; elif ((signal >= 50)); then icon='󰤥'; elif ((signal >= 25)); then icon='󰤢'; else icon='󰤟'; fi
    jq -cn --arg text "$icon" --arg tooltip "$ssid · ${signal}%\nClick: Wi-Fi · Middle: VPN" \
      '{text:$text,class:"connected",tooltip:$tooltip}'
    ;;
  bluetooth)
    show=$(bluetoothctl show 2>/dev/null || true)
    if [[ -z $show ]]; then
      jq -cn '{text:"󰂲",class:"unavailable",tooltip:"Bluetooth controller unavailable"}'
      exit 0
    fi
    if ! grep -q $'Powered: yes' <<<"$show"; then
      jq -cn '{text:"󰂲",class:"off",tooltip:"Bluetooth is off\nClick: Bluetooth controls"}'
      exit 0
    fi
    mapfile -t devices < <(bluetoothctl devices Connected 2>/dev/null | sed -E 's/^Device [0-9A-F:]+ //')
    count=${#devices[@]}
    if ((count)); then
      names=$(printf '%s\n' "${devices[@]}" | paste -sd, - | sed 's/,/, /g')
      jq -cn --arg tooltip "$count connected · $names\nClick: Bluetooth devices" \
        '{text:"󰂱",class:"connected",tooltip:$tooltip}'
    else
      jq -cn '{text:"󰂯",class:"on",tooltip:"Bluetooth on · no connected devices\nClick: Bluetooth devices"}'
    fi
    ;;
  *) printf 'Usage: %s combined|wifi|bluetooth\n' "$0" >&2; exit 2 ;;
esac
