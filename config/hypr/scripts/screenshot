#!/usr/bin/env bash
set -euo pipefail

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
state_file="$runtime_dir/nocturne-recorder.state"
log_file="$runtime_dir/nocturne-recorder.log"
screenshots=${XDG_PICTURES_DIR:-"$HOME/Pictures"}/Screenshots
screencasts=${XDG_VIDEOS_DIR:-"$HOME/Videos"}/Screencasts
capture_ui="$HOME/.local/bin/nocturne-capture-ui"
capture_ui_pid="$runtime_dir/nocturne-capture-ui.pid"
freeze_ui="$HOME/.local/bin/nocturne-freeze-frame"
freeze_pid=0
freeze_dir=''
freeze_ready=''
freeze_files=()
mkdir -p "$screenshots" "$screencasts" "$runtime_dir"

stamp() { date +'%Y-%m-%d_%H-%M-%S'; }

freeze_start() {
  local output file
  local -a frame_args=()
  freeze_dir="$runtime_dir/nocturne-freeze-$$"
  freeze_ready="$freeze_dir/ready"
  mkdir -p "$freeze_dir"
  freeze_files=()
  # Capture before mapping any new surface, preserving transient menus exactly
  # as they appeared when Print Screen was pressed.
  while read -r output; do
    [[ -n $output ]] || continue
    file="$freeze_dir/$output.png"
    if grim -o "$output" "$file"; then
      freeze_files+=("$file")
      frame_args+=(--frame "$output=$file")
    fi
  done < <(hyprctl monitors -j | jq -r '.[].name')
  ((${#frame_args[@]} > 0)) || return 0
  "$freeze_ui" "${frame_args[@]}" --ready "$freeze_ready" >/dev/null 2>&1 &
  freeze_pid=$!
  for _ in {1..30}; do
    [[ -r $freeze_ready ]] && return 0
    kill -0 "$freeze_pid" 2>/dev/null || break
    sleep 0.02
  done
  freeze_stop
}

freeze_stop() {
  if [[ $freeze_pid =~ ^[0-9]+$ ]] && ((freeze_pid > 1)); then
    kill "$freeze_pid" 2>/dev/null || true
    wait "$freeze_pid" 2>/dev/null || true
  fi
  freeze_pid=0
  [[ -n $freeze_ready ]] && rm -f -- "$freeze_ready"
  for file in "${freeze_files[@]}"; do
    [[ -n $file ]] && rm -f -- "$file"
  done
  [[ -n $freeze_dir ]] && rmdir -- "$freeze_dir" 2>/dev/null || true
  freeze_ready=''
  freeze_dir=''
  freeze_files=()
}

read_recording() {
  recorder_pid=0
  recorder_file=''
  [[ -r $state_file ]] && IFS=$'\t' read -r recorder_pid recorder_file < "$state_file" || true
  if ! [[ $recorder_pid =~ ^[0-9]+$ ]] || ((recorder_pid < 2)) || ! kill -0 "$recorder_pid" 2>/dev/null; then
    recorder_pid=0
    recorder_file=''
    rm -f "$state_file"
    return 1
  fi
}

monitor_under_cursor() {
  local cursor monitors
  cursor=$(hyprctl cursorpos -j 2>/dev/null)
  monitors=$(hyprctl monitors -j 2>/dev/null)
  jq -r --argjson cursor "$cursor" '
    first(.[] | select(
      $cursor.x >= .x and $cursor.x < (.x + .width) and
      $cursor.y >= .y and $cursor.y < (.y + .height)
    ) | .name) // first(.[] | select(.focused) | .name) // first(.[].name)
  ' <<<"$monitors"
}

copy_and_report() {
  local file=$1
  wl-copy --type image/png < "$file"
  notify-send -a Nocturne -i "$file" 'Screenshot saved + copied' "$file"
}

capture_full() {
  local file="$screenshots/$(stamp).png"
  grim "$file"
  freeze_stop
  copy_and_report "$file"
}

capture_monitor() {
  local output file
  output=$(monitor_under_cursor)
  [[ -n $output ]] || { notify-send -a Nocturne 'Screenshot failed' 'No display was detected.'; exit 1; }
  file="$screenshots/$(stamp).png"
  grim -o "$output" "$file"
  freeze_stop
  copy_and_report "$file"
}

capture_window() {
  local geometry file
  geometry=$(hyprctl activewindow -j 2>/dev/null | jq -r '
    select(.at and .size and .size[0] > 0 and .size[1] > 0)
    | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"
  ')
  [[ -n $geometry ]] || { notify-send -a Nocturne 'Screenshot failed' 'Focus a window first.'; exit 1; }
  file="$screenshots/$(stamp).png"
  grim -g "$geometry" "$file"
  freeze_stop
  copy_and_report "$file"
}

capture_area() {
  local region file
  if [[ -n ${NOCTURNE_CAPTURE_REGION:-} ]]; then
    region=$NOCTURNE_CAPTURE_REGION
  else
    region=$(slurp -b '#090c10cc' -c '#55d6a9ff' -s '#55d6a933' -w 2) || exit 0
  fi
  [[ -n $region ]] || exit 0
  # slurp exits before its layer surface is guaranteed to have left the next
  # compositor frame. Let that overlay disappear so its border is never part
  # of the screenshot itself.
  sleep 0.20
  file="$screenshots/$(stamp).png"
  grim -g "$region" "$file"
  freeze_stop
  copy_and_report "$file"
}

start_recording() {
  local mode=$1 file region output pid
  local -a target
  read_recording && { notify-send -a Nocturne 'Recording already active' 'Use Print Screen or right-click REC to stop it.'; return 0; }
  file="$screencasts/$(stamp).mp4"
  case "$mode" in
    monitor)
      output=$(monitor_under_cursor)
      [[ -n $output ]] || { notify-send -a Nocturne 'Recording failed' 'No display was detected.'; return 1; }
      target=(-o "$output")
      ;;
    area)
      if [[ -n ${NOCTURNE_CAPTURE_REGION:-} ]]; then
        region=$NOCTURNE_CAPTURE_REGION
      else
        region=$(slurp -b '#090c10cc' -c '#ff5f6dff' -s '#ff5f6d33' -w 2) || return 0
      fi
      [[ -n $region ]] || return 0
      sleep 0.20
      target=(-g "$region")
      ;;
    *) return 2 ;;
  esac

  # Cap capture at 60 fps even on the 180 Hz gaming display; this keeps the
  # desktop and games responsive while still producing fluid recordings.
  setsid wf-recorder -r 60 "${target[@]}" -f "$file" </dev/null >"$log_file" 2>&1 &
  pid=$!
  printf '%s\t%s\n' "$pid" "$file" > "$state_file"
  sleep 0.35
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$state_file" "$file"
    notify-send -a Nocturne 'Recording failed' "$(tail -n 2 "$log_file" 2>/dev/null || true)"
    return 1
  fi
  notify-send -a Nocturne 'Recording started' 'A red REC indicator is now in the bar. Print Screen opens Stop.'
}

stop_recording() {
  if ! read_recording; then
    notify-send -a Nocturne 'Screen recording' 'No recording is active.'
    return 0
  fi
  kill -INT -- "-$recorder_pid" 2>/dev/null || kill -INT "$recorder_pid" 2>/dev/null || true
  for _ in {1..40}; do
    kill -0 "$recorder_pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f "$state_file"
  if [[ -s $recorder_file ]]; then
    notify-send -a Nocturne 'Screen recording saved' "$recorder_file"
  else
    rm -f "$recorder_file"
    notify-send -a Nocturne 'Recording stopped' 'No usable video was produced.'
  fi
}

show_status() {
  if read_recording; then
    jq -cn --arg tip "Recording screen\nLeft: capture panel · Right: stop\n$recorder_file" \
      '{text:"󰑊 REC",class:"active",tooltip:$tip}'
  else
    printf '{"text":"","class":"inactive","tooltip":""}\n'
  fi
}

show_menu() {
  local choice ui_pid monitor ui_args=()
  if [[ -r $capture_ui_pid ]]; then
    read -r ui_pid < "$capture_ui_pid" || true
    if [[ $ui_pid =~ ^[0-9]+$ ]] && ((ui_pid > 1)) && kill -0 "$ui_pid" 2>/dev/null; then
      kill "$ui_pid" 2>/dev/null || true
      rm -f "$capture_ui_pid"
      exit 0
    fi
    rm -f "$capture_ui_pid"
  fi
  freeze_start
  trap freeze_stop EXIT INT TERM
  monitor=$(monitor_under_cursor)
  read_recording && ui_args+=(--recording)
  choice=$("$capture_ui" --monitor "$monitor" "${ui_args[@]}") || exit 0
  sleep 0.12
  case "$choice" in
    stop-recording) freeze_stop; stop_recording ;;
    screenshot-all) capture_full ;;
    screenshot-display) capture_monitor ;;
    screenshot-window) capture_window ;;
    screenshot-area) capture_area ;;
    record-display) freeze_stop; sleep 0.12; start_recording monitor ;;
    record-area) freeze_stop; sleep 0.12; start_recording area ;;
  esac
}

case "${1:-menu}" in
  menu) show_menu ;;
  full) capture_full ;;
  current|monitor) capture_monitor ;;
  window) capture_window ;;
  area) capture_area ;;
  record-monitor) start_recording monitor ;;
  record-area) start_recording area ;;
  stop) stop_recording ;;
  status) show_status ;;
  *) printf 'usage: %s {menu|full|current|window|area|record-monitor|record-area|stop|status}\n' "$0" >&2; exit 2 ;;
esac
