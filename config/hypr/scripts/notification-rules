#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/nocturne
state_file="$config_home/nocturne/muted-apps.json"
rules_file="$config_home/nocturne/mako-muted.conf"

ensure_state() {
  mkdir -p "$config_home/nocturne" "$state_dir"
  [[ -s $state_file ]] || printf '[]\n' > "$state_file"
}

safe_app() {
  local app=$1
  [[ $app =~ ^[-A-Za-z0-9._+@:/\ ]{1,100}$ ]] || { printf 'Unsupported application name.\n' >&2; exit 2; }
  printf '%s' "$app"
}

render() {
  local now temp app
  ensure_state; now=$(date +%s)
  temp=$(mktemp "$config_home/nocturne/.muted-apps.XXXXXX")
  jq --argjson now "$now" '[.[] | select(.expires == 0 or .expires > $now)] | unique_by(.app)' "$state_file" > "$temp"
  mv -f -- "$temp" "$state_file"
  temp=$(mktemp "$config_home/nocturne/.mako-muted.XXXXXX")
  printf '# Generated by Nocturne. Edit muted-apps.json through the notification center.\n' > "$temp"
  while IFS= read -r app; do
    app=${app//\\/\\\\}; app=${app//\"/\\\"}
    printf '\n[app-name="%s"]\ninvisible=1\n' "$app" >> "$temp"
  done < <(jq -r '.[].app' "$state_file")
  mv -f -- "$temp" "$rules_file"
  makoctl reload >/dev/null 2>&1 || true
}

mute_app() {
  local app minutes=${2:-60} expires temp
  app=$(safe_app "${1:?application required}")
  [[ $minutes =~ ^[0-9]+$ ]] && ((minutes >= 5 && minutes <= 10080)) || exit 2
  ensure_state; expires=$(( $(date +%s) + minutes * 60 ))
  temp=$(mktemp "$config_home/nocturne/.muted-apps.XXXXXX")
  jq --arg app "$app" --argjson expires "$expires" '[.[] | select(.app != $app)] + [{app:$app,expires:$expires}]' "$state_file" > "$temp"
  mv -f -- "$temp" "$state_file"; render
  notify-send -a Nocturne 'Application muted' "$app · ${minutes} minutes"
}

unmute_app() {
  local app temp
  app=$(safe_app "${1:?application required}"); ensure_state
  temp=$(mktemp "$config_home/nocturne/.muted-apps.XXXXXX")
  jq --arg app "$app" '[.[] | select(.app != $app)]' "$state_file" > "$temp"
  mv -f -- "$temp" "$state_file"; render
}

status() { ensure_state; cat "$state_file"; }

expire_rules() {
  local now temp
  ensure_state; now=$(date +%s); temp=$(mktemp "$config_home/nocturne/.muted-apps.XXXXXX")
  jq --argjson now "$now" '[.[] | select(.expires == 0 or .expires > $now)] | unique_by(.app)' "$state_file" > "$temp"
  if cmp -s "$state_file" "$temp"; then rm -f -- "$temp"; else mv -f -- "$temp" "$state_file"; render; fi
}

case ${1:-status} in
  status) status ;;
  expire) expire_rules ;;
  mute) mute_app "${2:?application required}" "${3:-60}" ;;
  unmute) unmute_app "${2:?application required}" ;;
  clear) ensure_state; printf '[]\n' > "$state_file"; render ;;
  *) printf 'Usage: %s status|mute APP [MINUTES]|unmute APP|clear|expire\n' "$0" >&2; exit 2 ;;
esac
