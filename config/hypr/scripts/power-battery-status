#!/usr/bin/env bash
set -euo pipefail

battery=$(find /sys/class/power_supply -maxdepth 1 -type l -name 'BAT*' -print -quit)
profile_line=$("$HOME/.config/hypr/scripts/power-profile" status 2>/dev/null || printf 'unknown\tUnavailable')
IFS=$'\t' read -r profile profile_detail <<< "$profile_line"
[[ $profile == boost ]] && profile='super performance'
if [[ -z $battery ]]; then
  jq -cn --arg profile "$profile" --arg detail "$profile_detail" '{text:"󰚥  <span foreground=\"#c75c66\">󰐥</span>",class:"ac",tooltip:("External power · " + $profile + "\n" + $detail + "\nClick: power and session controls")}'
  exit 0
fi

capacity=$(cat "$battery/capacity")
status=$(cat "$battery/status")
if [[ $status == Charging ]]; then
  icon='󰂄'
  class=charging
elif [[ $status == Full || $status == 'Not charging' ]]; then
  icon='󰂅'
  class=full
else
  icons=('󰁺' '󰁻' '󰁼' '󰁽' '󰁾' '󰁿' '󰂀' '󰂁' '󰂂' '󰁹')
  index=$((capacity / 10))
  ((index > 9)) && index=9
  icon=${icons[$index]}
  class=normal
  ((capacity <= 25)) && class=warning
  ((capacity <= 12)) && class=critical
fi

printf -v tooltip 'Battery %s%%  ·  %s\nPower profile: %s\n%s\nClick: session and power controls' "$capacity" "$status" "$profile" "$profile_detail"
jq -cn --arg text "$icon ${capacity}%  <span foreground=\"#c75c66\">󰐥</span>" --arg class "$class" \
  --arg tooltip "$tooltip" \
  '{text:$text,class:$class,tooltip:$tooltip}'
