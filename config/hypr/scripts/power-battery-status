#!/usr/bin/env bash
set -euo pipefail

battery=$(find /sys/class/power_supply -maxdepth 1 -type l -name 'BAT*' -print -quit)
profile=$(powerprofilesctl get 2>/dev/null || printf 'unknown')
if [[ -z $battery ]]; then
  jq -cn --arg profile "$profile" '{text:"󰐥",class:"ac",tooltip:("Power menu · " + $profile)}'
  exit 0
fi

capacity=$(cat "$battery/capacity")
status=$(cat "$battery/status")
if [[ $status == Charging ]]; then
  icon='󰂄'
  class=charging
elif [[ $status == Full || $status == 'Not charging' ]]; then
  icon='󰂅'
  class=full
else
  icons=('󰁺' '󰁻' '󰁼' '󰁽' '󰁾' '󰁿' '󰂀' '󰂁' '󰂂' '󰁹')
  index=$((capacity / 10))
  ((index > 9)) && index=9
  icon=${icons[$index]}
  class=normal
  ((capacity <= 25)) && class=warning
  ((capacity <= 12)) && class=critical
fi

printf -v tooltip 'Battery %s%%  ·  %s\nPower profile: %s\nClick: session and power controls' "$capacity" "$status" "$profile"
jq -cn --arg text "$icon ${capacity}%  󰐥" --arg class "$class" \
  --arg tooltip "$tooltip" \
  '{text:$text,class:$class,tooltip:$tooltip}'
