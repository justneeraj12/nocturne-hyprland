#!/usr/bin/env bash
set -euo pipefail

id=$(kdeconnect-cli --list-available --id-only 2>/dev/null | head -n 1 || true)
if [[ -n $id ]]; then
  name=$(kdeconnect-cli --list-available --name-only 2>/dev/null | head -n 1)
  printf -v tooltip 'KDE CONNECT  ·  %s\nConnected and reachable\nClick: phone controls  ·  Right: send clipboard' "${name:-Phone}"
  jq -cn --arg text '󰄜' --arg tooltip "$tooltip" \
    '{text:$text,class:"connected",tooltip:$tooltip}'
else
  printf -v tooltip 'KDE CONNECT\nNo reachable phone\nClick: refresh and manage devices'
  jq -cn --arg text '󰄙' --arg tooltip "$tooltip" \
    '{text:$text,class:"disconnected",tooltip:$tooltip}'
fi
