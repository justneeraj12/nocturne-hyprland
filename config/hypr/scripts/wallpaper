#!/usr/bin/env bash
set -euo pipefail

backgrounds=${XDG_DATA_HOME:-"$HOME/.local/share"}/backgrounds
default=$backgrounds/nocturne-default.png
mkdir -p "$backgrounds"

choice=$(printf '%s\n' 'Choose an image' 'Restore Obsidian wallpaper' 'Dynamic wallpaper settings' 'Open wallpaper folder' | \
  wofi --dmenu --prompt 'Wallpaper') || exit 0

case "$choice" in
  'Choose an image')
    image=$(zenity --file-selection --title='Choose wallpaper' \
      --filename="$backgrounds/" \
      --file-filter='Images | *.png *.jpg *.jpeg *.webp') || exit 0
    nocturne-wallpaper-cycle disable
    exec nocturne-wallpaper-cycle apply-file "$image"
    ;;
  'Restore Obsidian wallpaper')
    nocturne-wallpaper-cycle disable
    exec nocturne-wallpaper-cycle apply-file "$default"
    ;;
  'Dynamic wallpaper settings') exec nocturne-settings appearance ;;
  'Open wallpaper folder') exec nautilus "$backgrounds" ;;
  *) exit 0 ;;
esac
