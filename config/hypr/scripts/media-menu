#!/usr/bin/env bash
set -euo pipefail

if "$HOME/.config/hypr/scripts/quick-menu" --toggle MEDIA; then exit 0; fi

menu() {
  "$HOME/.config/hypr/scripts/quick-menu" 'MEDIA' -345 370 240
}

player=$(playerctl -l 2>/dev/null | head -n 1 || true)
if [[ -z $player ]]; then
  choice=$(printf '%s\n' '󰝚  Nothing is playing' '󰓃  Open graphical equalizer' | menu) || exit 0
  [[ -n $choice ]] || exit 0
  [[ $choice == *equalizer* ]] && exec easyeffects
  exit 0
fi

artist=$(playerctl -p "$player" metadata artist 2>/dev/null || true)
title=$(playerctl -p "$player" metadata title 2>/dev/null || true)
status=$(playerctl -p "$player" status 2>/dev/null || true)
volume=$(playerctl -p "$player" volume 2>/dev/null || printf '1')
percent=$(awk '{printf "%d", $1 * 100}' <<<"$volume")

choice=$(printf '%s\n' \
  "󰎈  ${artist:-$player} · ${title:-Unknown track}" \
  '󰐎  Previous track' \
  "$([[ $status == Playing ]] && printf '󰏤  Pause' || printf '󰐊  Play')" \
  '󰒭  Next track' \
  "󰕾  Player volume · ${percent}%" \
  '󰝝  Player volume +5%' \
  '󰝞  Player volume −5%' \
  '󰓃  Open graphical equalizer' \
  '󱡬  Open audio routing' | menu) || exit 0
[[ -n $choice ]] || exit 0

case "$choice" in
  '󰐎  Previous track') playerctl -p "$player" previous ;;
  '󰏤  Pause'|'󰐊  Play') playerctl -p "$player" play-pause ;;
  '󰒭  Next track') playerctl -p "$player" next ;;
  *'+5%'*) playerctl -p "$player" volume 0.05+ ;;
  *'−5%'*) playerctl -p "$player" volume 0.05- ;;
  *'equalizer'*) exec easyeffects ;;
  *'routing'*) exec qpwgraph ;;
esac
