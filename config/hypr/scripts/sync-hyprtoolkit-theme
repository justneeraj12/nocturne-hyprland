#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
palette="$config_home/nocturne/palette.css"
accent_file="$config_home/nocturne/accent.css"
output="$config_home/hypr/hyprtoolkit.conf"

hex() {
  local file=$1 name=$2 fallback=$3 value
  value=$(sed -nE "s/^@define-color ${name} #([0-9a-fA-F]{6});/\\1/p" "$file" 2>/dev/null | head -n1)
  printf '%s' "${value:-$fallback}" | tr '[:lower:]' '[:upper:]'
}

base=$(hex "$palette" base 07090A)
surface=$(hex "$palette" surface 0B0F10)
overlay=$(hex "$palette" overlay 111719)
text=$(hex "$palette" text A7B8B1)
accent=$(hex "$accent_file" accent 5F8F76)
accent2=$(hex "$accent_file" accent2 477463)

tmp="$output.tmp"
printf '%s\n' \
  "# Generated by Nocturne for first-party Hyprland utilities." \
  "background = 0xFF$base" \
  "base = 0xFF$surface" \
  "alternate_base = 0xFF$overlay" \
  "text = 0xFF$text" \
  "bright_text = 0xFFE1EBE7" \
  "accent = 0xFF$accent" \
  "accent_secondary = 0xFF$accent2" \
  "h1_size = 17" \
  "h2_size = 14" \
  "h3_size = 12" \
  "font_size = 11" \
  "small_font_size = 9" \
  "icon_theme = Papirus-Dark" \
  "font_family = Inter" \
  "font_family_monospace = JetBrainsMono Nerd Font" \
  "rounding_large = 0" \
  "rounding_small = 0" > "$tmp"
mv "$tmp" "$output"

# Orbit reads a small TOML palette in addition to its GTK stylesheet. Keep it
# generated from the same source so every shell popover follows theme/accent
# changes instead of preserving an old hard-coded green.
orbit_theme="$config_home/orbit/theme.toml"
if [[ -d ${orbit_theme%/*} ]]; then
  printf '%s\n' \
    "accent_primary = \"#$accent\"" \
    "accent_secondary = \"#$accent2\"" \
    "accent_primary_foreground = \"#$base\"" \
    "background = \"#$base\"" \
    "foreground = \"#$text\"" \
    'destructive = "#FF5F6D"' \
    'opacity = 0.99' > "$orbit_theme.tmp"
  mv "$orbit_theme.tmp" "$orbit_theme"
fi

if systemctl --user is-active --quiet nocturne-orbit.service 2>/dev/null; then
  systemctl --user restart nocturne-orbit.service >/dev/null 2>&1 || true
fi
