#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == clipboard ]]; then
  device=$(kdeconnect-cli -a --id-only 2>/dev/null | head -n1)
  if [[ -n $device ]]; then
    kdeconnect-cli -d "$device" --send-clipboard >/dev/null 2>&1 || true
    notify-send -a Nocturne 'KDE Connect' 'Clipboard sent to your connected device.'
  else
    notify-send -a Nocturne 'KDE Connect' 'No reachable device.'
  fi
  exit 0
fi

exec "$HOME/.local/bin/nocturne-native" kdeconnect
