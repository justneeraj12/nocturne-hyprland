#!/usr/bin/env bash
set -euo pipefail

count=$(timeout 1 makoctl list 2>/dev/null | grep -c '^Notification ' || true)
if timeout 1 makoctl mode 2>/dev/null | grep -qx 'do-not-disturb'; then dnd=true; else dnd=false; fi
[[ $count =~ ^[0-9]+$ ]] || count=0
[[ $dnd == true ]] && mode='DND ON' || mode='DND OFF'

if ((count == 0)); then
  printf '󰂚  QUIET  ·  %s\n' "$mode"
else
  printf '󱅫  %s NOTIFICATIONS HELD  ·  %s\n' "$count" "$mode"
fi
