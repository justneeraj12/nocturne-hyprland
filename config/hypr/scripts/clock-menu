#!/usr/bin/env bash
set -euo pipefail

config=${XDG_CONFIG_HOME:-"$HOME/.config"}/nocturne/locations.json
cache=${XDG_CACHE_HOME:-"$HOME/.cache"}/nocturne/weather.tsv

if [[ ${1:-} == refresh ]]; then
  rm -f -- "$cache"
  "$HOME/.config/hypr/scripts/world-status" >/dev/null
  notify-send -a Nocturne 'World weather refreshed' 'Times and conditions are up to date.'
  exit 0
fi

if "$HOME/.config/hypr/scripts/quick-menu" --toggle CLOCK; then exit 0; fi

clock_for() {
  local zone=$1 clock marker
  clock=$(TZ="$zone" date '+%I:%M')
  clock=${clock#0}
  [[ $(TZ="$zone" date '+%p') == AM ]] && marker='+' || marker='−'
  printf '%s%s' "$clock" "$marker"
}

weather_icon() {
  case "${1:-}" in
    0) printf '󰖙' ;;
    1|2|3) printf '󰖕' ;;
    45|48) printf '󰖑' ;;
    51|53|55|56|57|61|63|65|66|67|80|81|82) printf '󰖗' ;;
    71|73|75|77|85|86) printf '󰖘' ;;
    95|96|99) printf '󰖓' ;;
    *) printf '󰖐' ;;
  esac
}

local_zone=$(date +%Z)
entries=(
  "󰥔  $(date '+%A · %d %B %Y')"
  "󰅐  LOCAL · $(clock_for "$(cat /etc/timezone 2>/dev/null || printf 'America/New_York')") · $local_zone"
  '──────── WORLD CLOCKS ────────'
)

while IFS=$'\t' read -r label timezone; do
  temperature='--'
  code=''
  if [[ -s $cache ]]; then
    temperature=$(awk -F '\t' -v wanted="$label" '$1 == wanted {print $2; exit}' "$cache")
    code=$(awk -F '\t' -v wanted="$label" '$1 == wanted {print $3; exit}' "$cache")
    [[ -n $temperature ]] || temperature='--'
  fi
  entries+=("$(weather_icon "$code")  $(printf '%-13s' "$label")  $(clock_for "$timezone")  ·  ${temperature}°")
done < <(jq -r '.weather_locations[] | [.label, .timezone] | @tsv' "$config")

focus_text=$("$HOME/.config/hypr/scripts/pomodoro" status | jq -r '.text')
entries+=(
  '──────── QUICK ACTIONS ────────'
  "󱎫  Focus timer · $focus_text"
  '󰑐  Refresh world weather'
  '󰅶  Toggle caffeine mode'
)

choice=$(printf '%s\n' "${entries[@]}" | \
  "$HOME/.config/hypr/scripts/quick-menu" CLOCK auto 430 410) || exit 0

case "$choice" in
  *'Focus timer'*) "$HOME/.config/hypr/scripts/pomodoro" toggle ;;
  *'Refresh world weather'*) exec "$0" refresh ;;
  *'Toggle caffeine'*) "$HOME/.config/hypr/scripts/caffeine" toggle ;;
esac
