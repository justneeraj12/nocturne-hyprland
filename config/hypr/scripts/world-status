#!/usr/bin/env bash
set -euo pipefail

config=${XDG_CONFIG_HOME:-"$HOME/.config"}/nocturne/locations.json
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/nocturne
cache=$cache_dir/weather.tsv
location_cache=$cache_dir/current-location.json
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
mkdir -p "$cache_dir"

location_enabled=$(jq -r '.current_location.enabled // true' "$config" 2>/dev/null || printf true)
location_args=()
[[ ${1:-} == --refresh-location ]] && location_args+=(--refresh)
"$script_dir/current-location" "${location_args[@]}" >/dev/null || true

location_rows() {
  if [[ $location_enabled == true && -s $location_cache ]]; then
    jq -r --slurpfile current "$location_cache" '
      ($current + .weather_locations)[]
      | select((.latitude | type) == "number" and (.longitude | type) == "number")
      | [(.key // .label), .latitude, .longitude] | @tsv
    ' "$config"
  else
    jq -r '.weather_locations[] | [(.key // .label), .latitude, .longitude] | @tsv' "$config"
  fi
}

display_rows() {
  if [[ $location_enabled == true && -s $location_cache ]]; then
    jq -r --slurpfile current "$location_cache" '
      ($current + .weather_locations)[] | [(.key // .label), .label, .timezone] | @tsv
    ' "$config"
  else
    jq -r '.weather_locations[] | [(.key // .label), .label, .timezone] | @tsv' "$config"
  fi
}

# Preserve the last known weather during the schema migration. The old cache
# used the city label as its key; the automatic row now has a stable key so it
# can follow the machine without colliding with a saved family city.
if [[ $location_enabled == true && -s $location_cache && -s $cache ]]; then
  current_label=$(jq -r '.label // empty' "$location_cache")
  if [[ -n $current_label ]] && ! awk -F '\t' '$1 == "@current" { found = 1 } END { exit !found }' "$cache"; then
    cached_weather=$(awk -F '\t' -v wanted="$current_label" '$1 == wanted {print $2 "\t" $3; exit}' "$cache")
    [[ -z $cached_weather ]] || printf '@current\t%s\n' "$cached_weather" >> "$cache"
  fi
fi

refresh_weather() {
  local temp_dir rows latitudes longitudes labels payload
  temp_dir=$(mktemp -d /tmp/nocturne-weather.XXXXXX)
  rows=$(location_rows)
  latitudes=$(cut -f2 <<<"$rows" | paste -sd, -)
  longitudes=$(cut -f3 <<<"$rows" | paste -sd, -)
  labels=$(cut -f1 <<<"$rows" | jq -R . | jq -sc .)
  payload=$(curl --fail --silent --show-error --max-time 12 \
    "https://api.open-meteo.com/v1/forecast?latitude=${latitudes}&longitude=${longitudes}&current=temperature_2m,weather_code&timezone=auto" \
    2>/dev/null || true)

  jq -r --argjson labels "$labels" '
    (if type == "array" then . else [.] end)
    | to_entries[]
    | select((.value.current.temperature_2m // null) != null)
    | [$labels[.key], .value.current.temperature_2m, (.value.current.weather_code // "")]
    | @tsv
  ' <<<"$payload" > "$temp_dir/fresh" 2>/dev/null || true

  if [[ -s $temp_dir/fresh ]]; then
    location_rows | cut -f1 > "$temp_dir/allowed"
    {
      [[ -s "$cache" ]] && cat "$cache"
      cat "$temp_dir/fresh"
    } | awk -F '\t' '
      NR == FNR { allowed[$1] = 1; next }
      NF >= 3 && ($1 in allowed) { rows[$1] = $0 }
      END { for (label in rows) print rows[label] }
    ' "$temp_dir/allowed" - > "$cache.new"
    mv "$cache.new" "$cache"
  fi
  rm -rf -- "$temp_dir"
}

now=$(date +%s)
modified=0
expected=$(location_rows | wc -l)
actual=0
[[ -f "$cache" ]] && modified=$(stat -c %Y "$cache")
location_modified=0
[[ -f $location_cache ]] && location_modified=$(stat -c %Y "$location_cache")
if [[ -s $cache ]]; then
  actual=$(awk -F '\t' 'NR == FNR { allowed[$1] = 1; next } $1 in allowed { count++ } END { print count + 0 }' \
    <(location_rows | cut -f1) "$cache")
fi
if ((now - modified > 900 || actual < expected || location_modified > modified)); then
  refresh_weather
fi

weather_icon() {
  case "${1:-}" in
    0) printf '󰖙' ;;
    1|2|3) printf '󰖕' ;;
    45|48) printf '󰖑' ;;
    51|53|55|56|57|61|63|65|66|67|80|81|82) printf '󰖗' ;;
    71|73|75|77|85|86) printf '󰖘' ;;
    95|96|99) printf '󰖓' ;;
    *) printf '󰖐' ;;
  esac
}

clock_for() {
  local timezone=$1 clock suffix
  clock=$(TZ="$timezone" date '+%I:%M')
  clock=${clock#0}
  if [[ $(TZ="$timezone" date '+%p') == AM ]]; then suffix='+'; else suffix='−'; fi
  printf '%s%s' "$clock" "$suffix"
}

mapfile -t locations < <(display_rows)
(( ${#locations[@]} > 0 )) || exit 0
text='󰖟 󰥔'
tooltip='WEATHER + LOCAL TIME'
while IFS=$'\t' read -r key label timezone; do
  local_time="$(TZ="$timezone" date '+%a') $(clock_for "$timezone")"
  temperature='--'
  code=''
  if [[ -s "$cache" ]]; then
    temperature=$(awk -F '\t' -v wanted="$key" '$1 == wanted {print $2; exit}' "$cache")
    code=$(awk -F '\t' -v wanted="$key" '$1 == wanted {print $3; exit}' "$cache")
    [[ -n "$temperature" ]] || temperature='--'
  fi
  tooltip+=$(printf '\n%-15s %s  %s %s°' "$label" "$local_time" "$(weather_icon "$code")" "$temperature")
done < <(display_rows)
tooltip+=$'\n\nClick: world clocks + weather'

jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text:$text,tooltip:$tooltip,class:"world"}'
