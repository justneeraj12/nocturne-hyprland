#!/usr/bin/env bash
set -u

runtime=${XDG_RUNTIME_DIR:-/tmp}
state_file="$runtime/nocturne-capture.json"
if [[ ! -r $state_file ]]; then
  printf '{"text":"","class":"inactive","tooltip":""}\n'
  exit 0
fi
pid=$(jq -r '.pid // 0' "$state_file" 2>/dev/null)
started=$(jq -r '.started // 0' "$state_file" 2>/dev/null)
path=$(jq -r '.path // ""' "$state_file" 2>/dev/null)
if [[ $pid == 0 || ! -r /proc/$pid/cmdline ]] || ! tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq wf-recorder; then
  rm -f -- "$state_file"
  printf '{"text":"","class":"inactive","tooltip":""}\n'
  exit 0
fi
elapsed=$(($(date +%s) - started))
((elapsed < 0)) && elapsed=0
minutes=$((elapsed / 60))
seconds=$((elapsed % 60))
printf 'REC %02d:%02d\t%s\n' "$minutes" "$seconds" "$path" | \
  jq -R 'split("\t") | {text:.[0],class:"active",tooltip:("Recording · " + .[1] + " · click to stop")}'
