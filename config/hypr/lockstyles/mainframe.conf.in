# NOCTURNE LOCK STYLE: mainframe
shape {
    monitor =
    size = 1520, 670
    color = rgba(@BASE@8f)
    rounding = 0
    border_size = 1
    border_color = rgba(@LINE@ff)
    position = 0, 0
    halign = center
    valign = center
}
shape {
    monitor =
    size = 1, 570
    color = rgba(@ACCENT@8f)
    rounding = 0
    position = -260, 0
    halign = center
    valign = center
}
shape {
    monitor =
    size = 1, 570
    color = rgba(@LINE@ff)
    rounding = 0
    position = 278, 0
    halign = center
    valign = center
}
label {
    monitor =
    text = NOC // MAINFRAME RACK 01
    color = rgba(@ACCENT@ff)
    font_size = 11
    font_family = JetBrains Mono ExtraBold
    position = -710, 292
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:1000] ~/.config/hypr/scripts/lock-time
    color = rgba(@TEXT@ff)
    font_size = 112
    font_family = JetBrains Mono ExtraBold
    position = -505, 140
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] ~/.config/hypr/scripts/lock-date
    color = rgba(@TEXT@cc)
    font_size = 14
    font_family = JetBrains Mono Medium
    position = -510, 62
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:300000] ~/.config/hypr/scripts/lock-weather
    color = rgba(@ACCENT2@ff)
    font_size = 11
    font_family = JetBrains Mono Medium
    position = -510, 18
    halign = center
    valign = center
}
label {
    monitor =
    text = RACK STATUS // LIVE
    color = rgba(@ACCENT@ff)
    font_size = 10
    font_family = JetBrains Mono ExtraBold
    text_align = left
    position = 0, 158
    halign = center
    valign = center
}
label {
    monitor =
    text = 01  POWER      NOMINAL
    color = rgba(@TEXT@d8)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = left
    position = 0, 126
    halign = center
    valign = center
}
label {
    monitor =
    text = 02  NETWORK    LINKED
    color = rgba(@TEXT@d8)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = left
    position = 0, 94
    halign = center
    valign = center
}
label {
    monitor =
    text = 03  AUDIO      ARMED
    color = rgba(@TEXT@d8)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = left
    position = 0, 62
    halign = center
    valign = center
}
label {
    monitor =
    text = 04  SECURITY   SEALED
    color = rgba(@TEXT@d8)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = left
    position = 0, 30
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:5000] ~/.config/hypr/scripts/lock-status
    color = rgba(@ACCENT@ff)
    font_size = 9
    font_family = JetBrains Mono
    text_align = left
    position = 0, -18
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/scripts/lock-media title
    color = rgba(@TEXT@ff)
    font_size = 17
    font_family = Inter Display Medium
    text_align = left
    position = 0, -120
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:5000] ~/.config/hypr/scripts/lock-notifications
    color = rgba(@ACCENT2@ff)
    font_size = 9
    font_family = JetBrains Mono Medium
    text_align = left
    position = 0, -166
    halign = center
    valign = center
}
label {
    monitor =
    text = $USER // CONSOLE AUTH
    color = rgba(@ACCENT@ff)
    font_size = 9
    font_family = JetBrains Mono ExtraBold
    position = 374, 100
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 430, 54
    outline_thickness = 1
    rounding = 0
    dots_size = 0.19
    dots_spacing = 0.27
    dots_center = false
    outer_color = rgba(@ACCENT@cc)
    inner_color = rgba(@SURFACE@f2)
    font_color = rgba(@TEXT@ff)
    fade_on_empty = false
    placeholder_text = <span foreground="##@MUTED@">PASSWORD_</span>
    hide_input = false
    check_color = rgba(@ACCENT@ff)
    fail_color = rgba(ff5f6dff)
    fail_text = <span foreground="##ff5f6d">MAINFRAME DENIED // $FAIL // $ATTEMPTS</span>
    capslock_color = rgba(@ACCENT2@ff)
    position = 502, 39
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] ~/.config/hypr/scripts/lock-world
    color = rgba(@TEXT@a8)
    font_size = 9
    font_family = JetBrains Mono
    text_align = left
    position = 382, -95
    halign = center
    valign = center
}
