# NOCTURNE LOCK STYLE: noc-grid
shape {
    monitor =
    size = 4, 640
    color = rgba(@ACCENT@ff)
    rounding = 0
    position = 84, 0
    halign = left
    valign = center
}
shape {
    monitor =
    size = 520, 320
    color = rgba(@BASE@c7)
    rounding = 0
    border_size = 1
    border_color = rgba(@LINE@ff)
    position = -88, 106
    halign = right
    valign = center
}
label {
    monitor =
    text = N\nO\nC
    color = rgba(@ACCENT@ff)
    font_size = 34
    font_family = JetBrains Mono ExtraBold
    text_align = center
    position = 40, 0
    halign = left
    valign = center
}
label {
    monitor =
    text = cmd[update:1000] ~/.config/hypr/scripts/lock-time
    color = rgba(@TEXT@ff)
    font_size = 122
    font_family = JetBrains Mono ExtraBold
    position = 124, 154
    halign = left
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] ~/.config/hypr/scripts/lock-date
    color = rgba(@TEXT@cc)
    font_size = 15
    font_family = JetBrains Mono Medium
    position = 132, 68
    halign = left
    valign = center
}
label {
    monitor =
    text = cmd[update:300000] ~/.config/hypr/scripts/lock-weather
    color = rgba(@ACCENT2@ff)
    font_size = 12
    font_family = JetBrains Mono Medium
    position = 132, 22
    halign = left
    valign = center
}
label {
    monitor =
    text = 01 // SESSION\n02 // NETWORK\n03 // AUDIO
    color = rgba(@ACCENT@d8)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = left
    position = -560, 200
    halign = right
    valign = center
}
label {
    monitor =
    text = cmd[update:5000] ~/.config/hypr/scripts/lock-status
    color = rgba(@TEXT@dc)
    font_size = 10
    font_family = JetBrains Mono
    text_align = right
    position = -116, 210
    halign = right
    valign = center
}
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/scripts/lock-media title
    color = rgba(@TEXT@ff)
    font_size = 20
    font_family = Inter Display Medium
    text_align = right
    position = -116, 142
    halign = right
    valign = center
}
label {
    monitor =
    text = cmd[update:3000] ~/.config/hypr/scripts/lock-media meta
    color = rgba(@MUTED@ff)
    font_size = 10
    font_family = JetBrains Mono
    text_align = right
    position = -116, 106
    halign = right
    valign = center
}
label {
    monitor =
    text = $USER // ACCESS NODE
    color = rgba(@ACCENT@ff)
    font_size = 9
    font_family = JetBrains Mono Medium
    position = -116, 18
    halign = right
    valign = center
}
input-field {
    monitor =
    size = 430, 54
    outline_thickness = 1
    rounding = 0
    dots_size = 0.19
    dots_spacing = 0.27
    dots_center = false
    outer_color = rgba(@LINE@ff)
    inner_color = rgba(@SURFACE@f2)
    font_color = rgba(@TEXT@ff)
    fade_on_empty = false
    placeholder_text = <span foreground="##@MUTED@">PASSWORD_</span>
    hide_input = false
    check_color = rgba(@ACCENT@ff)
    fail_color = rgba(ff5f6dff)
    fail_text = <span foreground="##ff5f6d">DENIED // $FAIL // $ATTEMPTS</span>
    capslock_color = rgba(@ACCENT2@ff)
    position = -116, -34
    halign = right
    valign = center
}
label {
    monitor =
    text = cmd[update:5000] ~/.config/hypr/scripts/lock-notifications
    color = rgba(@ACCENT2@ff)
    font_size = 10
    font_family = JetBrains Mono Medium
    text_align = right
    position = -116, -108
    halign = right
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] ~/.config/hypr/scripts/lock-world
    color = rgba(@TEXT@b8)
    font_size = 9
    font_family = JetBrains Mono
    position = 128, 58
    halign = left
    valign = bottom
}
