general {
    hide_cursor = false
    immediate_render = true
    ignore_empty_input = true
    fail_timeout = 1600
}

background {
    monitor =
    path = ~/.local/state/nocturne/lock-wallpaper
    blur_passes = @BLUR_PASSES@
    blur_size = @BLUR_SIZE@
    noise = @NOISE@
    contrast = @CONTRAST@
    brightness = @BRIGHTNESS@
    vibrancy = @VIBRANCY@
    vibrancy_darkness = 0.10
}
